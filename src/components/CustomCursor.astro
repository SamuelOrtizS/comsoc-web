<!-- Desktop cursor: SVG icon following exact mouse position -->
<div
  id="custom-cursor"
  class="pointer-events-none fixed top-0 left-0 z-[9999] will-change-transform opacity-0 transition-opacity duration-300 origin-top-left"
  style="transform: translate3d(-100px, -100px, 0) rotate(-25deg) scale(1);"
>
  <img
    id="custom-cursor-img"
    src="/images/Cursor/Cursor/Step1.svg"
    alt="Cursor"
    class="w-8 h-8 block"
  />
</div>

<style is:global>
  /* Hide native cursor on desktop/pointer devices */
  @media (any-pointer: fine) {
    html, body, a, button, select, input, textarea, [role="button"] {
      cursor: none !important;
    }
  }

  /* Never show desktop cursor on touch / mobile devices — multiple guards for cross-browser safety */
  @media (pointer: coarse),
         (hover: none),
         (any-hover: none) {
    #custom-cursor {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }
  }
</style>

<script>
  // ── Desktop Cursor ──────────────────────────────────────────────
  const cursor    = document.getElementById('custom-cursor');
  const cursorImg = document.getElementById('custom-cursor-img') as HTMLImageElement | null;

  if (cursor && cursorImg && window.matchMedia('(any-pointer: fine)').matches) {
    let visible = false;
    let mouseX = -100;
    let mouseY = -100;
    let isDown = false;
    let touchDevice = false;

    // If any touch event fires, permanently suppress the desktop cursor
    window.addEventListener('touchstart', () => {
      touchDevice = true;
      cursor.style.setProperty('display', 'none', 'important');
    }, { passive: true, once: true });

    const step1 = '/images/Cursor/Cursor/Step1.svg';
    const step2 = '/images/Cursor/Cursor/Step2.svg';
    const step3 = '/images/Cursor/Cursor/Step3.svg';
    const step4 = '/images/Cursor/Cursor/Step4.svg';

    // Scale state tracked separately so we can bake it into the combined transform
    let cursorScale = 1;

    // Hotspot: nudge the cursor so its visual tip aligns with the real pointer.
    // Negative X = shift cursor left, negative Y = shift cursor up.
    const HOTSPOT_X = -15;
    const HOTSPOT_Y = 0;

    let rafId: number | null = null;

    const applyTransform = () => {
      cursor.style.transform =
        `translate3d(${mouseX + HOTSPOT_X}px, ${mouseY + HOTSPOT_Y}px, 0) rotate(-25deg) scale(${cursorScale})`;
    };

    const requestTransformUpdate = () => {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(() => {
        applyTransform();
        rafId = null;
      });
    };

    // Move cursor exactly with mouse — batched in rAF for 60/120/144Hz smoothness without main thread blocking
    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (touchDevice) return;
      mouseX = e.clientX;
      mouseY = e.clientY;
      requestTransformUpdate();
      if (!visible) {
        cursor.classList.remove('opacity-0');
        cursor.classList.add('opacity-100');
        visible = true;
      }
    }, { passive: true });

    document.addEventListener('mouseleave', () => {
      cursor.classList.remove('opacity-100');
      cursor.classList.add('opacity-0');
      visible = false;
    });

    document.addEventListener('mouseenter', (e: MouseEvent) => {
      if (touchDevice) return;
      mouseX = e.clientX;
      mouseY = e.clientY;
      applyTransform();
      cursor.classList.remove('opacity-0');
      cursor.classList.add('opacity-100');
      visible = true;
    });

    // Shrink on press, restore on release
    window.addEventListener('mousedown', () => {
      if (touchDevice) return;
      isDown = true;
      cursorScale = 0.92;
      applyTransform();
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
      cursorScale = 1;
      applyTransform();
    });

    // Click wave pulse on desktop
    let t1: number, t2: number, t3: number;
    const DELAY = 140;

    window.addEventListener('mousedown', () => {
      if (touchDevice) return;
      window.clearTimeout(t1); window.clearTimeout(t2); window.clearTimeout(t3);
      cursorImg.src = step2;
      t1 = window.setTimeout(() => {
        cursorImg.src = step3;
        t2 = window.setTimeout(() => {
          cursorImg.src = step4;
          t3 = window.setTimeout(() => { cursorImg.src = step1; }, DELAY);
        }, DELAY);
      }, DELAY);
    });
  }
</script>

