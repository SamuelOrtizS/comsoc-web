<div
  id="custom-cursor"
  class="pointer-events-none fixed top-0 left-0 z-[9999] will-change-transform opacity-0 transition-opacity duration-200"
  style="transform: translate3d(-100px, -100px, 0);"
>
  <img
    id="custom-cursor-img"
    src="/images/Cursor/Cursor/Step1.svg"
    alt="Cursor"
    class="w-8 h-8 transition-transform duration-100 ease-out origin-top-left -rotate-[25deg]"
  />
</div>

<style is:global>
  /* Hide native cursor on desktop/pointer devices */
  @media (any-pointer: fine) {
    html, body, a, button, select, input, textarea, [role="button"] {
      cursor: none !important;
    }
  }

  /* Ensure cursor is hidden on touch screens where it's not applicable */
  @media (pointer: coarse) {
    #custom-cursor {
      display: none !important;
    }
  }
</style>

<script>
  const cursor = document.getElementById('custom-cursor');
  const cursorImg = document.getElementById('custom-cursor-img') as HTMLImageElement;

  if (cursor && cursorImg) {
    let cursorVisible = false;

    // Track mouse position
    const updatePosition = (e: MouseEvent) => {
      cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
      if (!cursorVisible) {
        cursor.classList.remove('opacity-0');
        cursor.classList.add('opacity-100');
        cursorVisible = true;
      }
    };

    window.addEventListener('mousemove', updatePosition);

    // Hide cursor when leaving window
    document.addEventListener('mouseleave', () => {
      cursor.classList.remove('opacity-100');
      cursor.classList.add('opacity-0');
      cursorVisible = false;
    });

    // Re-show when entering window
    document.addEventListener('mouseenter', (e) => {
      updatePosition(e);
    });

    // Animation frames
    const step1 = '/images/Cursor/Cursor/Step1.svg';
    const step2 = '/images/Cursor/Cursor/Step2.svg';
    const step3 = '/images/Cursor/Cursor/Step3.svg';
    const step4 = '/images/Cursor/Cursor/Step4.svg';

    let animationTimeout: number;

    window.addEventListener('mousedown', () => {
      clearTimeout(animationTimeout);
      cursorImg.src = step2;

      animationTimeout = window.setTimeout(() => {
        cursorImg.src = step3;

        animationTimeout = window.setTimeout(() => {
          cursorImg.src = step4;

          animationTimeout = window.setTimeout(() => {
            cursorImg.src = step1;
          }, 80);
        }, 80);
      }, 80);
    });
  }
</script>
