---
import { Image } from 'astro:assets';
import cursorStep1 from '../assets/images/Cursor/Cursor/Step1.svg';
import cursorStep2 from '../assets/images/Cursor/Cursor/Step2.svg';
import cursorStep3 from '../assets/images/Cursor/Cursor/Step3.svg';
import cursorStep4 from '../assets/images/Cursor/Cursor/Step4.svg';
---
<!-- Desktop cursor: SVG icon following exact mouse position -->
<div
  id="custom-cursor"
  aria-hidden="true"
  class="pointer-events-none fixed top-0 left-0 z-[9999] opacity-0 transition-opacity duration-300 origin-top-left"
  style="transform: translate3d(-100px, -100px, 0) rotate(-25deg) scale(1); backface-visibility: hidden; -webkit-backface-visibility: hidden; transform-style: preserve-3d;"
>
  <Image
    id="custom-cursor-img"
    src={cursorStep1}
    alt="Cursor"
    width={32}
    height={32}
    loading="eager"
    decoding="async"
    fetchpriority="low"
    class="w-8 h-8 block"
  />
</div>

<style is:global>
  /* Custom cursor is decorative only — never hide native cursor (a11y) */
  @media (prefers-reduced-motion: reduce) {
    #custom-cursor {
      display: none !important;
    }
  }

  /* Never show desktop cursor on touch / mobile devices */
  @media (pointer: coarse),
         (hover: none),
         (any-hover: none) {
    #custom-cursor {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }
  }
</style>

<script define:vars={{ step1Src: cursorStep1.src, step2Src: cursorStep2.src, step3Src: cursorStep3.src, step4Src: cursorStep4.src }}>
  // ── Desktop Cursor ──────────────────────────────────────────────
  const cursor    = document.getElementById('custom-cursor');
  const cursorImg = document.getElementById('custom-cursor-img');

  if (cursor && cursorImg && window.matchMedia('(any-pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let visible = false;
    let mouseX = -100;
    let mouseY = -100;
    let isDown = false;
    let touchDevice = false;

    // If any touch event fires, permanently suppress the desktop cursor
    window.addEventListener('touchstart', () => {
      touchDevice = true;
      cursor.style.setProperty('display', 'none', 'important');
    }, { passive: true, once: true });

    const step1 = step1Src;
    const step2 = step2Src;
    const step3 = step3Src;
    const step4 = step4Src;

    // Scale state tracked separately so we can bake it into the combined transform
    let cursorScale = 1;

    // Hotspot: nudge the cursor so its visual tip aligns with the real pointer.
    // Negative X = shift cursor left, negative Y = shift cursor up.
    const HOTSPOT_X = -15;
    const HOTSPOT_Y = 0;

    let pendingUpdate = false;
    let willChangeTimeout: number | undefined;

    const requestTransformUpdate = () => {
      if (pendingUpdate) return;
      pendingUpdate = true;
      // will-change only while moving (perf)
      cursor.style.willChange = 'transform';
      window.clearTimeout(willChangeTimeout);
      willChangeTimeout = window.setTimeout(() => { cursor.style.willChange = 'auto'; }, 200);
      requestAnimationFrame(() => {
        cursor.style.transform =
          `translate3d(${mouseX + HOTSPOT_X}px, ${mouseY + HOTSPOT_Y}px, 0) rotate(-25deg) scale(${cursorScale})`;
        pendingUpdate = false;
      });
    };

    // Move cursor exactly with mouse — batched in rAF for 60/120/144Hz smoothness without main thread blocking
    window.addEventListener('mousemove', (e) => {
      if (touchDevice) return;
      mouseX = e.clientX;
      mouseY = e.clientY;
      requestTransformUpdate();
      if (!visible) {
        cursor.classList.remove('opacity-0');
        cursor.classList.add('opacity-100');
        visible = true;
      }
    }, { passive: true });

    document.addEventListener('mouseleave', () => {
      cursor.classList.remove('opacity-100');
      cursor.classList.add('opacity-0');
      visible = false;
    });

    document.addEventListener('mouseenter', (e) => {
      if (touchDevice) return;
      mouseX = e.clientX;
      mouseY = e.clientY;
      requestTransformUpdate();
      cursor.classList.remove('opacity-0');
      cursor.classList.add('opacity-100');
      visible = true;
    });

    // Shrink on press, restore on release
    window.addEventListener('mousedown', () => {
      if (touchDevice) return;
      isDown = true;
      cursorScale = 0.92;
      requestTransformUpdate();
    });

    window.addEventListener('mouseup', () => {
      isDown = false;
      cursorScale = 1;
      requestTransformUpdate();
    });

    // Click wave pulse on desktop
    let t1, t2, t3;
    const DELAY = 140;

    window.addEventListener('mousedown', () => {
      if (touchDevice) return;
      window.clearTimeout(t1); window.clearTimeout(t2); window.clearTimeout(t3);
      cursorImg.src = step2;
      t1 = window.setTimeout(() => {
        cursorImg.src = step3;
        t2 = window.setTimeout(() => {
          cursorImg.src = step4;
          t3 = window.setTimeout(() => { cursorImg.src = step1; }, DELAY);
        }, DELAY);
      }, DELAY);
    });
  }
</script>

