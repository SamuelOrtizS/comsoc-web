---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { resolveImage } from '../utils/imageResolver';
interface Props {
  id: string;
  titulo: string;
  tipo: string;
  organizador: string;
  fechaInicio: string;
  horaInicio?: string;
  lugarNombre?: string;
  descripcion: string;
  imagenPrincipal: string;
  estado?: 'Publicado' | 'Pasado';
}

const {
  id,
  titulo,
  tipo,
  organizador,
  fechaInicio,
  horaInicio,
  lugarNombre,
  descripcion,
  imagenPrincipal,
  estado = 'Publicado',
} = Astro.props;

const isPast = estado === 'Pasado';
const cleanId = id.replace(/\/evento$/, '');
const resolvedPrincipal = resolveImage(imagenPrincipal);

// Format readable date
const dateObj = new Date(fechaInicio);
const formattedDate = dateObj.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class={`group relative flex h-full flex-col overflow-hidden rounded-2xl border bg-bg-primary/60 backdrop-blur-xl transition-all duration-300 ${isPast ? 'border-white/10 opacity-90' : 'border-accent-cyan/20 hover:border-accent-cyan/40'}`}>
  <!-- Image banner thumbnail -->
  <div class="relative aspect-video w-full overflow-hidden bg-bg-secondary">
    <Image
      src={resolvedPrincipal as any}
      alt={titulo}
      width={800}
      height={450}
      sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-bg-primary-lighter via-bg-primary/30 to-bg-primary-darker" />

    <!-- Type & Status Badges -->
    <div class="absolute inset-x-0 top-0 flex items-center justify-between gap-2 p-3">
      <span class="inline-flex items-center rounded-full border border-accent-cyan/30 bg-bg-primary/70 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-accent-cyan backdrop-blur-md">
        {tipo}
      </span>
      {isPast && (
        <span class="inline-flex items-center rounded-full border border-white/10 bg-bg-secondary/75 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-text-secondary backdrop-blur-md">
          Finalizado
        </span>
      )}
    </div>

    <!-- Date pill -->
    <div class="absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-bg-primary/75 px-2.5 py-1 text-[10px] font-medium text-text-primary backdrop-blur-md">
      <Icon name="material-symbols:calendar-today-rounded" class="w-3.5 h-3.5 text-accent-cyan" aria-hidden="true" />
      <span class="font-mono tracking-[0.08em] uppercase">{formattedDate}</span>
    </div>
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="mb-3 flex items-center gap-2 text-[11px] font-mono text-text-secondary">
      <span class="truncate">{organizador}</span>
      {horaInicio && (
        <>
          <span class="text-accent-cyan/70">•</span>
          <span>{horaInicio}</span>
        </>
      )}
    </div>

    <h3 class="mb-3 text-xl font-bold leading-tight text-text-primary transition-colors duration-300 group-hover:text-accent-cyan">
      {titulo}
    </h3>

    <p class="mb-4 line-clamp-3 text-sm leading-relaxed text-text-secondary">
      {descripcion}
    </p>

    {lugarNombre && (
      <div class="mb-5 flex items-center gap-2 rounded-xl border border-white/5 bg-white/[0.02] px-2.5 py-2 text-xs text-text-secondary">
        <Icon name="material-symbols:location-on-rounded" class="w-3.5 h-3.5 shrink-0 text-accent-cyan" aria-hidden="true" />
        <span class="truncate">{lugarNombre}</span>
      </div>
    )}

    <div class="mt-auto pt-4">
      <a
        href={`/eventos/${cleanId}`}
        class="group/link inline-flex w-full items-center justify-center gap-2 rounded-xl border border-accent-cyan/30 bg-white/[0.03] px-4 py-2.5 text-sm font-semibold text-accent-cyan transition-all duration-300 hover:border-accent-cyan hover:bg-accent-cyan/10"
      >
        <span>Ver detalles</span>
        <Icon name="material-symbols:arrow-forward-rounded" class="h-4 w-4 transition-transform duration-300 group-hover/link:translate-x-1" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
