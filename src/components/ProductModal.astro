---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getImageModule } from '../utils/imageImports';
import iconMap from '../utils/tiendaIconMap.json';

interface Props {
  items?: Array<{
    id: string;
    data: {
      name: string;
      category: string;
      price: string;
      description: string;
      image: string;
      available: boolean;
      resources?: Array<{ title: string; link: string; icon?: string; color?: string }>;
      specifications?: Array<{ key: string; value: string }>;
    };
  }>;
}

const { items = [] } = Astro.props;
const modalProducts = items.map((item) => {
  const product = item.data;
  const remoteImage = typeof product.image === 'string' && (product.image.startsWith('http://') || product.image.startsWith('https://'));
  const localImage = typeof product.image === 'string' ? getImageModule(product.image) : undefined;

  return {
    ...product,
    id: item.id,
    isRemoteImage: remoteImage,
    imageSource: localImage ?? product.image,
  };
});

function hexToRgba(hex, alpha) {
    const clean = hex.startsWith('#') ? hex.slice(1) : hex;
    const normalized = clean.length === 3 ? clean.split('').map((char) => char + char).join('') : clean;
    const value = Number.parseInt(normalized, 16);
    const r = (value >> 16) & 255;
    const g = (value >> 8) & 255;
    const b = value & 255;
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
  }
---
{modalProducts.map((product) => (
  <div
    id={`product-modal-overlay-${product.id}`}
    class="product-modal-overlay pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 opacity-0 backdrop-blur-xl transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby={`modal-product-name-${product.id}`}
    data-product-id={product.id}
  >
    <div
      id={`product-modal-${product.id}`}
      class="product-modal relative w-full max-w-2xl translate-y-4 overflow-hidden rounded-[28px] border border-white/10 bg-bg-secondary shadow-[0_32px_80px_-28px_rgba(69,219,237,0.8)] transition-all duration-300"
    >
      <button
        type="button"
        class="product-modal-close absolute right-4 top-4 z-10 rounded-xl border border-white/10 bg-black/25 p-2 text-text-secondary transition hover:border-white/20 hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/70"
        aria-label="Cerrar"
        data-close-id={product.id}
      >
        <Icon name="material-symbols:close-rounded" class="h-5 w-5" aria-hidden="true" />
      </button>

      <div class="grid gap-0 md:grid-cols-[1.05fr_1fr]">
        <div class="relative aspect-[5/4] overflow-hidden bg-bg-secondary md:aspect-auto">
          {product.isRemoteImage ? (
            <img src={product.imageSource} alt={product.name} class="h-full w-full object-cover" />
          ) : product.imageSource ? (
            <Image
              src={product.imageSource}
              alt={product.name}
              width={900}
              height={720}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent-purple/15 via-bg-secondary to-accent-blue/15 text-xs font-mono uppercase tracking-[0.2em] text-text-secondary">
              Producto
            </div>
          )}
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(10,15,36,0.15),rgba(10,15,36,0.7))]"></div>
          <span
            class="absolute left-4 top-4 rounded-full border border-accent-cyan/30 bg-black/70 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-accent-cyan font-mono backdrop-blur-sm"
          >
            {product.category}
          </span>
        </div>

        <div class="flex flex-col p-6 sm:p-7">
          <div class="mb-3">
            <div class="mb-2 text-2xl font-bold text-accent-cyan font-mono">{product.price}</div>
            <h2 id={`modal-product-name-${product.id}`} class="text-2xl font-black tracking-[-0.05em] text-text-primary">{product.name}</h2>
          </div>

          <div class="mb-4 text-sm font-mono">
            {product.available ? (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-accent-emerald/30 bg-accent-emerald/10 px-3 py-1 text-accent-emerald font-mono text-xs uppercase tracking-[0.12em]">
                <Icon name="material-symbols:check-circle-rounded" class="h-4 w-4" aria-hidden="true" />
                En stock
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-accent-red/30 bg-accent-red/10 px-3 py-1 text-accent-red font-mono text-xs uppercase tracking-[0.12em]">
                <Icon name="material-symbols:cancel-rounded" class="h-4 w-4" aria-hidden="true" />
                Agotado
              </span>
            )}
          </div>

          {product.resources && product.resources.length > 0 && (
            <div class="space-y-3">
              <div class="space-y-3 border-t border-white/10 pt-4">
                <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-text-secondary font-mono">Recursos</h3>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  {product.resources.map((resource) => {
                    const color = resource.color ?? '#65dbed';
                    return (
                      <a
                        href={resource.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group rounded-2xl border p-3 transition hover:-translate-y-0.5"
                        style={`border-color: ${color}; background: ${hexToRgba(color, 0.08)};`}
                      >
                        <div class="flex items-center gap-3">
                          <span class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-black/25" style={`color: ${color};`}>
                            <Icon name={resource.icon ?? 'material-symbols:palette-rounded'} class="h-5 w-5" aria-hidden="true" />
                          </span>
                          <div>
                            <p class="text-sm font-semibold text-text-primary">{resource.title}</p>
                            <span class="text-[11px] font-mono uppercase tracking-[0.14em] text-accent-cyan">Ver más</span>
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          )}

          {product.specifications && product.specifications.length > 0 && (
            <div class="space-y-3">
              <div class="space-y-2 border-t border-white/10 pt-4">
                <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-text-secondary font-mono">Especificaciones</h3>
                <dl class="space-y-2">
                  {product.specifications.map((spec) => (
                    <div class="flex items-start justify-between gap-4 rounded-xl border border-white/10 bg-white/3 px-3 py-2">
                      <dt class="text-xs font-medium text-text-secondary font-mono uppercase tracking-[0.12em]">{spec.key}</dt>
                      <dd class="text-right text-sm text-text-primary">{spec.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          )}

          <p class="mt-4 text-sm leading-relaxed text-text-secondary font-light">{product.description}</p>

          <div class="mt-6 pt-4">
            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Hola, deseo consultar y pedir el producto: ${product.name} (${product.price}) de la tienda IEEE ComSoc.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`flex w-full items-center justify-center gap-2 rounded-xl border px-4 py-3 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-emerald/70 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary ${product.available ? 'border-accent-emerald/35 bg-accent-emerald/20 text-accent-emerald hover:bg-accent-emerald/30' : 'pointer-events-none border-white/10 bg-white/5 text-text-secondary opacity-50'}`}
            >
              <span>Pedir por WhatsApp</span>
              <Icon name="material-symbols:chat-rounded" class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
))}

<script define:vars={{ iconMap }}>
  const overlays = [...document.querySelectorAll('.product-modal-overlay')];
  const closeButtons = [...document.querySelectorAll('.product-modal-close')];

  const iconBodies = iconMap;

  function getIconBody(icon) {
    if (!icon) return iconBodies['palette'] ?? '';
    let key = icon.replace('material-symbols:', '');
    if (iconBodies[key]) return iconBodies[key];
    const base = key.replace(/-rounded|-outlined|-sharp/g, '');
    if (iconBodies[base]) return iconBodies[base];
    if (iconBodies[key + '-rounded']) return iconBodies[key + '-rounded'];
    const emojiMap = {
      '🛡️': iconBodies['shield-rounded'] ?? '',
      '🚀': iconBodies['local-shipping-rounded'] ?? '',
      '💧': iconBodies['water-drop-rounded'] ?? '',
      '🌐': iconBodies['palette'] ?? '',
      '💦': iconBodies['water-drop-rounded'] ?? '',
      '✨': iconBodies['auto-awesome-rounded'] ?? '',
      '💡': iconBodies['lightbulb-rounded'] ?? '',
      '🧵': iconBodies['checkroom-rounded'] ?? '',
    };
    return emojiMap[icon] ?? iconBodies['palette'] ?? '';
  }

  function iconSvg(icon, size = 20) {
    const body = getIconBody(icon);
    return `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor" aria-hidden="true">${body}</svg>`;
  }

  function openProductModal(productId) {
    const target = document.getElementById(`product-modal-overlay-${productId}`);
    if (!target) return;

    overlays.forEach((overlay) => {
      overlay.classList.add('hidden', 'pointer-events-none', 'opacity-0');
      overlay.classList.remove('flex', 'opacity-100', 'pointer-events-auto');
      const modal = overlay.querySelector('.product-modal');
      if (modal) modal.classList.add('translate-y-4');
    });

    target.classList.remove('hidden', 'pointer-events-none', 'opacity-0');
    target.classList.add('flex', 'opacity-100', 'pointer-events-auto');
    const modal = target.querySelector('.product-modal');
    if (modal) modal.classList.remove('translate-y-4');
    document.body.style.overflow = 'hidden';
  }

  function closeProductModal() {
    overlays.forEach((overlay) => {
      overlay.classList.add('hidden', 'pointer-events-none', 'opacity-0');
      overlay.classList.remove('flex', 'opacity-100', 'pointer-events-auto');
      const modal = overlay.querySelector('.product-modal');
      if (modal) modal.classList.add('translate-y-4');
    });
    document.body.style.overflow = '';
  }

  function setupProductModal() {
    document.querySelectorAll('.product-card-btn').forEach((btn) => {
      if (btn.dataset.modalInitialized) return;
      btn.dataset.modalInitialized = 'true';
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        if (productId) openProductModal(productId);
      });
    });

    closeButtons.forEach((btn) => {
      if (btn.dataset.closeInitialized) return;
      btn.dataset.closeInitialized = 'true';
      btn.addEventListener('click', closeProductModal);
    });

    overlays.forEach((overlay) => {
      if (overlay.dataset.boundClick) return;
      overlay.dataset.boundClick = 'true';
      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) closeProductModal();
      });
    });
  }

  setupProductModal();
  document.addEventListener('astro:page-load', setupProductModal);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeProductModal();
  });
</script>
