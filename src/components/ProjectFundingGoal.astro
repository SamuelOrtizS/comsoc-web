---
import { formatUSD, formatCOP } from '../utils/currency';

interface Props {
  montoActual: number;
  montoMeta: number;
  currentRate: number;
  imagen?: string;
}

const { montoActual, montoMeta, currentRate, imagen } = Astro.props;

const fundingProgress = montoMeta > 0 ? Math.min(100, (montoActual / montoMeta) * 100) : 0;
const fundingRemaining = montoMeta > 0 ? Math.max(0, montoMeta - montoActual) : 0;
---

<div class="glass-card rounded-2xl p-6 sm:p-8 border border-white/10">
  <div class="flex items-center justify-between gap-4 mb-6">
    <div>
      <div class="text-[11px] font-mono uppercase tracking-[0.2em] text-accent-cyan font-semibold mb-1">
        Meta de Financiamiento
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-text-primary">
        Fondo de Desarrollo del Proyecto
      </h2>
    </div>
    <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-accent-emerald/10 text-accent-emerald border border-accent-emerald/30">
      Transparencia
    </span>
  </div>

  <div class="space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-3.5 rounded-xl bg-white/5 border border-glass-border">
        <div class="text-[11px] font-mono text-text-secondary">Meta en Dólares (USD)</div>
        <div class="text-base font-bold text-accent-cyan font-mono mt-0.5">
          {formatUSD(montoActual)} / {formatUSD(montoMeta)}
        </div>
      </div>
      <div class="p-3.5 rounded-xl bg-white/5 border border-glass-border">
        <div class="text-[11px] font-mono text-text-secondary">Meta en Pesos Colombianos (COP)</div>
        <div class="text-base font-bold text-accent-emerald font-mono mt-0.5">
          {formatCOP(montoActual, currentRate)} / {formatCOP(montoMeta, currentRate)}
        </div>
      </div>
    </div>

    <div>
      <div class="w-full h-3 bg-white/5 rounded-full overflow-hidden border border-white/10 relative">
        <div
          class="h-full bg-gradient-to-r from-accent-emerald-lighter via-accent-emerald to-accent-emerald-darker rounded-full transition-all duration-500"
          style={`width: ${montoMeta > 0 ? `${fundingProgress}%` : '0%'}`}
        ></div>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between gap-1 text-xs font-mono text-text-secondary pt-2">
        <span>{montoMeta > 0 ? `${Math.round(fundingProgress)}% Financiado` : 'Meta no definida'}</span>
        <span>
          {montoMeta > 0
            ? `Faltan: ${formatUSD(fundingRemaining)} (${formatCOP(fundingRemaining, currentRate)})`
            : 'Sin objetivo de financiación activo'}
        </span>
      </div>
    </div>
  </div>

</div>
