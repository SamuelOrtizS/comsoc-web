---
import { Icon } from 'astro-icon/components';
import { formatUSD } from '../utils/currency';
import patrocinadores from '../content/patrocinadores.json';

interface Sponsor {
  nombre: string;
  monto?: number;
  proyecto?: string;
  fecha?: string;
  mensaje?: string;
}

const sponsors = patrocinadores as Sponsor[];
---

<!-- Modal Pop-up: Muro de Agradecimientos / Patrocinadores -->
<div
  id="sponsors-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-bg-primary/80 backdrop-blur-xl opacity-0 invisible transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sponsors-modal-title"
>
  <div
    id="sponsors-modal-card"
    class="relative w-full max-w-2xl max-h-[85vh] flex flex-col rounded-[28px] border border-white/15 bg-bg-secondary shadow-[0_25px_70px_rgba(0,0,0,0.8),0_0_30px_rgba(34,211,238,0.15)] overflow-hidden scale-95 transition-transform duration-300"
  >
    <!-- Header del Modal -->
    <div class="flex items-center justify-between p-6 border-b border-white/10 bg-bg-secondary/90">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-cyan/10 border border-accent-cyan/30 text-accent-cyan shadow-[0_0_15px_rgba(34,211,238,0.2)]">
          <Icon name="material-symbols:loyalty-rounded" class="w-5 h-5" aria-hidden="true" />
        </div>
        <div>
          <h3 id="sponsors-modal-title" class="text-xl font-bold text-text-primary">
            Muro de Agradecimientos
          </h3>
          <p class="text-xs text-text-secondary font-light">
            Reconocimiento a quienes hacen posible nuestras metas técnicas y pedagógicas
          </p>
        </div>
      </div>
      <button
        type="button"
        id="close-sponsors-modal"
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-text-primary hover:bg-white/10 transition cursor-pointer"
        aria-label="Cerrar ventana de patrocinadores"
      >
        <Icon name="material-symbols:close-rounded" class="w-5 h-5" aria-hidden="true" />
      </button>
    </div>

    <!-- Contenido scrolleable del Modal -->
    <div class="overflow-y-auto p-6 space-y-4 max-h-[60vh]">
      {sponsors.map((sponsor) => (
        <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4.5 hover:border-accent-cyan/30 transition-all duration-200">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent-blue/15 border border-accent-blue/30 text-accent-cyan text-xs font-mono font-bold">
                ★
              </span>
              <div>
                <h4 class="text-sm font-bold text-text-primary">{sponsor.nombre}</h4>
                {sponsor.fecha && (
                  <span class="text-xs text-text-muted font-mono">{sponsor.fecha}</span>
                )}
              </div>
            </div>

            {sponsor.monto && (
              <div class="self-start sm:self-auto rounded-full border border-accent-emerald/30 bg-accent-emerald/10 px-3 py-1 text-xs font-mono font-semibold text-accent-emerald">
                {formatUSD(sponsor.monto)}
              </div>
            )}
          </div>

          {sponsor.proyecto && (
            <div class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-white/5 px-2.5 py-1 text-xs font-mono text-accent-cyan border border-white/5">
              <Icon name="material-symbols:account-tree-rounded" class="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
              <span class="truncate">Proyecto: {sponsor.proyecto}</span>
            </div>
          )}

          {sponsor.mensaje && (
            <p class="mt-2.5 text-xs font-light text-text-secondary leading-relaxed italic border-l-2 border-accent-cyan/40 pl-3">
              "{sponsor.mensaje}"
            </p>
          )}
        </div>
      ))}
    </div>

    <!-- Footer del Modal -->
    <div class="p-4 border-t border-white/10 bg-bg-secondary/90 flex items-center justify-between text-xs text-text-secondary">
      <span class="font-mono">Total patrocinadores registrados: {sponsors.length}</span>
      <button
        type="button"
        id="close-sponsors-modal-btn"
        class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-text-primary text-xs font-semibold transition cursor-pointer"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>

<script>
  function setupSponsorsModal() {
    const openBtn = document.getElementById('open-sponsors-modal');
    const closeBtn = document.getElementById('close-sponsors-modal');
    const closeFooterBtn = document.getElementById('close-sponsors-modal-btn');
    const modal = document.getElementById('sponsors-modal');
    const modalContent = document.getElementById('sponsors-modal-card');

    if (!modal || !openBtn) return;

    function openModal() {
      modal?.classList.remove('invisible', 'opacity-0');
      modal?.classList.add('visible', 'opacity-100');
      modalContent?.classList.remove('scale-95');
      modalContent?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('invisible', 'opacity-0');
      modal?.classList.remove('visible', 'opacity-100');
      modalContent?.classList.add('scale-95');
      modalContent?.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    closeFooterBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('visible')) closeModal();
    });
  }

  setupSponsorsModal();
  document.addEventListener('astro:page-load', setupSponsorsModal);
</script>
