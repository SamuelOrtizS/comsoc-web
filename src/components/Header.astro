---
import MobileMenu from './MobileMenu.astro';

const navLinks = [
  { name: 'Inicio', href: '/' },
  { 
    name: 'Nosotros', 
    href: '/nosotros',
    subLinks: [
      { name: 'Sobre Nosotros', href: '/nosotros' },
      { name: 'Recursos', href: '/nosotros/recursos' },
    ]
  },
  { name: 'Eventos', href: '/eventos' },
  { 
    name: 'Proyectos', 
    href: '/proyectos',
    subLinks: [
      { name: 'Todos los Proyectos', href: '/proyectos' },
    ]
  },
  { name: 'Convocatorias', href: '/convocatorias' },
  { name: 'Tienda', href: '/tienda' },
  { name: 'Donaciones', href: '/donaciones' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40 bg-bg-primary/70 backdrop-blur-xl border-b border-white/5 transition-all duration-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative flex items-center">
          <img
            src="/images/logo-comsoc.svg"
            alt="IEEE ComSoc Logo"
            decoding="async"
            class="h-16 sm:h-16 w-auto transition-all duration-500 group-hover:scale-110 group-hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]"
          />
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          const hasSublinks = link.subLinks && link.subLinks.length > 0;

          return (
            <div class={`relative group/nav ${hasSublinks ? 'py-2' : ''}`}>
              <a
                href={link.href}
                class={`relative px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 group/link ${
                  isActive
                  ? 'text-accent-cyan'
                  : 'text-text-secondary hover:text-text-primary'
                }`}
              >
                <span class={`relative z-10 ${isActive ? 'font-semibold' : ''}`}>
                  {link.name}
                </span>
                {isActive && (
                  <span class="absolute inset-0 bg-accent-blue/10 rounded-xl border border-accent-cyan/20 shadow-[inset_0_0_12px_rgba(34,211,238,0.1)]" />
                )}
                {!isActive && (
                  <span class="absolute inset-x-0 bottom-0 h-0.5 bg-linear-to-r from-transparent via-accent-cyan to-transparent scale-x-0 transition-transform duration-300 group-hover/link:scale-x-100 opacity-0 group-hover/link:opacity-100"></span>
                )}
              </a>

              {hasSublinks && (
                <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-300 translate-y-2 group-hover/nav:translate-y-0 z-50">
                  <div class="bg-bg-primary/90 backdrop-blur-2xl border border-white/10 rounded-2xl shadow-2xl min-w-[220px] p-2 overflow-hidden">
                    {link.subLinks.map((subLink) => (
                      <a
                        href={subLink.href}
                        class="flex items-center px-4 py-3 rounded-xl text-sm text-text-secondary hover:text-accent-cyan hover:bg-white/5 transition-all duration-200 group/sub"
                      >
                        <span class="relative z-10">{subLink.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- CTA Button & Mobile Trigger -->
      <div class="flex items-center gap-4">
        <a
          href="/unirse"
          class="hidden sm:inline-flex items-center justify-center gap-2 px-7 py-3 text-sm font-extrabold rounded-2xl bg-linear-to-br from-accent-blue via-accent-cyan/60 to-accent-blue bg-size-[200%_200%] text-white shadow-[0_0_20px_rgba(34,211,238,0.3)] transition-all duration-500 hover:scale-[1.05] hover:shadow-[0_0_35px_rgba(34,211,238,0.5)] group relative overflow-hidden active:scale-95"
        >
          <span class="relative z-10">Unirse</span>
          <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
          <svg class="w-4 h-4 transition-all duration-500 group-hover:translate-x-1.5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <!-- Hamburger Icon -->
        <button
          id="open-mobile-menu"
          type="button"
          class="md:hidden p-2.5 rounded-xl bg-glass-bg border border-white/10 text-text-secondary hover:text-text-primary hover:bg-white/5 transition-all duration-300"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

</header>

<MobileMenu />
