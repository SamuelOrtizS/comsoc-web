---
interface Props {
  badgeText: string;
  badgeColor?: 'cyan' | 'purple' | 'emerald';
  badgeDot?: boolean;
  title: string;
  description: string;
  titleMaxWidth?: 'max-w-3xl' | 'max-w-4xl';
  paddingY?: string;
  hasBottomBorder?: boolean;
}

const {
  badgeText,
  badgeColor = 'cyan',
  badgeDot = false,
  title,
  description,
  titleMaxWidth = 'max-w-4xl',
  paddingY = 'py-16 sm:py-20',
  hasBottomBorder = true,
} = Astro.props;

const colorClasses = {
  cyan: {
    badge: 'border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan shadow-[0_0_18px_rgba(34,211,238,0.12)]',
    dot: 'bg-accent-cyan shadow-[0_0_12px_rgba(34,211,238,0.9)]',
    radialGlow: 'bg-[radial-gradient(ellipse_at_top,rgba(34,211,238,0.08),transparent_70%)]',
  },
  purple: {
    badge: 'border-accent-purple/30 bg-accent-purple/10 text-accent-purple shadow-[0_0_18px_rgba(168,85,247,0.12)]',
    dot: 'bg-accent-purple shadow-[0_0_12px_rgba(168,85,247,0.9)]',
    radialGlow: 'bg-[radial-gradient(ellipse_at_top,rgba(168,85,247,0.08),transparent_70%)]',
  },
  emerald: {
    badge: 'border-accent-emerald/30 bg-accent-emerald/10 text-accent-emerald shadow-[0_0_18px_rgba(52,211,153,0.12)]',
    dot: 'bg-accent-emerald shadow-[0_0_12px_rgba(52,211,153,0.9)]',
    radialGlow: 'bg-[radial-gradient(ellipse_at_top,rgba(52,211,153,0.08),transparent_70%)]',
  },
};

const currentTheme = colorClasses[badgeColor] ?? colorClasses.cyan;
---

<section class:list={[
  'relative overflow-hidden hero-header-section',
  hasBottomBorder && 'border-b border-white/10',
  paddingY
]}>
  <!-- Subtle decorative ambient glow -->
  <div class:list={['pointer-events-none absolute inset-0', currentTheme.radialGlow]} aria-hidden="true"></div>
  
  <!-- Subtle top accent line -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent hero-header-line" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <!-- Badge -->
    <div class:list={[
      'mb-5 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em] font-mono hero-header-badge',
      currentTheme.badge
    ]}>
      {badgeDot && (
        <span class:list={['h-2 w-2 rounded-full', currentTheme.dot]} aria-hidden="true"></span>
      )}
      {badgeText}
    </div>

    <!-- Title -->
    <h1 class:list={[
      'mx-auto font-black tracking-[-0.05em] text-text-primary text-4xl sm:text-5xl lg:text-6xl hero-header-title',
      titleMaxWidth
    ]}>
      {title}
    </h1>

    <!-- Description -->
    <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-text-secondary font-light sm:text-lg hero-header-desc">
      {description}
    </p>

    <!-- Optional Slot (Pills, stats, buttons, badges) -->
    <div class="hero-header-slot">
      <slot />
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-header-line {
      transform: scaleX(0);
      animation: lineSweep 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.1s;
    }
    .hero-header-badge {
      opacity: 0;
      transform: translateY(-12px);
      animation: headerItemIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.15s;
    }
    .hero-header-title {
      opacity: 0;
      transform: translateY(18px);
      animation: headerItemIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.25s;
    }
    .hero-header-desc {
      opacity: 0;
      transform: translateY(16px);
      animation: headerItemIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.35s;
    }
    .hero-header-slot {
      opacity: 0;
      transform: translateY(14px);
      animation: headerItemIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.45s;
    }

    @keyframes lineSweep {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }

    @keyframes headerItemIn {
      from {
        opacity: 0;
        transform: translateY(18px);
        filter: blur(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }
</style>

