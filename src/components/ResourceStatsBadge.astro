---
interface Props {
  totalRecursos: number;
  totalCategorias: number;
}

const { totalRecursos, totalCategorias } = Astro.props;
---

{totalRecursos > 0 && (
  <div class="resource-stats-badge mt-8 flex flex-wrap items-center justify-center gap-3">
    <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-2 text-xs font-mono text-text-secondary backdrop-blur-md transition-all duration-300 hover:border-accent-cyan/40 hover:bg-accent-cyan/5">
      <span class="h-2 w-2 rounded-full bg-accent-cyan shadow-[0_0_10px_rgba(34,211,238,0.7)] animate-pulse"></span>
      <span class="text-text-primary font-semibold">{totalRecursos}</span>
      <span>{totalRecursos === 1 ? 'recurso' : 'recursos'}</span>
    </div>
    <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-2 text-xs font-mono text-text-secondary backdrop-blur-md transition-all duration-300 hover:border-accent-purple/40 hover:bg-accent-purple/5">
      <span class="h-2 w-2 rounded-full bg-accent-purple shadow-[0_0_10px_rgba(168,85,247,0.7)] animate-pulse"></span>
      <span class="text-text-primary font-semibold">{totalCategorias}</span>
      <span>{totalCategorias === 1 ? 'categoría' : 'categorías'}</span>
    </div>
    <div class="hidden sm:inline-flex items-center gap-2 rounded-full border border-accent-blue/20 bg-accent-blue/10 px-3 py-2 text-xs font-mono text-accent-blue backdrop-blur-md transition-all duration-300 hover:border-accent-blue/40">
      <span>Acceso libre</span>
      <span class="text-accent-blue/60">•</span>
      <span class="text-text-secondary">descarga directa</span>
    </div>
  </div>
)}

<style>
  @media (prefers-reduced-motion: no-preference) {
    .resource-stats-badge {
      animation: badgeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes badgeIn {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.96);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
  }
</style>

