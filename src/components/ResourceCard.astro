---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getImageModule } from '../utils/imageImports';

interface Props {
  recurso: CollectionEntry<'recursos'>;
}

const { recurso } = Astro.props;
const { titulo, descripcion, categoria, imagen, links } = recurso.data;
let resolvedImagen: any = undefined;
if (imagen) {
  if (typeof imagen === 'string') {
    if (imagen.startsWith('http://') || imagen.startsWith('https://')) {
      // Remote URL - render as regular img
      resolvedImagen = imagen;
    } else {
      // Try to resolve as imported module
      const importedImage = getImageModule(imagen);
      if (importedImage) {
        resolvedImagen = importedImage;
      }
    }
  }
}
---

<div class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-bg-secondary/80 shadow-[0_18px_45px_rgba(15,23,42,0.38)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 hover:shadow-[0_24px_60px_rgba(34,211,238,0.10)]">
  {imagen ? (
    <div class="relative aspect-video w-full overflow-hidden bg-bg-secondary">
      <Image
        src={resolvedImagen as any}
        alt={titulo}
        width={800}
        height={450}
        sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        decoding="async"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg-primary-lighter/50 via-bg-secondary-lighter/25 to-transparent"></div>
      <div class="absolute left-3 top-3">
        <span class="inline-flex items-center rounded-full border border-white/15 bg-black/60 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.14em] text-white backdrop-blur-md">
          {categoria}
        </span>
      </div>
    </div>
  ) : (
    <div class="h-1 w-full bg-gradient-to-r from-accent-cyan-lighter to-accent-purple opacity-80"></div>
  )}

  <div class="flex flex-grow flex-col p-6">
    {!imagen && (
      <span class="mb-3 inline-flex w-fit rounded-full border border-accent-cyan/20 bg-accent-cyan/10 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.14em] text-accent-cyan">
        {categoria}
      </span>
    )}

    <h3 class="mb-2 line-clamp-2 text-lg font-bold leading-tight text-text-primary transition-colors duration-300 group-hover:text-accent-cyan">
      {titulo}
    </h3>

    <p class="mb-6 line-clamp-5 flex-grow text-sm leading-relaxed text-text-secondary">
      {descripcion}
    </p>

    <div class="space-y-2">
      {links.map((link) => {
        const isExternal = link.url.startsWith('http://') || link.url.startsWith('https://');
        const iconName = link.tipo === 'Canva' 
          ? 'material-symbols:palette' 
          : (link.tipo === 'Herramienta' || link.tipo === 'App')
            ? 'material-symbols:build-circle-rounded'
            : 'material-symbols:download-rounded';

        return (
          <a
            href={link.url}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
            class="group/link flex items-center justify-between gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-text-primary transition-all duration-200 hover:border-accent-cyan/30 hover:bg-accent-cyan/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-secondary"
          >
            <span class="flex items-center gap-2">
              <Icon name={iconName} class="w-4 h-4 shrink-0 text-text-secondary transition-colors group-hover/link:text-accent-cyan" aria-hidden="true" />
              <span>{link.label}</span>
            </span>
            <span class="flex items-center gap-1.5">
              {link.tipo && link.tipo !== 'Download' && (
                <span class="rounded-full border border-accent-cyan/20 bg-accent-cyan/15 px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wide text-accent-cyan">
                  {link.tipo}
                </span>
              )}
              <Icon name="material-symbols:arrow-forward-rounded" class="w-3.5 h-3.5 shrink-0 text-text-secondary transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:text-accent-cyan" aria-hidden="true" />
            </span>
          </a>
        );
      })}
    </div>
  </div>
</div>
