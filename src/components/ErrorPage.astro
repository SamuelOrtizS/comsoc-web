---
import { Icon } from 'astro-icon/components';
interface Props {
  code: string;
  tagline: string;
  title: string;
  description: string;
  color: 'red' | 'amber' | 'purple' | 'cyan' | 'green' | 'teal';
  /** Google Symbols icon. Puede ser nombre corto ("shield"), con prefijo ("material-symbols:shield-rounded") o cualquier colección Iconify ("mdi:server") */
  icon: string;
  showRetry?: boolean;
}

const { code, tagline, title, description, color, icon, showRetry = true } = Astro.props;

const colorMap = {
  red:    { bg: 'from-accent-red/20 to-accent-yellow/20', border: 'border-accent-red/30', text: 'text-accent-red', badge: 'bg-accent-red/10 border-accent-red/30 text-accent-red', dot: 'bg-accent-red', glow: 'rgba(239,68,68,0.15)', btn: 'from-accent-red to-accent-yellow', shadow: 'shadow-accent-red/25', grad: 'from-[#ef4444] via-[#f43f5e] to-[#ec4899]' },
  amber:  { bg: 'from-accent-amber/20 to-orange-500/20', border: 'border-accent-amber/30', text: 'text-accent-amber', badge: 'bg-accent-amber/10 border-accent-amber/30 text-accent-amber', dot: 'bg-accent-amber', glow: 'rgba(245,158,11,0.15)', btn: 'from-accent-amber to-orange-500', shadow: 'shadow-accent-amber/25', grad: 'from-[#f59e0b] via-[#f97316] to-[#ef4444]' },
  purple: { bg: 'from-accent-purple/20 to-indigo-500/20', border: 'border-accent-purple/30', text: 'text-accent-purple', badge: 'bg-accent-purple/10 border-accent-purple/30 text-accent-purple', dot: 'bg-accent-purple', glow: 'rgba(168,85,247,0.15)', btn: 'from-accent-purple to-indigo-500', shadow: 'shadow-accent-purple/25', grad: 'from-[#a855f7] via-[#8b5cf6] to-[#6366f1]' },
  cyan:   { bg: 'from-accent-cyan/20 to-accent-blue/20', border: 'border-accent-cyan/30', text: 'text-accent-cyan', badge: 'bg-accent-cyan/10 border-accent-cyan/30 text-accent-cyan', dot: 'bg-accent-cyan', glow: 'rgba(34,211,238,0.15)', btn: 'from-accent-cyan to-accent-blue', shadow: 'shadow-accent-cyan/25', grad: 'from-[#22d3ee] via-[#3b82f6] to-[#6366f1]' },
  green: { bg: 'from-green-500/20 to-accent-emerald/20', border: 'border-green-500/30', text: 'text-green-300', badge: 'bg-green-500/10 border-green-500/30 text-green-300', dot: 'bg-green-400', glow: 'rgba(34,197,94,0.15)', btn: 'from-green-500 to-accent-emerald', shadow: 'shadow-green-500/25', grad: 'from-[#34d399] via-[#10b981] to-[#059669]' },
  teal: { bg: 'from-accent-teal/20 to-accent-cyan/20', border: 'border-accent-teal/30', text: 'text-accent-teal', badge: 'bg-accent-teal/10 border-accent-teal/30 text-accent-teal', dot: 'bg-accent-teal', glow: 'rgba(6,182,212,0.15)', btn: 'from-accent-teal to-accent-cyan', shadow: 'shadow-accent-teal/25', grad: 'from-[#2dd4bf] via-[#34d399] to-[#0d9488]' },
};

const c = colorMap[color];

// Mapeo de iconos legacy → Google Symbols (material-symbols) para compatibilidad — optimizado semánticamente
const legacyIconMap: Record<string, string> = {
  shield: 'material-symbols:shield-rounded', // 403 acceso denegado — protección
  server: 'material-symbols:error-rounded', // 500 error interno — fallo sistema (antes dns, no semántico para 500)
  gateway: 'material-symbols:search-off-rounded', // 404 señal perdida — búsqueda fallida (antes router, más preciso para "no encontrado")
  maintenance: 'material-symbols:construction-rounded',
  cicada: 'material-symbols:bug-report-rounded',
};

// Permite custom symbols: si contiene ":", se usa tal cual (ej. "mdi:server" o "material-symbols:rocket-launch-rounded")
// Si no, se busca en legacyMap y si no existe se asume material-symbols:<icon>
const resolvedIcon = icon.includes(':') ? icon : (legacyIconMap[icon] ?? `material-symbols:${icon}`);
---

<section class="min-h-[calc(100vh-10rem)] flex items-center justify-center px-4 sm:px-6 lg:px-8 relative overflow-hidden">

  <!-- Scan-lines -->
  <div class="absolute inset-0 pointer-events-none select-none scanlines" aria-hidden="true"></div>

  <!-- Ambient glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-125 h-75 rounded-full blur-[120px] pointer-events-none" style={`background: ${c.glow};`}></div>

  <!-- Decorative rings -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" aria-hidden="true">
    <div class={`ring-pulse w-[320px] h-80 sm:w-105 sm:h-105 rounded-full border ${c.border} opacity-30`}></div>
    <div class={`ring-pulse ring-delay-1 absolute w-50 h-50 sm:w-70 sm:h-70 rounded-full border ${c.border} opacity-20`}></div>
  </div>

  <div class="relative z-10 text-center max-w-xl mx-auto flex flex-col items-center gap-8">

    <!-- Error code + icon (custom Google Symbol) -->
    <div class="relative">
      <div class={`w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-linear-to-br ${c.bg} ${c.border} border flex items-center justify-center error-icon-pulse`}>
        <Icon name={resolvedIcon} class={`w-14 h-14 sm:w-16 sm:h-16 ${c.text}`} aria-hidden="true" />
      </div>
      <div class={`absolute -top-1 -right-1 w-5 h-5 rounded-full ${c.dot} opacity-80 border-2 border-bg-primary animate-pulse`}></div>
    </div>

    <!-- Error number -->
    <h1 class="text-6xl sm:text-7xl font-black leading-none tracking-[-0.06em] select-none text-white drop-shadow-[0_0_30px_rgba(34,211,238,0.25)]">
      {code}
    </h1>

    <!-- Message -->
    <div class="space-y-3 -mt-2">
      <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-[10px] font-mono uppercase tracking-[0.2em] ${c.badge}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${c.dot} animate-pulse`}></span>
        {tagline}
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-[-0.04em]">
        {title}
      </h2>
      <p class="text-text-secondary text-sm sm:text-base font-light leading-relaxed max-w-md mx-auto">
        {description}
      </p>
    </div>

    <!-- Diagnostic panel -->
    <div class={`glass-card rounded-2xl px-6 py-5 border ${c.border} w-full max-w-sm`} style="border-color: var(--diag-border, rgba(255,255,255,0.1));">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-accent-red/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-accent-yellow"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 opacity-30"></span>
        <span class="text-[10px] font-mono text-text-secondary ml-auto uppercase tracking-[0.18em]">diagnostics.log</span>
      </div>
      <code class="text-xs font-mono text-text-secondary block text-left leading-relaxed">
        <span class={c.text}>[{code}]</span> {tagline}<br/>
        <span class="text-text-secondary">├─</span> path: <span class="text-accent-cyan error-page-path"></span><br/>
        <span class="text-text-secondary">├─</span> time: <span class="text-accent-cyan error-page-ts"></span><br/>
        <span class="text-text-secondary">└─</span> action: <span class="text-accent-emerald">{showRetry ? 'retry or navigate home' : 'navigate home'}</span>
      </code>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap justify-center gap-4 pt-2">
      {showRetry && (
        <button
          onclick="window.location.reload()"
          class={`px-7 py-3 rounded-xl font-semibold text-text-primary bg-linear-to-r ${c.btn} shadow-lg ${c.shadow} hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/80 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary transition-all duration-200 cursor-pointer`}
        >
          Reintentar
        </button>
      )}
      <a
        href="/"
        class={`px-7 py-3 rounded-xl font-semibold text-text-secondary bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/80 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary transition-all duration-200 ${!showRetry ? 'bg-linear-to-r ' + c.btn + ' text-text-primary shadow-lg ' + c.shadow : ''}`}
      >
        Volver al Inicio
      </a>
    </div>
  </div>
</section>

<style>
  .scanlines {
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.08) 4px,
      rgba(0, 0, 0, 0.08) 8px
    );
  }

  .error-icon-pulse {
    animation: icon-glow 3s ease-in-out infinite;
  }

  @keyframes icon-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
    50% { box-shadow: 0 0 40px 8px rgba(34, 211, 238, 0.18); }
  }

  .ring-pulse {
    animation: ring-expand 4s ease-in-out infinite;
  }
  .ring-delay-1 { animation-delay: 1.5s; }

  @keyframes ring-expand {
    0%, 100% { transform: scale(1); opacity: 0.3; }
    50% { transform: scale(1.06); opacity: 0.7; }
  }
</style>

<script>
  document.querySelectorAll('.error-page-path').forEach(el => {
    el.textContent = window.location.pathname;
  });
  document.querySelectorAll('.error-page-ts').forEach(el => {
    el.textContent = new Date().toISOString().replace('T', ' ').slice(0, 19);
  });
</script>
