---
import { Icon } from 'astro-icon/components';
interface Props {
  id: string;
  titulo: string;
  area: string;
  fechaLimite: string;
  descripcion: string;
  requisitos?: string[];
  responsabilidades?: string[];
  estado?: 'Publicada' | 'Cerrada';
  formUrl?: string;
}

const {
  id,
  titulo,
  area,
  fechaLimite,
  descripcion,
  requisitos = [],
  estado = 'Publicada',
  formUrl,
} = Astro.props;

const isClosed = estado === 'Cerrada';
---

<article class={`glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between h-full border transition-all duration-500 ease-out will-change-transform ${isClosed ? 'border-white/8 opacity-75 hover:opacity-90 hover:border-white/15' : 'from-accent-blue-lighter to-accent-blue-darker bg-linear-to-br border-accent-cyan/30 shadow-lg shadow-accent-blue/20 hover:shadow-xl hover:shadow-accent-cyan/30 hover:border-accent-cyan/45 hover:-translate-y-1'}`} aria-labelledby={` convocatorias-title-${id}`}>
  <div>
    <!-- Decorative Background Pattern -->
    <div class="absolute inset-0 rounded-2xl overflow-hidden pointer-events-none">
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-accent-purple/5 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 -left-16 w-32 h-32 bg-accent-blue/5 rounded-full blur-2xl"></div>
    </div>

    <!-- Top Area Badge & Status -->
    <header class="relative z-10">
      <div class="flex flex-wrap items-center justify-between gap-2.5 mb-4">
        <span class="group/area relative px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all duration-300 hover:bg-accent-purple/15 hover:border-accent-purple/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-purple focus-visible:z-20 bg-accent-purple/10 text-accent-purple border border-accent-purple/30 inline-flex w-fit shadow-sm hover:shadow-md" aria-label={`Área: ${area}`} id={` convocatorias-area-${id}`}>
          <span class="absolute inset-0 rounded-full opacity-0 group-hover/area:opacity-100 transition-opacity duration-300 bg-linear-to-r from-accent-purple/5 to-accent-blue/5"></span>
          <Icon name="material-symbols:category-rounded" class="inline-block w-3.5 h-3.5 mr-1.5 -ml-0.5 opacity-70" aria-hidden="true" />
          {area}
        </span>
        <span class={`group/status inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition-all duration-300 shadow-sm ${isClosed ? 'from-accent-red-lighter to-accent-red-darker bg-linear-to-br text-accent-red border border-accent-red/30 hover:border-accent-red/45' : 'from-accent-emerald-lighter to-accent-emerald-darker bg-linear-to-br text-accent-emerald border border-accent-emerald/30 hover:border-accent-emerald/45'}`} aria-labelledby={` convocatorias-status-${id}`}>
          <span class="w-1.5 h-1.5 rounded-full relative">
            <span class={`absolute inset-0 rounded-full animate-ping-slow opacity-75 ${isClosed ? 'bg-accent-red/40' : 'bg-accent-emerald/40'}`} aria-hidden="true"></span>
            <span class="relative w-1.5 h-1.5 rounded-full bg-current"></span>
          </span>
          <span id={` convocatorias-status-${id}`} aria-hidden="true">{isClosed ? 'Cerrada' : 'Abierta'}</span>
        </span>
      </div>

      <!-- Title -->
      <h3 class="relative z-10 text-lg sm:text-xl font-bold text-text-primary mb-2.5 leading-tight group/title transition-colors duration-300 hover:text-accent-cyan" id={` convocatorias-title-${id}`}>
        <span class="absolute inset-0 bg-linear-to-r from-transparent via-text-primary/90 to-transparent -right-16 blur-sm -z-1 group-hover/title:opacity-100 opacity-0 transition-opacity duration-300"></span>
        {titulo}
      </h3>

      <!-- Description -->
      <p class="relative z-10 text-xs sm:text-sm text-text-secondary leading-relaxed font-light mb-4.5 line-clamp-3 transition-colors duration-300 ease-in-out group-hover/description:text-text-primary/80" id={` convocatorias-description-${id}`}>
        {descripcion}
      </p>

      <!-- Key Requirements Preview -->
      {requisitos.length > 0 && (
        <section class="relative z-10 space-y-2.5 mb-6 overflow-hidden group/requirements transition-colors duration-300 ease-in-out hover:mb-7">
          <div class="text-xs uppercase tracking-wider text-text-secondary/70 font-mono flex items-center gap-1.5">
            <Icon name="material-symbols:list-rounded" class="w-3.5 h-3.5 text-accent-cyan/70" aria-hidden="true" />
            <span>Requisitos clave</span>
          </div>
          <nav class="space-y-2.5 text-sm transition-colors duration-300" aria-label={`Requisitos de ${titulo}`}>
            {requisitos.slice(0, 2).map((req, index) => (
              <li class="flex items-start gap-3 group/req transition-all duration-300 ease-in-out hover:pl-6">
                <div class="relative shrink-0 mt-0.5">
                  <Icon 
                    name={index === 0 ? 'material-symbols:check-rounded' : 'material-symbols:add-circle-rounded'} 
                    class="w-4 h-4 shrink-0 text-accent-cyan/80 group-hover/req:text-accent-cyan transition-colors duration-300" 
                    aria-hidden="true" 
                  />
                  <span class={`absolute -top-0.5 -left-0.5 w-1 h-1 rounded-full bg-accent-cyan/0 group-hover/req:bg-accent-cyan/60 transition-all duration-300`} aria-hidden="true"></span>
                </div>
                <span class={`line-clamp-2 wrap-break-word transition-colors duration-300 ${isClosed ? 'text-text-secondary' : 'group-hover/req:text-accent-cyan/90'}`} style="flex-grow: 1;">{req}</span>
              </li>
            ))}
          </nav>
        </section>
      )}
    </header>

    <!-- Bottom CTA & Deadline -->
    <footer class="relative z-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <section aria-label={`Información temporal para ${titulo}`} class="shrink-0">
        <div class="group/time text-xs sm:text-sm font-mono transition-all duration-300 hover:text-accent-cyan/90">
          <span class="text-text-secondary/80 block text-[10px] uppercase tracking-wide mb-1.5">Fecha límite</span>
          <time datetime={fechaLimite} class="inline-flex items-center gap-2 mt-1 group-hover/time:gap-3 transition-all duration-300">
            <div class="relative">
              <Icon 
                name="material-symbols:calendar-clock-rounded" 
                class="w-4 h-4 shrink-0 text-accent-cyan/80 group-hover/time:text-accent-cyan transition-colors duration-300" 
                aria-hidden="true" 
              />
              <span class={`absolute -inset-1 rounded-full opacity-0 group-hover/time:opacity-20 transition-all duration-300 bg-accent-cyan`}></span>
            </div>
            <span class="relative tracking-tight">{fechaLimite}</span>
          </time>
        </div>
      </section>

      <nav class="flex items-center gap-2 w-full sm:w-auto" aria-label="Acciones de convocatoria">
        <a
          href={`/convocatorias/${id}`}
          class="group/detail relative flex-1 sm:flex-none text-center px-4.5 py-2.5 text-sm font-semibold rounded-xl bg-white/5 hover:bg-white/15 text-text-primary hover:text-text-primary border border-white/10 hover:border-white/20 transition-all duration-300 ease-in-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:z-20 overflow-hidden before:absolute before:inset-0 before:bg-linear-to-r before:from-accent-blue before:to-accent-cyan opacity-100 group-hover/detail:opacity-95"
          aria-label={`Ver detalles de ${titulo}`}
        >
          <span class="relative flex items-center justify-center gap-2">
            <span>Detalles</span>
            <Icon name="material-symbols:info-outline-rounded" class="w-4 h-4 opacity-70 group-hover/detail:scale-110 transition-transform duration-300" aria-hidden="true" />
          </span>
        </a>
        
        {!isClosed && formUrl ? (
          <a
            href={formUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group/apply relative flex-1 sm:flex-none text-center px-4.5 py-2.5 text-sm font-semibold rounded-xl bg-linear-to-r from-accent-blue to-accent-cyan text-text-primary shadow-lg shadow-accent-blue/30 hover:shadow-xl hover:shadow-accent-cyan/40 hover:-translate-y-0.5 transition-all duration-300 ease-out flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-1 focus-visible:ring-offset-bg-primary overflow-hidden before:absolute before:inset-0 before:bg-linear-to-r before:from-accent-blue before:to-accent-cyan opacity-100 group-hover/apply:opacity-95"
            aria-label={`Postular para ${titulo}`}
          >
            <span class="relative flex items-center gap-2">
              <span>Postular</span>
              <Icon 
                name="material-symbols:send-rounded" 
                class="w-4 h-4 group-hover/apply:scale-110 transition-transform duration-300" 
                aria-hidden="true" 
              />
            </span>
          </a>
        ) : (
          <a
            href={`/convocatorias/${id}`}
            class="group/view relative flex-1 sm:flex-none text-center px-4.5 py-2.5 text-sm font-semibold rounded-xl bg-accent-cyan/15 hover:bg-accent-cyan/25 text-accent-cyan border border-accent-cyan/30 hover:border-accent-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:z-20 overflow-hidden before:absolute before:inset-0 before:bg-accent-cyan opacity-100 group-hover/view:opacity-95"
            aria-label={`Ver postulación para ${titulo}`}
          >
            <span class="relative flex items-center justify-center gap-2">
              <Icon name="material-symbols:visibility-rounded" class="w-4 h-4 opacity-80 group-hover/view:scale-110 transition-transform duration-300" aria-hidden="true" />
              <span>Ver Postulación</span>
            </span>
          </a>
        )}
      </nav>
    </footer>
  </div>
</article>
