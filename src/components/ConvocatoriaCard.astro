---
import { Icon } from 'astro-icon/components';
interface Props {
  id: string;
  titulo: string;
  area: string;
  fechaLimite: string;
  descripcion: string;
  requisitos?: string[];
  responsabilidades?: string[];
  estado?: 'Publicada' | 'Cerrada';
  formUrl?: string;
}

const {
  id,
  titulo,
  area,
  fechaLimite,
  descripcion,
  requisitos = [],
  estado = 'Publicada',
  formUrl,
} = Astro.props;

const isClosed = estado === 'Cerrada';
---

<div class={`glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between h-full border transition-all duration-300 ${isClosed ? 'border-white/10 opacity-75 hover:opacity-85' : 'from-accent-blue-lighter to-accent-blue-darker bg-gradient-to-br border-accent-cyan/30 shadow-lg shadow-accent-blue/15 hover:shadow-accent-cyan/25 hover:border-accent-cyan/50'}`}>
  <div>
    <!-- Top Area Badge & Status -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-accent-purple/10 text-accent-purple border border-accent-purple/30 inline-flex w-fit">
        {area}
      </span>
      <span class={`text-xs font-mono px-2.5 py-1 rounded-lg inline-flex items-center gap-1.5 ${isClosed ? 'from-accent-red-lighter to-accent-red-darker bg-gradient-to-br text-accent-red border border-accent-red/20' : 'from-accent-emerald-lighter to-accent-emerald-darker bg-gradient-to-br text-accent-emerald border border-accent-emerald/20'}`}>
        <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-current"></span>
        <span>{isClosed ? 'Cerrada' : 'Abierta'}</span>
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-lg sm:text-xl font-bold text-text-primary mb-3 leading-snug">
      {titulo}
    </h3>

    <!-- Description -->
    <p class="text-sm text-text-secondary leading-relaxed font-light mb-6">
      {descripcion}
    </p>

    <!-- Key Requirements Preview -->
    {requisitos.length > 0 && (
      <div class="space-y-2 mb-6">
        <div class="text-xs uppercase tracking-wider text-text-secondary font-mono">Requisitos clave:</div>
        <ul class="space-y-2 text-sm text-text-secondary">
          {requisitos.slice(0, 2).map((req) => (
            <li class="flex items-start gap-2.5">
              <Icon name="material-symbols:check-rounded" class="w-4 h-4 flex-shrink-0 text-accent-cyan mt-0.5" aria-hidden="true" />
              <span class="line-clamp-2 break-words">{req}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Bottom CTA & Deadline -->
  <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="text-sm text-text-secondary font-mono w-full sm:w-auto">
      <span class="text-text-secondary block text-[10px] uppercase">Fecha límite</span>
      <time class="inline-flex items-center gap-1.5 mt-1.5">
        <Icon name="material-symbols:calendar-clock-rounded" class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
        <span>{fechaLimite}</span>
      </time>
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <a
        href={`/convocatorias/${id}`}
        class="flex-1 sm:flex-none text-center px-4 py-2.5 text-sm font-semibold rounded-xl bg-white/5 hover:bg-white/15 text-text-secondary hover:text-text-primary border border-white/10 hover:border-white/20 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/60"
      >
        Detalles
      </a>
      
      {!isClosed && formUrl ? (
        <a
          href={formUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-none text-center px-4 py-2.5 text-sm font-semibold rounded-xl bg-linear-to-r from-accent-blue to-accent-cyan text-text-primary shadow-lg shadow-accent-blue/25 hover:shadow-accent-blue/40 hover:from-accent-blue hover:to-accent-cyan hover:brightness-110 active:scale-95 transition-all duration-200 flex items-center justify-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          <span>Postular</span>
          <Icon name="material-symbols:open-in-new-rounded" class="w-4 h-4" aria-hidden="true" />
        </a>
      ) : (
        <a
          href={`/convocatorias/${id}`}
          class="flex-1 sm:flex-none text-center px-4 py-2.5 text-sm font-semibold rounded-xl bg-accent-cyan/20 text-accent-cyan border border-accent-cyan/30 hover:bg-accent-cyan/30 hover:border-accent-cyan/50 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/60"
        >
          Ver Postulación
        </a>
      )}
    </div>
  </div>
</div>
