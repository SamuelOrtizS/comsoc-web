---
interface Props {
  id: string;
  titulo: string;
  area: string;
  fechaLimite: string;
  descripcion: string;
  requisitos?: string[];
  responsabilidades?: string[];
  estado?: 'Publicada' | 'Cerrada';
  formUrl?: string;
}

const {
  id,
  titulo,
  area,
  fechaLimite,
  descripcion,
  requisitos = [],
  estado = 'Publicada',
  formUrl,
} = Astro.props;

const isClosed = estado === 'Cerrada';
---

<div class={`glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between h-full border ${isClosed ? 'opacity-70 border-white/5' : 'border-[var(--color-accent-cyan)]/30 shadow-xl shadow-[var(--color-accent-blue)]/10'}`}>
  <div>
    <!-- Top Area Badge & Status -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-accent-purple)]/10 text-accent-purple border border-[var(--color-accent-purple)]/30">
        {area}
      </span>
      <span class={`text-xs font-mono px-2.5 py-0.5 rounded-md ${isClosed ? 'bg-[var(--color-accent-red)]/10 text-[var(--color-accent-red)] border border-[var(--color-accent-red)]/20' : 'bg-[var(--color-accent-emerald)]/10 text-[var(--color-accent-emerald)] border border-[var(--color-accent-emerald)]/20'}`}>
        {estado}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-3">
      {titulo}
    </h3>

    <!-- Description -->
    <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed font-light mb-6">
      {descripcion}
    </p>

    <!-- Key Requirements Preview -->
    {requisitos.length > 0 && (
      <div class="space-y-2 mb-6">
        <div class="text-xs uppercase tracking-wider text-[var(--color-text-secondary)] font-mono">Requisitos clave:</div>
        <ul class="space-y-1.5 text-xs text-[var(--color-text-secondary)]">
          {requisitos.slice(0, 2).map((req) => (
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-accent-cyan)] mt-0.5">▹</span>
              <span class="line-clamp-1">{req}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Bottom CTA & Deadline -->
  <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-xs text-[var(--color-text-secondary)] font-mono w-full sm:w-auto">
      <span class="text-[var(--color-text-secondary)] block text-[10px] uppercase">Fecha límite</span>
      ⏳ {fechaLimite}
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <a
        href={`/convocatorias/${id}`}
        class="flex-1 sm:flex-none text-center px-4 py-2 text-xs font-semibold rounded-xl bg-white/5 hover:bg-white/10 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] border border-white/10 transition"
      >
        Detalles
      </a>
      
      {!isClosed && formUrl ? (
        <a
          href={formUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-none text-center px-4 py-2 text-xs font-semibold rounded-xl bg-linear-to-r from-accent-blue to-accent-cyan text-[var(--color-text-primary)] hover:opacity-90 shadow-md shadow-[var(--color-accent-blue)]/20 transition"
        >
          Postular ↗
        </a>
      ) : (
        <a
          href={`/convocatorias/${id}`}
          class="flex-1 sm:flex-none text-center px-4 py-2 text-xs font-semibold rounded-xl bg-[var(--color-accent-cyan)]/20 text-[var(--color-accent-cyan)] border border-[var(--color-accent-cyan)]/30 hover:bg-[var(--color-accent-cyan)]/30 transition"
        >
          Ver Postulación
        </a>
      )}
    </div>
  </div>
</div>
