---
interface Props {
  id: string;
  titulo: string;
  area: string;
  fechaLimite: string;
  descripcion: string;
  requisitos?: string[];
  responsabilidades?: string[];
  estado?: 'Publicada' | 'Cerrada';
  formUrl?: string;
}

const {
  id,
  titulo,
  area,
  fechaLimite,
  descripcion,
  requisitos = [],
  estado = 'Publicada',
  formUrl,
} = Astro.props;

const isClosed = estado === 'Cerrada';
---

<div class={`glass-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between h-full border ${isClosed ? 'opacity-70 border-white/5' : 'border-purple-500/20 shadow-xl shadow-purple-950/20'}`}>
  <div>
    <!-- Top Area Badge & Status -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-300 border border-purple-500/30">
        {area}
      </span>
      <span class={`text-xs font-mono px-2.5 py-0.5 rounded-md ${isClosed ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'}`}>
        {estado}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-white mb-3">
      {titulo}
    </h3>

    <!-- Description -->
    <p class="text-sm text-gray-400 leading-relaxed font-light mb-6">
      {descripcion}
    </p>

    <!-- Key Requirements Preview -->
    {requisitos.length > 0 && (
      <div class="space-y-2 mb-6">
        <div class="text-xs uppercase tracking-wider text-gray-500 font-mono">Requisitos clave:</div>
        <ul class="space-y-1.5 text-xs text-gray-300">
          {requisitos.slice(0, 2).map((req) => (
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 mt-0.5">▹</span>
              <span class="line-clamp-1">{req}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Bottom CTA & Deadline -->
  <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-xs text-gray-400 font-mono w-full sm:w-auto">
      <span class="text-gray-500 block text-[10px] uppercase">Fecha límite</span>
      ⏳ {fechaLimite}
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <a
        href={`/comsoc-web/convocatorias/${id}`}
        class="flex-1 sm:flex-none text-center px-4 py-2 text-xs font-semibold rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white border border-white/10 transition"
      >
        Detalles
      </a>
      
      {!isClosed && formUrl ? (
        <a
          href={formUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-none text-center px-4 py-2 text-xs font-semibold rounded-xl bg-gradient-to-r from-[#155dfc] to-[#22d3ee] text-white hover:opacity-90 shadow-md shadow-blue-500/20 transition"
        >
          Postular ↗
        </a>
      ) : (
        <a
          href={`/comsoc-web/convocatorias/${id}`}
          class="flex-1 sm:flex-none text-center px-4 py-2 text-xs font-semibold rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-500/30 transition"
        >
          Ver Postulación
        </a>
      )}
    </div>
  </div>
</div>
