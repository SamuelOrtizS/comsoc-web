---
// TouchRipple.astro - Efecto de propagación de onda en dispositivos táctiles
---
<div id="touch-ripple-container" class="pointer-events-none fixed inset-0 z-9998 overflow-hidden"></div>

<style is:global>
  .touch-ripple {
    position: absolute;
    border-radius: 9999px;
    width: 180px;
    height: 180px;
    margin-left: -90px;
    margin-top: -90px;
    transform: translate(-50%, -50%) scale(0.07);
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(
      circle,
      var(--color-accent-cyan, rgba(34, 211, 238, 0.6)) 0%,
      var(--color-accent-blue, rgba(21, 93, 252, 0.38)) 28%,
      var(--color-accent-cyan, rgba(34, 211, 238, 0.14)) 56%,
      rgba(34, 211, 238, 0) 72%
    );
    border: 1px solid var(--color-accent-cyan, rgba(34, 211, 238, 0.65));
    box-shadow:
      0 0 0 1px var(--color-accent-cyan, rgba(34, 211, 238, 0.12)),
      0 0 24px var(--color-accent-cyan, rgba(34, 211, 238, 0.28)),
      inset 0 0 18px var(--color-accent-cyan, rgba(34, 211, 238, 0.14));
    mix-blend-mode: screen;
    will-change: transform, opacity;
    contain: paint;
    animation: ripple-animation 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes ripple-animation {
    0% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(0.07);
    }
    26% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .touch-ripple {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  if (typeof window !== 'undefined') {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    if (isTouchDevice && !prefersReducedMotion) {
      const container = document.getElementById('touch-ripple-container');
      const MAX_RIPPLES = 6;

      const createRipple = (x: number, y: number) => {
        if (!container) return;

        if (container.children.length >= MAX_RIPPLES) {
          container.firstElementChild?.remove();
        }

        const ripple = document.createElement('span');
        ripple.classList.add('touch-ripple');
        ripple.style.left = `${x}px`;
        ripple.style.top = `${y}px`;

        container.appendChild(ripple);

        window.setTimeout(() => {
          ripple.remove();
        }, 720);
      };

      window.addEventListener(
        'touchstart',
        (event: TouchEvent) => {
          const count = Math.min(event.touches.length, 3);
          for (let index = 0; index < count; index += 1) {
            const touch = event.touches[index];
            createRipple(touch.clientX, touch.clientY);
          }
        },
        { passive: true }
      );
    }
  }
</script>
