---
interface Props {
  targetDate: string;
  eventName?: string;
}

const { targetDate, eventName = "Próximo Evento" } = Astro.props;
---

<div class="glass-card relative overflow-hidden rounded-2xl border border-accent-cyan/20 p-5 shadow-xl shadow-[rgba(69,219,237,0.3)] sm:p-6">
  <div class="mb-4 flex items-center justify-between gap-3 sm:gap-4">
    <div class="flex min-w-0 items-center gap-2">
      <span class="h-2.5 w-2.5 animate-ping rounded-full bg-accent-cyan shadow-[0_0_12px_rgba(69,219,237,0.85)]"></span>
      <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-accent-cyan sm:text-xs">Cuenta Regresiva</span>
    </div>
    <span
      class="ml-auto max-w-28 min-w-0 truncate text-right font-mono text-[10px] text-text-secondary sm:max-w-48 sm:text-xs"
      title={eventName}
    >
      {eventName}
    </span>
  </div>

  <div
    class="countdown-container grid grid-cols-4 gap-3 text-center sm:gap-4 md:gap-5"
    data-target={targetDate}
    role="timer"
    aria-live="off"
    aria-atomic="true"
    aria-label={`Cuenta regresiva para ${eventName}`}
  >
    <div class="text-center mx-auto rounded-xl border border-white/10 bg-white/5 px-2 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] sm:px-3 sm:py-4">
      <div class="days-val font-mono text-2xl font-bold text-text-primary sm:text-4xl">00</div>
      <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.18em] text-text-secondary sm:text-xs">Días</div>
    </div>
    <div class="text-center mx-auto rounded-xl border border-white/10 bg-white/5 px-2 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] sm:px-3 sm:py-4">
      <div class="hours-val font-mono text-2xl font-bold text-accent-cyan sm:text-4xl">00</div>
      <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.18em] text-text-secondary sm:text-xs">Horas</div>
    </div>
    <div class="text-center mx-auto rounded-xl border border-white/10 bg-white/5 px-2 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] sm:px-3 sm:py-4">
      <div class="mins-val font-mono text-2xl font-bold text-text-primary sm:text-4xl">00</div>
      <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.18em] text-text-secondary sm:text-xs">Min</div>
    </div>
    <div class="text-center mx-auto rounded-xl border border-white/10 bg-white/5 px-2 py-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)] sm:px-3 sm:py-4">
      <div class="secs-val font-mono text-2xl font-bold text-accent-purple sm:text-4xl">00</div>
      <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.18em] text-text-secondary sm:text-xs">Seg</div>
    </div>
  </div>
</div>

<script>
  function initCountdowns() {
    const containers = document.querySelectorAll<HTMLElement>('.countdown-container');

    containers.forEach((container) => {
      if (container.dataset.initialized === 'true') return;

      const targetStr = container.getAttribute('data-target');
      if (!targetStr) return;

      const target = new Date(targetStr).getTime();
      if (Number.isNaN(target)) return;

      const daysEl = container.querySelector('.days-val');
      const hoursEl = container.querySelector('.hours-val');
      const minsEl = container.querySelector('.mins-val');
      const secsEl = container.querySelector('.secs-val');

      function update() {
        const now = new Date().getTime();
        const diff = target - now;

        if (diff <= 0) {
          if (daysEl) daysEl.textContent = '00';
          if (hoursEl) hoursEl.textContent = '00';
          if (minsEl) minsEl.textContent = '00';
          if (secsEl) secsEl.textContent = '00';
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secs = Math.floor((diff % (1000 * 60)) / 1000);

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(secs).padStart(2, '0');
      }

      container.dataset.initialized = 'true';
      update();
      const intervalId = window.setInterval(() => {
        if (document.hidden) return;
        update();
        if (new Date(targetStr).getTime() - Date.now() <= 0) {
          window.clearInterval(intervalId);
          container.dataset.initialized = 'false';
        }
      }, 1000);
      container.dataset.intervalId = String(intervalId);
    });
  }

  function clearCountdowns() {
    document.querySelectorAll<HTMLElement>('.countdown-container').forEach((c) => {
      const id = c.dataset.intervalId;
      if (id) window.clearInterval(Number(id));
      c.dataset.initialized = 'false';
    });
  }

  initCountdowns();
  document.addEventListener('astro:page-load', initCountdowns);
  document.addEventListener('astro:before-swap', clearCountdowns);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      document.querySelectorAll<HTMLElement>('.countdown-container').forEach((c) => {
        const id = c.dataset.intervalId;
        if (id) window.clearInterval(Number(id));
      });
    } else {
      document.querySelectorAll<HTMLElement>('.countdown-container').forEach((c) => { c.dataset.initialized = 'false'; });
      initCountdowns();
    }
  });
</script>
