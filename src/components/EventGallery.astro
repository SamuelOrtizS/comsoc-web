---
import { Image } from 'astro:assets';
import { getImageModule } from '../utils/imageImports';

interface Props {
  galeria: string[];
}

const { galeria } = Astro.props;

// Resolve gallery images - handle both remote URLs and local paths
const galeriaImages = galeria 
  ? galeria.map(path => {
      // Check if it's a remote URL
      if (path.startsWith('http://') || path.startsWith('https://')) {
        return { type: 'remote' as const, src: path };
      }
      // Otherwise try to resolve as local image
      const localImage = getImageModule(path);
      return { 
        type: localImage ? 'local' as const : 'public' as const, 
        src: localImage || `/images/${path}` 
      };
    })
  : [];
---

{galeria && galeria.length > 0 && (
  <section class="glass-card rounded-2xl p-6 sm:p-8 border border-white/10">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h2 class="text-xl font-bold text-text-primary font-mono">Galería &amp; Recursos</h2>
      <span class="text-[10px] uppercase tracking-[0.18em] text-text-secondary font-mono">
        {galeria.length} fotos
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {galeriaImages.map((img, idx) => (
        <div class="group overflow-hidden rounded-2xl border border-white/10 bg-bg-secondary aspect-video">
          {img.type === 'remote' ? (
            // Remote URL - use regular img tag
            <img
              src={img.src}
              alt={`Foto ${idx + 1}`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          ) : (
            // Local image or public file - use Image component if available
            <Image
              src={img.src}
              alt={`Foto ${idx + 1}`}
              width={800}
              height={450}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          )}
        </div>
      ))}
    </div>
  </section>
)}
