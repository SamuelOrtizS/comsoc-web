---
import { Icon } from 'astro-icon/components';

interface Destiny {
  title: string;
  desc: string;
  icon: string;
  tone: string;
}

interface Props {
  destinies?: Destiny[];
}

const defaultDestinies: Destiny[] = [
  {
    title: 'Equipamiento de Laboratorio',
    desc: 'Adquisición de microcontroladores, sensores IoT, kits de fibra óptica, SDRs y componentes electrónicos para el desarrollo de proyectos técnicos.',
    icon: 'material-symbols:science',
    tone: 'border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan',
  },
  {
    title: 'Talleres y Conferencias',
    desc: 'Financiamiento de plataformas, materiales pedagógicos y viáticos para ponentes en nuestros workshops y webinars técnicos gratuitos.',
    icon: 'material-symbols:school-rounded',
    tone: 'border-accent-purple/30 bg-accent-purple/10 text-accent-purple',
  },
  {
    title: 'Participación en Eventos',
    desc: 'Apoyo económico para el traslado e inscripción de nuestros miembros destacados en competencias nacionales e internacionales de IEEE.',
    icon: 'material-symbols:groups-rounded',
    tone: 'border-accent-blue/30 bg-accent-blue/10 text-accent-blue',
  },
  {
    title: 'Operación del Capítulo',
    desc: 'Sostenimiento de infraestructura digital, licencias de software, hosting y materiales de difusión para el correcto funcionamiento administrativo.',
    icon: 'material-symbols:settings-rounded',
    tone: 'border-accent-emerald/30 bg-accent-emerald/10 text-accent-emerald',
  },
];

const { destinies = defaultDestinies } = Astro.props;
---

<div
  class="destinies-container lg:col-span-7 flex flex-col justify-between rounded-[28px] border border-white/10 bg-[linear-gradient(180deg,rgba(9,13,27,0.52),rgba(3,5,14,0.72))] p-6 shadow-[0_20px_80px_-40px_rgba(69,219,237,0.35)] backdrop-blur-sm sm:p-8"
>
  <div class="mb-7 text-center destinies-header">
    <h2 class="mb-3 text-2xl font-bold text-text-primary sm:text-3xl">¿A qué se destinan los fondos?</h2>
    <p class="mx-auto max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base font-light text-justify">
      Como capítulo estudiantil de la Sociedad de Comunicaciones de IEEE, dependemos del apoyo de la comunidad,
      patrocinadores y egresados para continuar brindando educación extracurricular de alto nivel y desarrollar
      proyectos que impacten a la sociedad.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {destinies.map((dest, index) => (
      <div
        class="destiny-card rounded-2xl border border-white/10 bg-white/3 p-5 transition duration-300 hover:border-accent-cyan/30 hover:bg-white/5 hover:-translate-y-1"
        style={`--dest-index: ${index};`}
      >
        <div class={`mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl border ${dest.tone} transition-transform duration-300 hover:scale-110`}>
          <Icon name={dest.icon} class="w-6 h-6" aria-hidden="true" />
        </div>
        <h3 class="mb-2 text-base font-semibold text-text-primary">{dest.title}</h3>
        <p class="text-sm leading-relaxed text-text-secondary font-light text-justify">{dest.desc}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .destinies-header,
  .destiny-card {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .destinies-header.is-visible {
      animation: destHeaderIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .destiny-card.is-visible {
      animation: destCardIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(var(--dest-index, 0) * 80ms + 100ms);
    }

    @keyframes destHeaderIn {
      from { opacity: 0; transform: translateY(18px); filter: blur(4px); }
      to { opacity: 1; transform: translateY(0); filter: blur(0); }
    }
    @keyframes destCardIn {
      from { opacity: 0; transform: translateY(24px); filter: blur(4px); }
      to { opacity: 1; transform: translateY(0); filter: blur(0); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .destinies-header,
    .destiny-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  function setupDestiniesObserver() {
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const items = document.querySelectorAll('.destinies-container .destinies-header, .destinies-container .destiny-card');

    if (!motionOK) {
      items.forEach(el => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    items.forEach(el => observer.observe(el));
  }

  setupDestiniesObserver();
  document.addEventListener('astro:after-swap', setupDestiniesObserver);
</script>

