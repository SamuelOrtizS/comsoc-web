---
import { Icon } from 'astro-icon/components';

interface Faq {
  q: string;
  a: string;
}

interface Props {
  faqs?: Faq[];
  title?: string;
  badge?: string;
}

const defaultFaqs: Faq[] = [
  {
    q: '¿Necesito ser estudiante de Ingeniería Electrónica o Sistemas para unirme a ComSoc?',
    a: '¡No! En nuestro capítulo creemos en la interdisciplinariedad. Aunque gran parte de nuestras actividades se enfocan en telecomunicaciones, redes y desarrollo, cualquier estudiante apasionado por la tecnología, diseño, gestión de proyectos o marketing es bienvenido a participar como colaborador.',
  },
  {
    q: '¿Es obligatorio tener membresía de IEEE para participar en el capítulo?',
    a: '¡Para nada! Puedes participar activamente en proyectos técnicos, talleres, grupos de estudio y logística sin costo ni membresía formal. La membresía oficial de IEEE ComSoc te otorga beneficios globales adicionales (certificados internacionales, descuentos en congresos y acceso a IEEE Xplore), pero la motivación y el trabajo en equipo es lo fundamental.',
  },
  {
    q: '¿Qué beneficios obtengo al adquirir la membresía oficial de IEEE ComSoc?',
    a: 'Obtienes acceso ilimitado a la biblioteca digital IEEE Xplore, suscripción a la revista IEEE Communications Magazine, tarifas reducidas en congresos mundiales (IEEE GLOBECOM, ICC), postulación a becas y premios internacionales.',
  },
  {
    q: '¿Cómo puedo postularme a las convocatorias de la Junta Directiva o comités?',
    a: 'Periódicamente abrimos convocatorias públicas para roles directivos, técnicos y de apoyo. Puedes revisar las vacantes vigentes en nuestra sección de Convocatorias o estar atento a los anuncios en nuestra comunidad de WhatsApp.',
  },
  {
    q: '¿Cuánto tiempo a la semana debo dedicar si me uno a un proyecto?',
    a: 'Generalmente entre 2 y 5 horas semanales, según el rol y cronograma del equipo. Tenemos total flexibilidad reconociendo la prioridad de tus responsabilidades y horarios académicos.',
  },
  {
    q: '¿Cómo puedo ponerme en contacto con el equipo?',
    a: 'La forma más directa es unirte a nuestra comunidad general de WhatsApp a través del enlace en esta página o escribirnos mediante nuestras redes sociales y correo oficial.',
  },
  {
    q: '¿Cómo se entregan los pedidos o souvenirs de la tienda oficial?',
    a: 'Realizamos entregas presenciales sin costo dentro del Campus Meléndez y San Fernando de la Universidad del Valle. Para envíos a otras ciudades o fuera del campus, coordinamos la entrega por mensajería a través de WhatsApp.',
  },
];

const { faqs = defaultFaqs, title = 'Preguntas frecuentes', badge = 'Dudas frecuentes' } = Astro.props;
---

<section class="mx-auto mt-24 max-w-4xl px-4 sm:px-6 lg:px-8">
  <div class="mx-auto mb-10 max-w-3xl text-center">
    <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-accent-purple/20 bg-accent-purple/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-purple font-mono">
      {badge}
    </div>
    <h2 class="text-3xl font-bold tracking-[-0.03em] text-text-primary sm:text-4xl">{title}</h2>
  </div>

  <div class="space-y-4">
    {faqs.map((faq) => (
      <details class="glass-card group rounded-2xl border border-white/10 p-5 transition-colors">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text-primary text-base sm:text-lg">
          <span>{faq.q}</span>
          <Icon
            name="material-symbols:keyboard-arrow-down-rounded"
            class="h-5 w-5 shrink-0 text-text-secondary transition-transform duration-200 group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <p class="mt-4 border-t border-white/10 pt-4 text-sm leading-relaxed text-text-secondary font-light sm:text-base text-justify">
          {faq.a}
        </p>
      </details>
    ))}
  </div>
</section>
