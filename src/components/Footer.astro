---
const currentYear = new Date().getFullYear();

const navSections = [
  {
    title: 'Navegación',
    links: [
      { name: 'Inicio', href: '/comsoc-web/' },
      { name: 'Nosotros', href: '/comsoc-web/nosotros' },
      { name: 'Eventos', href: '/comsoc-web/eventos' },
      { name: 'Convocatorias', href: '/comsoc-web/convocatorias' },
      { name: 'Tienda', href: '/comsoc-web/tienda' },
    ],
  },
  {
    title: 'Recursos IEEE',
    links: [
      { name: 'IEEE Global', href: 'https://www.ieee.org', external: true },
      { name: 'IEEE ComSoc Global', href: 'https://www.comsoc.org', external: true },
      { name: 'IEEE Xplore Digital Library', href: 'https://ieeexplore.ieee.org', external: true },
      { name: 'IEEE Sección Perú', href: 'https://ieee.org.pe', external: true },
    ],
  },
];
---

<footer class="bg-[#050816] border-t border-white/10 mt-20 pt-16 pb-12 relative overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-32 bg-gradient-to-t from-[#155dfc]/10 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand & Info -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="inline-block">
          <img src="/images/logo-comsoc.svg" alt="IEEE ComSoc" class="h-10 w-auto" />
        </a>
        <p class="text-gray-400 text-sm max-w-md leading-relaxed font-light">
          ComSoc Student Chapter. Impulsamos el desarrollo profesional, técnico y académico en comunicaciones digitales, redes de nueva generación, IoT y ciberseguridad.
        </p>
        
        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-[#22d3ee] hover:border-[#22d3ee]/50 transition"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 0 0-1.64 1.64c0 .9.73 1.64 1.64 1.64s1.64-.74 1.64-1.64c0-.9-.74-1.64-1.64-1.64Z"/>
            </svg>
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-[#22d3ee] hover:border-[#22d3ee]/50 transition"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://chat.whatsapp.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-[#22d3ee] hover:border-[#22d3ee]/50 transition"
            aria-label="WhatsApp"
          >
            <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24M8.53 7.33c-.2 0-.43.08-.66.33-.23.26-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.76 2.69 4.26 3.77.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.69-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.3s-1.48-.73-1.71-.81c-.23-.08-.4-.12-.57.12-.17.25-.66.81-.81.98-.15.17-.3.19-.55.07-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.37-.78-1.88-.2-.5-.41-.43-.57-.44h-.49Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links Grid -->
      {navSections.map((section) => (
        <div>
          <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4 font-mono">
            {section.title}
          </h3>
          <ul class="space-y-2.5 text-sm">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-gray-400 hover:text-[#22d3ee] transition-colors font-light"
                >
                  {link.name}
                  {link.external && <span class="text-xs opacity-60 ml-1">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-4 font-light">
      <p>© {currentYear} IEEE ComSoc Student Chapter. Todos los derechos reservados.</p>
      <p class="font-mono text-gray-400">Diseñado con Astro + Tailwind CSS v4</p>
    </div>
  </div>
</footer>
