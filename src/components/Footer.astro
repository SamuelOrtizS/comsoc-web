---
const currentYear = new Date().getFullYear();

const navSections = [
  {
    title: 'Navegación',
    links: [
      { name: 'Inicio', href: '/', external: false },
      { name: 'Nosotros', href: '/nosotros', external: false },
      { name: 'Eventos', href: '/eventos', external: false },
      { name: 'Proyectos', href: '/proyectos', external: false },
      { name: 'Convocatorias', href: '/convocatorias', external: false },
      { name: 'Tienda', href: '/tienda', external: false },
      { name: 'Donaciones', href: '/donaciones', external: false },
      { name: 'Unirse', href: '/unirse', external: false },
    ],
  },
  {
    title: 'Recursos IEEE',
    links: [
      { name: 'IEEE Global', href: 'https://www.ieee.org', external: true },
      { name: 'IEEE ComSoc Global', href: 'https://www.comsoc.org', external: true },
      { name: 'IEEE Xplore Digital Library', href: 'https://ieeexplore.ieee.org', external: true },
      { name: 'IEEE Sección Colombia', href: 'https://ieee.org.co', external: true },
      { name: 'SAC Team IEEE Sección Colombia', href: 'https://sac.ieee.org.co', external: true },
    ],
  },
];
---

<footer class="w-full bg-bg-primary border-t border-white/10 mt-20 pt-16 pb-12 relative overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-32 bg-linear-to-t from-accent-blue/10 to-transparent pointer-events-none"></div>

  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand & Info -->
      <div class="md:col-span-2 space-y-4 pt-8">
        <a href="/" class="inline-flex items-center">
          <img src="/images/logo-comsoc.svg" alt="IEEE ComSoc" loading="lazy" decoding="async" class="h-20 w-auto transition-transform duration-500 hover:scale-105 active:scale-95" />
        </a>
        <p class="text-text-secondary text-sm max-w-md leading-relaxed font-light">
          <p class="text-text-secondary text-base sm:text-lg max-w-md leading-relaxed font-light tracking-tight">
          ComSoc Student Chapter. Impulsamos el desarrollo profesional, técnico y académico en comunicaciones digitales, redes de nueva generación, IoT y ciberseguridad.
          </p>
        </p>
        
        <!-- Social Icons -->
        <div class="flex items-center gap-4 pt-6 pb-2">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-text-primary hover:text-accent-cyan hover:border-accent-cyan/60 hover:bg-white/15 transition-all shadow-sm group"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 fill-white group-hover:fill-accent-cyan transition-colors" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://chat.whatsapp.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-text-primary hover:text-accent-cyan hover:border-accent-cyan/60 hover:bg-white/15 transition-all duration-300 shadow-sm group" aria-label="WhatsApp">
            <svg class="w-5 h-5 fill-white group-hover:fill-accent-cyan transition-colors" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24M8.53 7.33c-.2 0-.43.08-.66.33-.23.26-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.76 2.69 4.26 3.77.6.26 1.06.41 1.42.53.6.19 1.15.16 1.58.1.48-.07 1.48-.6 1.69-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.3s-1.48-.73-1.71-.81c-.23-.08-.4-.12-.57.12-.17.25-.66.81-.81.98-.15.17-.3.19-.55.07-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.37-.78-1.88-.2-.5-.41-.43-.57-.44h-.49Z"/>
            </svg>
          </a>
          <a
            href="mailto:contacto@comsoc.ieeeunivalle.link"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-text-primary hover:text-accent-cyan hover:border-accent-cyan/60 hover:bg-white/15 transition-all duration-300 shadow-sm group" aria-label="WhatsApp">
            M
          </a>
        </div>
      </div>

      <!-- Links Grid -->
      {navSections.map((section, sectionIndex) => (
        <div class="group">
          <h3 class="text-sm font-semibold text-text-primary tracking-widest uppercase mb-4 font-mono">
            {section.title}
            <span class="inline-block w-2 h-1 rounded-full bg-accent-cyan ml-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
          </h3>
          <ul class="space-y-2.5 text-sm">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                    class="text-accent-cyan text-sm hover:text-text-primary transition-all duration-300 font-light hover:underline underline-offset-4 group-hover:underline-offset-2">
                  {link.name}
                  {link.external && <span class="text-xs opacity-60 ml-1">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-text-secondary gap-4 font-light">
       <p class="text-text-secondary font-mono text-xs">© {currentYear} IEEE ComSoc Universidad del Valle Student Branch Chapter. Todos los derechos reservados.</p>
       <p class="text-text-secondary font-mono text-xs">Diseñado por: Samuel Ortiz, Cristhian Moreno</p>
    </div>
  </div>
</footer>
