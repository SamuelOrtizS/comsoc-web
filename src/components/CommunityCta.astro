---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = '¿Listo para liderar el futuro de las telecomunicaciones?',
  description = 'Conéctate con mentores de la industria, accede a recursos globales de IEEE, organiza congresos internacionales y potencia tu carrera profesional.',
} = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 animate-in fade-in slide-in-from-bottom-8 duration-700 delay-900">
  <div class="relative overflow-hidden rounded-[30px] border border-accent-purple/20 bg-gradient-to-br from-bg-deep-slate to-bg-deep-slate-lighter p-8 sm:p-12 text-center shadow-[0_35px_90px_-48px_rgba(34,211,238,0.5)] group">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.08),transparent_45%)] transition-opacity duration-500 group-hover:opacity-100"></div>
    <div class="relative z-10 mx-auto max-w-2xl space-y-6">
      <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-accent-cyan font-mono transition-colors duration-300 group-hover:text-accent-blue-lighter">
        Únete a la comunidad
      </div>
      <h2 class="text-3xl font-black tracking-[-0.04em] text-text-primary sm:text-4xl animate-in fade-in slide-in-from-bottom-4 duration-500 delay-100">
        {title}
      </h2>
      <p class="text-sm leading-relaxed text-text-secondary sm:text-base font-light transition-colors duration-300 group-hover:text-text-primary">
        {description}
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a
          href="/convocatorias"
          aria-label="Ver convocatorias abiertas para unir al equipo"
          class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-accent-blue-lighter to-accent-blue-darker px-8 py-3.5 text-sm font-semibold text-slate-950 shadow-[0_18px_40px_-18px_rgba(21,93,252,0.9)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_52px_-20px_rgba(34,211,238,0.9)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan group-hover:-translate-y-0.5"
        >
          <span class="transition-transform duration-300 group-hover:scale-105">Ver Convocatorias Abiertas</span>
        </a>
        <a
          href="/nosotros"
          aria-label="Conocer más sobre IEEE ComSoc Univalle"
          class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-8 py-3.5 text-sm font-semibold text-text-secondary transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 hover:bg-white/10 hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan group-hover:-translate-y-0.5"
        >
          Conoce Más Sobre Nosotros
        </a>
      </div>
    </div>
  </div>
</section>
