---
import MobileMenu from './MobileMenu.astro';

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Eventos', href: '/eventos' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Convocatorias', href: '/convocatorias' },
  { name: 'Tienda', href: '/tienda' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40 bg-[#050816]/70 backdrop-blur-xl border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative flex items-center">
          <img
            src="/images/logo-comsoc.svg"
            alt="IEEE ComSoc Logo"
            class="h-10 sm:h-11 w-auto transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'text-[#22d3ee] bg-white/5 shadow-inner'
                  : 'text-gray-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- CTA Button & Mobile Trigger -->
      <div class="flex items-center gap-4">
        <a
          href="/convocatorias"
          class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-sm font-semibold rounded-xl bg-gradient-to-r from-[#155dfc] to-[#22d3ee] text-white hover:opacity-95 shadow-md shadow-blue-500/20 transition-all hover:scale-[1.02]"
        >
          Unirse
        </a>

        <!-- Hamburger Icon -->
        <button
          id="open-mobile-menu"
          type="button"
          class="md:hidden p-2.5 rounded-xl bg-white/5 border border-white/10 text-gray-300 hover:text-white hover:bg-white/10 transition"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <MobileMenu />
</header>
