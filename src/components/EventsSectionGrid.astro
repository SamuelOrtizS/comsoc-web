---
import { Icon } from 'astro-icon/components';
import EventCard from './EventCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  events: CollectionEntry<'eventos'>[];
  emptyMessage: string;
  isUpcoming?: boolean;
}

const { title, events, emptyMessage, isUpcoming = false } = Astro.props;
---

<section class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="inline-flex items-center gap-3">
      {isUpcoming ? (
        <span class="h-3 w-3 rounded-full bg-accent-cyan shadow-[0_0_20px_rgba(34,211,238,0.85)]"></span>
      ) : (
        <Icon name="material-symbols:inventory-2-rounded" class="w-6 h-6 text-text-secondary" aria-hidden="true" />
      )}
      <h2 class="text-2xl sm:text-3xl font-bold text-text-primary">{title}</h2>
    </div>
    <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-mono ${isUpcoming ? 'bg-accent-cyan/10 border border-accent-cyan/30 text-accent-cyan' : 'bg-white/5 border border-white/10 text-text-secondary'}`}>
      <span>{events.length}</span>
      <span>{isUpcoming ? 'actividades' : 'registros'}</span>
    </div>
  </div>

  {events.length === 0 ? (
    isUpcoming ? (
      <div class="glass-card rounded-3xl p-10 sm:p-12 text-center border border-white/10 max-w-2xl mx-auto shadow-[0_20px_60px_rgba(15,23,42,0.2)]">
        <div class="flex justify-center mb-4 text-accent-cyan">
          <Icon name="material-symbols:calendar-today-rounded" class="w-12 h-12" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-bold text-text-primary mb-2">No hay eventos programados en este momento</h3>
        <p class="text-sm sm:text-base text-text-secondary font-light leading-relaxed">{emptyMessage}</p>
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-white/15 bg-white/2 px-6 py-10 text-sm text-text-secondary text-center">
        {emptyMessage}
      </div>
    )
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
      {events.map((ev) => (
        <EventCard
          id={ev.id}
          titulo={ev.data.titulo}
          tipo={ev.data.tipo}
          organizador={ev.data.organizador}
          fechaInicio={ev.data.fechaInicio}
          horaInicio={ev.data.horaInicio}
          lugarNombre={ev.data.lugarNombre}
          descripcion={ev.data.descripcion}
          imagenPrincipal={ev.data.imagenPrincipal}
          estado={ev.data.estado}
        />
      ))}
    </div>
  )}
</section>
