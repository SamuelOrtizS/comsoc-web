---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { formatUSD, formatCOP } from '../utils/currency';
import { getImageModule } from '../utils/imageImports';
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  currentRate?: number;
}

const { proyecto, currentRate = 4000 } = Astro.props;
const data = proyecto.data;
const isRemoteProjectImage = typeof data.imagen === 'string' && (data.imagen.startsWith('http://') || data.imagen.startsWith('https://'));
const resolvedProjectImage = getImageModule(data.imagen);

const estadoStyle: Record<string, { badge: string; icon: string; hoverBorder: string; hoverShadow: string }> = {
  Activo: {
    badge: 'text-emerald-300 border-emerald-400/30',
    icon: 'material-symbols:check-circle-rounded',
    hoverBorder: 'hover:border-accent-emerald/40',
    hoverShadow: 'hover:shadow-[0_24px_60px_rgba(52,211,153,0.12)]',
  },
  Completado: {
    badge: 'text-accent-blue border-accent-blue/30',
    icon: 'material-symbols:verified-rounded',
    hoverBorder: 'hover:border-accent-blue/40',
    hoverShadow: 'hover:shadow-[0_24px_60px_rgba(21,93,252,0.12)]',
  },
  'En Pausa': {
    badge: 'text-accent-yellow border-accent-yellow/30',
    icon: 'material-symbols:pause-circle-rounded',
    hoverBorder: 'hover:border-accent-yellow/40',
    hoverShadow: 'hover:shadow-[0_24px_60px_rgba(250,204,21,0.12)]',
  },
};

const style = estadoStyle[data.estado] ?? estadoStyle['Activo'];

const fundingPercent = (actual?: number, meta?: number) => {
  if (typeof actual !== 'number' || typeof meta !== 'number' || meta <= 0) return 0;
  return Math.min(100, (actual / meta) * 100);
};
---

<a
  href={`/proyectos/${proyecto.id}`}
  class={`group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-bg-secondary/80 shadow-[0_18px_45px_rgba(15,23,42,0.38)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 ${style.hoverBorder} ${style.hoverShadow}`}
>
  <div class="relative aspect-video overflow-hidden bg-bg-secondary">
    {isRemoteProjectImage ? (
      <img
        src={data.imagen}
        alt={data.titulo}
        loading="lazy"
        decoding="async"
        class={`h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 ${data.estado === 'Completado' ? 'opacity-80' : ''} ${data.estado === 'En Pausa' ? 'opacity-60 grayscale-[30%]' : ''}`}
      />
    ) : resolvedProjectImage ? (
      <Image
        src={resolvedProjectImage}
        alt={data.titulo}
        width={800}
        height={450}
        loading="lazy"
        decoding="async"
        class={`h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 ${data.estado === 'Completado' ? 'opacity-80' : ''} ${data.estado === 'En Pausa' ? 'opacity-60 grayscale-[30%]' : ''}`}
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent-purple/15 via-bg-secondary to-accent-blue/15 text-xs font-mono uppercase tracking-[0.2em] text-text-secondary">
        Proyecto
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/25 to-transparent"></div>
    <div class="absolute left-3 top-3 flex flex-wrap gap-2">
      <span class="rounded-full border border-accent-purple/30 bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] text-accent-purple backdrop-blur-md">
        {data.categoria}
      </span>
      <span class={`inline-flex items-center gap-1.5 rounded-full border bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] backdrop-blur-md ${style.badge}`}>
        <Icon name={style.icon} class="w-3.5 h-3.5" aria-hidden="true" />
        {data.estado}
      </span>
    </div>
  </div>

  <div class="flex grow flex-col p-6">
    <h3 class="mb-2 line-clamp-2 text-lg font-bold text-text-primary transition-colors duration-300 group-hover:text-accent-cyan">
      {data.titulo}
    </h3>
    <p class="mb-4 grow text-sm leading-relaxed text-text-secondary">
      {data.descripcion}
    </p>

    {data.montoActual !== undefined && data.montoMeta !== undefined && (
      <div class="mb-4 space-y-2 rounded-2xl border border-white/10 bg-white/5 p-3.5">
        <div class="flex items-baseline justify-between gap-2 text-[11px] font-mono">
          <span class="text-text-secondary">Financiación (USD)</span>
          <span class="font-semibold text-accent-cyan">{formatUSD(data.montoActual)} / {formatUSD(data.montoMeta)}</span>
        </div>

        <div class="flex items-baseline justify-between gap-2 text-[10px] font-mono text-text-secondary">
          <span>En COP</span>
          <span class="font-semibold text-accent-emerald">{formatCOP(data.montoActual, currentRate)} / {formatCOP(data.montoMeta, currentRate)}</span>
        </div>

        <div class="relative mt-1 h-2.5 overflow-hidden rounded-full border border-white/10 bg-white/5">
          <div
            class="h-full rounded-full bg-gradient-to-r from-accent-blue-lighter via-accent-cyan to-accent-emerald-darker transition-all duration-500"
            style={`width: ${fundingPercent(data.montoActual, data.montoMeta)}%`}
            aria-label="Progreso de financiamiento"
          ></div>
        </div>

        <div class="text-right text-[10px] font-mono text-text-secondary">
          {Math.round(fundingPercent(data.montoActual, data.montoMeta))}% Completado
        </div>
      </div>
    )}

    {data.tags && data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {data.tags.map((tag) => (
          <span class="rounded border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] font-mono text-text-secondary">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
