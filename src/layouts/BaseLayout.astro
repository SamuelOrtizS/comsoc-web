---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import TouchRipple from '../components/TouchRipple.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "IEEE ComSoc | Student Chapter",
  description = "Capítulo Estudiantil de la Sociedad de Comunicaciones de IEEE. Fomentando la innovación en telecomunicaciones, redes 5G/6G, IoT y tecnologías conectadas.",
  image = "/images/logo-comsoc.svg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#050816] text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,300..800;1,6..12,300..800&family=Share+Tech+Mono&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7Q9FC7KE7Y"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-7Q9FC7KE7Y');
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#050816] text-[#ffffff] selection:bg-[#155dfc] selection:text-white relative overflow-x-hidden font-sans">
    <!-- Background glow ambient effects (optimized GPU layers) -->
    <div class="fixed top-0 left-1/4 -z-10 w-[500px] h-[350px] bg-[#155dfc]/10 rounded-full blur-[90px] pointer-events-none transform-gpu"></div>
    <div class="fixed bottom-1/4 right-10 -z-10 w-[450px] h-[350px] bg-[#22d3ee]/10 rounded-full blur-[100px] pointer-events-none transform-gpu"></div>
    <div class="fixed top-1/2 left-10 -z-10 w-[350px] h-[250px] bg-[#a855f7]/10 rounded-full blur-[90px] pointer-events-none transform-gpu"></div>

    <Header />

    <main class="flex-grow pt-20">
      <slot />
    </main>

    <Footer />
    <CustomCursor />
    <TouchRipple />
    <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "e239d35fe7434d2c91eea3c5cb11327e"}'></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>
