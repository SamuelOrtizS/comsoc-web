---
import { Icon } from 'astro-icon/components';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "IEEE ComSoc Univalle |",
  description = "Capítulo Estudiantil de la Sociedad de Comunicaciones de IEEE. Fomentando la innovación en telecomunicaciones, redes 5G/6G, IoT y tecnologías conectadas.",
  image = "/images/logo-comsoc.svg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');
const ogImageURL = new URL(image, Astro.site || 'http://localhost:4321').toString();
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-bg-primary text-text-primary">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <meta name="theme-color" content="#050816" />

    <!-- Astro Fonts (gestionadas automáticamente) -->
    <Font cssVariable="--font-formata" preload />
    <Font cssVariable="--font-nunito-sans" preload />
    <Font cssVariable="--font-share-tech-mono" />
    <Font cssVariable="--font-space-grotesk" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7Q9FC7KE7Y"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-7Q9FC7KE7Y');
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-bg-primary text-text-primary selection:bg-accent-blue selection:text-text-primary relative overflow-x-hidden font-sans antialiased bg-dot-grid">
    <Header />

    <!-- Development Banner (no bloqueante) -->
    <div
      id="development-banner"
      role="status"
      aria-live="polite"
      aria-label="Aviso de versión de desarrollo"
      class="sticky top-22 z-30 mx-4 sm:mx-6 lg:mx-8 mt-2 hidden border border-accent-amber/30 from-accent-amber-lighter/10 to-accent-amber-darker/5 bg-linear-to-br rounded-2xl backdrop-blur-md"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl from-accent-amber-lighter to-accent-amber-darker bg-linear-to-br text-text-primary shrink-0">
            <Icon name="material-symbols:construction-rounded" class="w-5 h-5" aria-hidden="true" />
          </span>
          <div class="min-w-0">
            <p class="text-[11px] font-mono font-semibold tracking-[0.14em] uppercase text-accent-amber flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-linear-to-br from-accent-amber-lighter to-accent-amber-darker animate-pulse"></span>
              Versión de desarrollo — Sincronizando infraestructura
            </p>
            <p class="text-xs text-text-secondary font-light leading-tight truncate sm:whitespace-normal">
              Propuesta técnica preliminar sujeta a revisión de junta directiva. <span class="hidden sm:inline">Status: System Initializing</span>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            href="https://www.instagram.com/ieee.comsoc.univalle/"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-accent-purple/30 from-accent-purple to-accent-purple-darker bg-linear-to-br text-text-primary hover:from-accent-purple-lighter hover:to-accent-purple hover:bg-linear-to-br hover:border-accent-purple/40 text-xs font-medium transition"
          >
            <Icon name="mdi:instagram" class="w-4 h-4" aria-hidden="true" />
            Síguenos
          </a>
          <button
            type="button"
            data-dismiss-banner
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl from-accent-amber to-accent-amber-darker bg-linear-to-br text-text-primary text-xs font-bold hover:from-accent-amber-lighter hover:to-accent-amber border border-accent-amber/30 hover:border-accent-amber/40 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-amber"
            aria-label="Cerrar aviso"
          >
            <Icon name="material-symbols:close-rounded" class="w-3.5 h-3.5" aria-hidden="true" />
            Entendido
          </button>
        </div>
      </div>
    </div>

    <main class="grow pt-20 ">
      <slot />
    </main>

    <Footer />
    <CustomCursor />

    <script is:inline>
      (() => {
        const banner = document.getElementById('development-banner');
        if (!banner) return;
        const KEY = 'comsoc-development-banner-dismissed';
        // Solo mostrar si no está en ?preview y no fue descartado
        const isPreview = new URLSearchParams(window.location.search).has('preview');
        const shouldShow = !localStorage.getItem(KEY) && !isPreview;
        if (!shouldShow) {
          banner.classList.add('hidden');
          return;
        }
        banner.classList.remove('hidden');
        const dismissBtn = banner.querySelector('[data-dismiss-banner]');
        const close = () => {
          banner.classList.add('hidden');
          localStorage.setItem(KEY, 'true');
        };
        dismissBtn?.addEventListener('click', close);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      })();
    </script>
  </body>
</html>

