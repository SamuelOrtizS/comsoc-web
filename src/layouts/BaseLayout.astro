---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import DevelopmentBanner from '../components/DevelopmentBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | { src: string };
}

const {
  title = "IEEE ComSoc Univalle |",
  description = "Capítulo Estudiantil de la Sociedad de Comunicaciones de IEEE. Fomentando la innovación en telecomunicaciones, redes 5G/6G, IoT y tecnologías conectadas.",
  image = "/images/logo-comsoc.svg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');
const normalizedImage = typeof image === 'string' ? image : image?.src ?? '/images/logo-comsoc.svg';
const ogImageURL = new URL(normalizedImage, Astro.site || 'http://localhost:4321').toString();
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-bg-primary text-text-primary">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <meta name="theme-color" content="#050816" />

    <!-- Preload critical font (only hero font preloaded, others use font-display: swap) -->
    <Font cssVariable="--font-formata" preload format="woff2" />
    <Font cssVariable="--font-nunito-sans" format="woff2" />
    <Font cssVariable="--font-share-tech-mono" format="woff2" />
    <Font cssVariable="--font-space-grotesk" format="woff2" />

    <!-- Resource Hints -->
    <link rel="preload" href="/images/logo-comsoc.svg" as="image" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7Q9FC7KE7Y"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7Q9FC7KE7Y');
    </script>

    <!-- Real User Monitoring: Web Vitals (LCP, INP, CLS) -->
    <script is:inline>
      if (typeof window !== 'undefined' && window.gtag) {
        function send(name, value) {
          window.gtag('event', name, {
            value: Math.round(value),
            event_category: 'Web Vitals',
            event_label: window.location.pathname,
            non_interaction: true,
          });
        }
        new PerformanceObserver(function(list) {
          for (const entry of list.getEntries()) send('largest-contentful-paint', entry.startTime);
        }).observe({ type: 'largest-contentful-paint', buffered: true });
        new PerformanceObserver(function(list) {
          for (const entry of list.getEntries()) send('interaction-to-next-paint', entry.processingEnd - entry.startTime);
        }).observe({ type: 'first-input', buffered: true });
        new PerformanceObserver(function(list) {
          var cls = 0;
          for (const entry of list.getEntries()) {
            if (!entry.sources) continue;
            for (const source of entry.sources) {
              if (source.node && source.node.nodeType === 1) cls += entry.value;
            }
          }
          send('cumulative-layout-shift', cls);
        }).observe({ type: 'layout-shift', buffered: true });
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-bg-primary text-text-primary selection:bg-accent-blue selection:text-text-primary relative overflow-x-hidden font-sans antialiased bg-dot-grid">
    <Header />
    <DevelopmentBanner />

    <main class="grow pt-20 ">
      <slot />
    </main>

    <Footer />
    <CustomCursor />
  </body>
</html>

