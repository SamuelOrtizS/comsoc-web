---
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';
---

<BaseLayout
  title="IEEE ComSoc Univalle | 404 — Señal Perdida"
  description="La página que buscas no fue encontrada. Vuelve al inicio del Capítulo Estudiantil IEEE ComSoc."
>
  <ErrorPage
    code="404"
    tagline="ERROR::SIGNAL_LOST"
    title="Señal No Encontrada"
    description="La ruta que intentas alcanzar no existe en nuestra red. Es posible que la página haya sido movida, eliminada o que la URL contenga un error."
    color="cyan"
    icon="gateway"
  />

</BaseLayout>
