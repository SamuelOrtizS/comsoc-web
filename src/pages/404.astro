---
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';
---

<BaseLayout
  title="IEEE ComSoc | 404 — Señal Perdida"
  description="La página que buscas no fue encontrada. Vuelve al inicio del Capítulo Estudiantil IEEE ComSoc."
>
  <section class="min-h-[calc(100vh-10rem)] flex items-center justify-center px-4 sm:px-6 lg:px-8 relative overflow-hidden">

    <!-- Decorative animated rings -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" aria-hidden="true">
      <div class="ring-pulse w-[320px] h-[320px] sm:w-[480px] sm:h-[480px] rounded-full border border-cyan-500/10"></div>
      <div class="ring-pulse ring-delay-1 absolute w-[220px] h-[220px] sm:w-[340px] sm:h-[340px] rounded-full border border-blue-500/15"></div>
      <div class="ring-pulse ring-delay-2 absolute w-[120px] h-[120px] sm:w-[200px] sm:h-[200px] rounded-full border border-purple-500/20"></div>
    </div>

    <div class="relative z-10 text-center max-w-xl mx-auto flex flex-col items-center gap-8">

      <!-- Glitch 404 number -->
      <div class="relative select-none">
        <h1 class="text-[8rem] sm:text-[10rem] font-extrabold leading-none tracking-tighter glitch-text" data-text="404">
          <span class="bg-gradient-to-br from-[#155dfc] via-[#22d3ee] to-[#a855f7] bg-clip-text text-transparent">404</span>
        </h1>
      </div>

      <!-- Message -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-300 text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
          ERROR::SIGNAL_LOST
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-white">
          Señal No Encontrada
        </h2>
        <p class="text-gray-400 text-sm sm:text-base font-light leading-relaxed max-w-md mx-auto">
          La ruta que intentas alcanzar no existe en nuestra red. Es posible que la página haya sido movida, eliminada o que la URL contenga un error.
        </p>
      </div>

      <!-- Terminal-style breadcrumb -->
      <div class="glass-card rounded-2xl px-6 py-4 border border-white/10 w-full max-w-sm">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
        </div>
        <code class="text-xs font-mono text-gray-400 block text-left">
          <span class="text-cyan-400">comsoc@network</span>:<span class="text-purple-400">~</span>$ ping <span class="text-red-400" id="error-path"></span><br/>
          <span class="text-red-400">✗ Request timed out — host unreachable</span>
        </code>
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a
          href="/comsoc-web/"
          class="px-7 py-3 rounded-xl font-semibold text-white bg-gradient-to-r from-[#155dfc] to-[#22d3ee] shadow-lg shadow-blue-500/25 hover:scale-[1.02] transition-all duration-200"
        >
          Volver al Inicio
        </a>
        <a
          href="/comsoc-web/nosotros"
          class="px-7 py-3 rounded-xl font-semibold text-gray-300 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all duration-200"
        >
          Sobre Nosotros
        </a>
      </div>

      <!-- Quick links -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs font-mono text-gray-500 pt-2">
        <a href="/comsoc-web/eventos" class="hover:text-cyan-400 transition">Eventos</a>
        <a href="/comsoc-web/proyectos" class="hover:text-cyan-400 transition">Proyectos</a>
        <a href="/comsoc-web/tienda" class="hover:text-cyan-400 transition">Tienda</a>
        <a href="/comsoc-web/convocatorias" class="hover:text-cyan-400 transition">Convocatorias</a>
        <a href="/comsoc-web/donaciones" class="hover:text-cyan-400 transition">Donaciones</a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .glitch-text {
    position: relative;
  }
  .glitch-text::before,
  .glitch-text::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent;
  }
  .glitch-text::before {
    left: 3px;
    text-shadow: -3px 0 #ff00ff;
    clip-path: inset(0 0 65% 0);
    animation: glitch-top 3s infinite linear alternate-reverse;
  }
  .glitch-text::after {
    left: -3px;
    text-shadow: 3px 0 #00ffff;
    clip-path: inset(65% 0 0 0);
    animation: glitch-bottom 2.5s infinite linear alternate-reverse;
  }

  @keyframes glitch-top {
    0%, 90% { clip-path: inset(0 0 65% 0); transform: translate(0); }
    92% { clip-path: inset(10% 0 55% 0); transform: translate(-4px, 2px); }
    94% { clip-path: inset(20% 0 45% 0); transform: translate(4px, -1px); }
    96% { clip-path: inset(5% 0 60% 0); transform: translate(-2px, 1px); }
    98% { clip-path: inset(15% 0 50% 0); transform: translate(3px, -2px); }
    100% { clip-path: inset(0 0 65% 0); transform: translate(0); }
  }

  @keyframes glitch-bottom {
    0%, 90% { clip-path: inset(65% 0 0 0); transform: translate(0); }
    92% { clip-path: inset(55% 0 10% 0); transform: translate(3px, -1px); }
    94% { clip-path: inset(50% 0 15% 0); transform: translate(-3px, 2px); }
    96% { clip-path: inset(60% 0 5% 0); transform: translate(2px, -1px); }
    98% { clip-path: inset(45% 0 20% 0); transform: translate(-4px, 2px); }
    100% { clip-path: inset(65% 0 0 0); transform: translate(0); }
  }

  .ring-pulse {
    animation: ring-expand 4s ease-in-out infinite;
  }
  .ring-delay-1 { animation-delay: 1.2s; }
  .ring-delay-2 { animation-delay: 2.4s; }

  @keyframes ring-expand {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.08); opacity: 1; }
  }
</style>

<script>
  const pathEl = document.getElementById('error-path');
  if (pathEl) {
    pathEl.textContent = window.location.pathname;
  }
</script>
