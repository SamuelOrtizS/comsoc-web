---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import paymentMethods from '../content/donaciones.json';

const destinies = [
  {
    title: 'Equipamiento de Laboratorio',
    desc: 'Adquisición de microcontroladores, sensores IoT, kits de fibra óptica, SDRs y componentes electrónicos para el desarrollo de proyectos técnicos.',
    icon: 'material-symbols:science',
    tone: 'border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan'
  },
  {
    title: 'Talleres y Conferencias',
    desc: 'Financiamiento de plataformas, materiales pedagógicos y viáticos para ponentes en nuestros workshops y webinars técnicos gratuitos.',
    icon: 'material-symbols:school-rounded',
    tone: 'border-accent-purple/30 bg-accent-purple/10 text-accent-purple'
  },
  {
    title: 'Participación en Eventos',
    desc: 'Apoyo económico para el traslado e inscripción de nuestros miembros destacados en competencias nacionales e internacionales de IEEE.',
    icon: 'material-symbols:groups-rounded',
    tone: 'border-accent-blue/30 bg-accent-blue/10 text-accent-blue'
  },
  {
    title: 'Operación del Capítulo',
    desc: 'Sostenimiento de infraestructura digital, licencias de software, hosting y materiales de difusión para el correcto funcionamiento administrativo.',
    icon: 'material-symbols:settings-rounded',
    tone: 'border-accent-emerald/30 bg-accent-emerald/10 text-accent-emerald'
  }
];
---

<BaseLayout
  title="IEEE ComSoc Univalle | Donaciones y Financiamiento"
  description="Apoya al Capítulo Estudiantil IEEE ComSoc. Conoce el destino de los fondos, métodos de pago y cómo apoyar proyectos específicos."
>
  <section class="relative overflow-hidden border-b border-white/10 bg-transparent py-16 sm:py-20">
    <div class="absolute inset-0 opacity-90"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 text-xs font-mono uppercase tracking-[0.22em] text-accent-cyan/80">Financiamiento</p>
        <h1 class="mb-5 text-4xl font-extrabold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
          Impulsa la innovación y la ingeniería
        </h1>
        <p class="mx-auto max-w-2xl text-base font-light leading-relaxed text-text-secondary sm:text-lg">
          Somos una organización sin fines de lucro. El 100% de las donaciones se destina directamente al funcionamiento operativo y académico del capítulo, empoderando a futuros ingenieros.
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl space-y-16 px-4 py-16 sm:px-6 lg:px-8">
    <section class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7 flex flex-col justify-between rounded-[28px] border border-white/10 bg-[linear-gradient(180deg,rgba(9,13,27,0.52),rgba(3,5,14,0.72))] p-6 shadow-[0_20px_80px_-40px_rgba(69,219,237,0.35)] backdrop-blur-sm sm:p-8">
        <div class="mb-7 text-center">
          <h2 class="mb-3 text-2xl font-bold text-text-primary sm:text-3xl">¿A qué se destinan los fondos?</h2>
          <p class="mx-auto max-w-2xl text-sm leading-relaxed text-text-secondary sm:text-base">
            Como capítulo estudiantil de la Sociedad de Comunicaciones de IEEE, dependemos del apoyo de la comunidad, patrocinadores y egresados para continuar brindando educación extracurricular de alto nivel y desarrollar proyectos que impacten a la sociedad.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {destinies.map((dest) => (
            <div class="rounded-2xl border border-white/10 bg-white/3 p-5 transition duration-300 hover:border-accent-cyan/30 hover:bg-white/5">
              <div class={`mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl border ${dest.tone}`}><Icon name={dest.icon} class="w-6 h-6" aria-hidden="true" /></div>
              <h3 class="mb-2 text-base font-semibold text-text-primary">{dest.title}</h3>
              <p class="text-sm leading-relaxed text-text-secondary">{dest.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="relative flex flex-col justify-between overflow-hidden rounded-[28px] border border-accent-purple/25 bg-[linear-gradient(135deg,rgba(168,85,247,0.12),rgba(77,39,104,0.28),rgba(9,13,27,0.72))] p-6 text-text-primary shadow-[0_20px_80px_-30px_rgba(147,51,234,0.4)] sm:p-8 lg:col-span-5">
        <div class="relative z-10 space-y-6">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-accent-purple/30 bg-accent-purple/10 text-2xl text-accent-purple">
            <Icon name="material-symbols:volunteer-activism-rounded" class="h-7 w-7 stroke-current" aria-hidden="true" />
          </div>
          <h3 class="text-2xl font-bold">¿Quieres apoyar un proyecto en específico?</h3>
          <p class="text-sm leading-relaxed text-text-secondary">
            Nuestros miembros desarrollan múltiples proyectos técnicos que requieren financiamiento dedicado. Si deseas que tu donación vaya destinada a una de las iniciativas mostradas en nuestra sección de proyectos (como la estación base LoRaWAN, el simulador de modulaciones, etc.):
          </p>
          <div class="rounded-2xl border border-accent-purple/30 bg-accent-purple/10 p-4 text-xs leading-relaxed font-mono text-text-secondary">
            <strong class="font-semibold text-white">Nota importante:</strong> especifica el nombre del proyecto en la nota o asunto al momento de enviar el dinero, o comunícalo a través de nuestros canales oficiales.
          </div>
          <div class="pt-2">
            <span class="text-[11px] uppercase tracking-[0.18em] text-accent-cyan/70">Medios de contacto</span>
            <div class="mt-3 flex flex-wrap gap-2">
              <a href="mailto:comsoc.univalle@correounivalle.edu.co" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-xs text-text-primary transition hover:bg-white/10">
                comsoc.univalle@correounivalle.edu.co
              </a>
              <a href="/nosotros" class="rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-xs text-text-primary transition hover:bg-white/10">
                Ver directiva
              </a>
            </div>
          </div>
        </div>
        <div class="pointer-events-none absolute -bottom-16 -right-16 h-52 w-52 rounded-full bg-accent-purple/15 blur-3xl"></div>
      </div>
    </section>

    <section class="border-t border-white/10 pt-16">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <h2 class="mb-3 text-3xl font-bold text-text-primary sm:text-4xl">Métodos de Donación</h2>
        <p class="text-base text-text-secondary">
          Elige la opción que más te acomode para realizar tu contribución de forma segura.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {paymentMethods.map((method) => {
          const isPayPal = method.name.toLowerCase().includes('paypal');
          const paypalLink = method.details.find((d) => d.value.startsWith('http'))?.value;
          const copyText = method.details.map((d) => `${d.label}: ${d.value}`).join('\n');

          return (
            <div class="glass-card group flex flex-col justify-between rounded-[24px] border border-white/10 p-6 transition-all duration-300 hover:border-accent-cyan/35">
              <div>
                <div class="mb-4 flex items-center justify-between gap-3">
                  <span class="text-[10px] font-mono uppercase tracking-[0.18em] text-accent-cyan">{method.type}</span>
                  {method.badge && (
                    <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[10px] font-mono text-text-secondary">
                      {method.badge}
                    </span>
                  )}
                </div>
                <h3 class="mb-4 text-xl font-bold text-text-primary font-heading">{method.name}</h3>
                <div class="space-y-3">
                  {method.details.map((detail) => (
                    <div class="flex flex-col border-b border-white/5 pb-2 last:border-b-0 last:pb-0">
                      <span class="text-[10px] uppercase tracking-[0.18em] text-text-secondary font-mono">{detail.label}</span>
                      {detail.value.startsWith('http') ? (
                        <a
                          href={detail.value}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-1 inline-flex items-center gap-1 break-all text-sm font-semibold text-accent-cyan transition hover:underline"
                        >
                          {detail.value}
                          <span aria-hidden="true">↗</span>
                        </a>
                      ) : (
                        <span class="mt-1 select-all text-sm font-semibold text-text-primary">{detail.value}</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>

              <div class="pt-6">
                {isPayPal && paypalLink ? (
                  <a
                    href={paypalLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex w-full items-center justify-center gap-1.5 rounded-xl bg-linear-to-r from-accent-blue to-accent-cyan px-4 py-2.5 text-center text-xs font-semibold text-text-primary shadow-md shadow-[rgba(69,219,237,0.2)] transition hover:opacity-95"
                  >
                    <span>Donar vía PayPal</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <button
                    type="button"
                    data-copy-text={copyText}
                    class="copy-btn flex w-full items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-center text-xs font-semibold text-text-primary transition hover:bg-white/10 active:scale-[0.99]"
                  >
                    <span aria-hidden="true">Copy</span>
                    <span>Copiar Datos de Pago</span>
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const textToCopy = btn.getAttribute('data-copy-text');
      if (textToCopy) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          const originalText = btn.innerHTML;
          btn.innerHTML = '<span>✅ ¡Datos Copiados!</span>';
          btn.classList.add('border-accent-emerald', 'text-accent-emerald');
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.classList.remove('border-accent-emerald', 'text-accent-emerald');
          }, 2000);
        } catch (err) {
          console.error('Error al copiar al portapapeles', err);
        }
      }
    });
  });
</script>
