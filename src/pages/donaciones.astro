---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import DonationGoals from '../components/DonationGoals.astro';
import DonationDestinies from '../components/DonationDestinies.astro';
import ProjectSupportCard from '../components/ProjectSupportCard.astro';
import PaymentMethods from '../components/PaymentMethods.astro';
import SponsorsModal from '../components/SponsorsModal.astro';
---

<BaseLayout
  title="IEEE ComSoc Univalle | Donaciones, Transparencia & Financiamiento"
  description="Apoya al Capítulo Estudiantil IEEE ComSoc. Conoce el destino de los fondos, metas de proyectos, lista de patrocinadores y métodos de pago."
>
  <!-- Hero Section -->
  <HeroHeader
    badgeText="Transparencia y Financiamiento"
    badgeColor="cyan"
    title="Impulsa la innovación y la ingeniería"
    description="Somos una comunidad estudiantil sin fines de lucro. El 100% de los fondos recibidos se reinvierte en proyectos técnicos, formación extracurricular y eventos abiertos para la comunidad."
  />

  <div class="mx-auto max-w-7xl space-y-16 px-4 py-16 sm:px-6 lg:px-8">
    <!-- Transparencia & Barra de Metas Global (Autónomo) -->
    <DonationGoals />

    <!-- Destino de Fondos y Apoyo Específico -->
    <section class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
      <DonationDestinies />
      <ProjectSupportCard />
    </section>

    <!-- Métodos de Donación -->
    <PaymentMethods />
  </div>

  <!-- Modal de Patrocinadores (activado por #open-sponsors-modal en DonationGoals) -->
  <SponsorsModal />
</BaseLayout>
