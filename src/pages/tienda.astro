---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/HeroHeader.astro';
import { getCollection } from 'astro:content';
import ProductCard from '../components/ProductCard.astro';
import ProductModal from '../components/ProductModal.astro';

const tiendaItems = await getCollection('tienda');
---

<BaseLayout
  title="IEEE ComSoc Univalle | Tienda Oficial & Merchandising"
  description="Adquiere la indumentaria oficial y merchandising del Capítulo Estudiantil IEEE ComSoc."
>
  <!-- Hero Section -->
  <HeroHeader
    badgeText="Merch oficial del capítulo"
    badgeColor="emerald"
    title="Tienda IEEE ComSoc"
    description="Lleva con orgullo los colores y la identidad de nuestra comunidad. Todos los fondos recaudados se reinvierten en becas, eventos y proyectos del capítulo."
  />

  <!-- Delivery notice -->
  <div class="mx-auto mt-10 max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="glass-card flex flex-col items-center gap-4 rounded-2xl border border-glass-border/30 bg-bg-secondary/20 p-4 sm:flex-row sm:p-6">
      <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan shadow-[0_0_24px_rgba(69,219,237,0.18)]">
        <Icon name="material-symbols:favorite-rounded" class="h-5 w-5" aria-hidden="true" />
      </div>
      <div class="grow text-sm leading-relaxed text-text-secondary font-light sm:text-base">
        <strong class="font-semibold text-text-primary">Punto de entrega:</strong> Entregas presenciales en el Campus Universitario y envíos a nivel nacional previa coordinación por WhatsApp.
      </div>
    </div>
  </div>

  <!-- Products Catalog -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-accent-cyan font-mono">
          Catálogo disponible
        </div>
        <h2 class="text-3xl font-black tracking-[-0.05em] text-text-primary sm:text-4xl">
          Merchandising del capítulo
        </h2>
      </div>
      <p class="max-w-xl text-sm leading-relaxed text-text-secondary font-light">
        Cada compra ayuda a sostener actividades, becas y proyectos de la comunidad IEEE ComSoc Univalle.
      </p>
    </div>

    {tiendaItems.length > 0 ? (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {tiendaItems.map((item) => (
          <ProductCard item={item} />
        ))}
      </div>
    ) : (
      <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 text-center">
        <div class="mb-6 inline-flex items-center justify-center rounded-[28px] border border-accent-cyan/20 bg-bg-secondary/30 p-10 shadow-[0_8px_30px_-15px_rgba(69,219,237,0.15)]">
          <Icon name="material-symbols:store-rounded" class="h-16 w-16 text-accent-cyan" aria-hidden="true" />
        </div>
        <h2 class="mb-4 text-3xl font-black tracking-[-0.04em] text-text-primary sm:text-4xl">
          La tienda está en construcción
        </h2>
        <p class="mx-auto mb-6 max-w-xl text-base leading-relaxed text-text-secondary font-light sm:text-lg">
          Pronto tendremos disponible una selección exclusiva de merchandising, indumentaria oficial y productos diseñados para representar nuestro capítulo con orgullo.
        </p>
      </section>
    )}
  </section>

  <!-- Product Detail Modal -->
  <ProductModal items={tiendaItems} />
</BaseLayout>
