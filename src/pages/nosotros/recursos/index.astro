---
const frontmatter = {
  title: "Recursos",
  description: "Descarga kits de marca, plantillas y otros materiales útiles de IEEE ComSoc Univalle."
};

import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import ResourceStatsBadge from '../../../components/ResourceStatsBadge.astro';
import EmptyState from '../../../components/EmptyState.astro';

const recursos = await getCollection('recursos');
const categorias = Array.from(new Set(recursos.map((r) => r.data.categoria)));
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <HeroHeader
    badgeText="Kits & plantillas"
    badgeColor="cyan"
    badgeDot={true}
    title={frontmatter.title}
    description={frontmatter.description}
    titleMaxWidth="max-w-3xl"
  >
    <ResourceStatsBadge
      totalRecursos={recursos.length}
      totalCategorias={categorias.length}
    />
  </HeroHeader>

  <div class="recursos-grid-section mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {recursos.length > 0 ? (
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
        {recursos.map((recurso, index) => (
          <div class="resource-card-wrapper" style={`--res-index: ${index};`}>
            <ResourceCard recurso={recurso} />
          </div>
        ))}
      </div>
    ) : (
      <EmptyState
        icon="material-symbols:folder-off-rounded"
        title="No hay recursos disponibles"
        description="Aún no hemos publicado materiales descargables. Vuelve pronto — estamos preparando kits de marca y plantillas para la comunidad."
      />
    )}
  </div>
</BaseLayout>

<style>
  .resource-card-wrapper {
    opacity: 0;
    transform: translateY(24px);
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .resource-card-wrapper.is-visible {
      animation: resCardIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(var(--res-index, 0) * 80ms + 100ms);
    }
    @keyframes resCardIn {
      from {
        opacity: 0;
        transform: translateY(28px);
        filter: blur(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-card-wrapper {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  function setupRecursosObserver() {
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const items = document.querySelectorAll('.recursos-grid-section .resource-card-wrapper');
    if (!motionOK) {
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    items.forEach((el) => observer.observe(el));
  }

  setupRecursosObserver();
  document.addEventListener('astro:after-swap', setupRecursosObserver);
</script>

