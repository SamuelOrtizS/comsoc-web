---
const frontmatter = {
  title: "Recursos",
  description: "Descarga kits de marca, plantillas y otros materiales útiles de IEEE ComSoc Univalle."
};

import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/HeroHeader.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import ResourceStatsBadge from '../../../components/ResourceStatsBadge.astro';
import EmptyState from '../../../components/EmptyState.astro';

const recursos = await getCollection('recursos');
const categorias = Array.from(new Set(recursos.map((r) => r.data.categoria)));
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <HeroHeader
    badgeText="Kits & plantillas"
    badgeColor="cyan"
    badgeDot={true}
    title={frontmatter.title}
    description={frontmatter.description}
    titleMaxWidth="max-w-3xl"
  >
    <ResourceStatsBadge
      totalRecursos={recursos.length}
      totalCategorias={categorias.length}
    />
  </HeroHeader>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {recursos.length > 0 ? (
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
        {recursos.map((recurso) => (
          <ResourceCard recurso={recurso} />
        ))}
      </div>
    ) : (
      <EmptyState
        icon="material-symbols:folder-off-rounded"
        title="No hay recursos disponibles"
        description="Aún no hemos publicado materiales descargables. Vuelve pronto — estamos preparando kits de marca y plantillas para la comunidad."
      />
    )}
  </div>
</BaseLayout>
