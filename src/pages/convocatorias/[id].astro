---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConvocatoriaDetails from '../../components/ConvocatoriaDetails.astro';
import ConvocatoriaCta from '../../components/ConvocatoriaCta.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const convocatorias = await getCollection('convocatorias');
  return convocatorias.map((conv) => ({
    params: { id: conv.id },
    props: { conv },
  }));
}

interface Props {
  conv: CollectionEntry<'convocatorias'>;
}

const { conv } = Astro.props;
const data = conv.data;
const isClosed = data.estado === 'Cerrada';
---

<BaseLayout
  title={`${data.titulo} | Convocatoria IEEE ComSoc`}
  description={data.descripcion}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative">
    <!-- Ambient Glow Effect -->
    <div class="absolute inset-0 -z-10 overflow-hidden rounded-[3rem]">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent-cyan/5 rounded-full blur-[128px] animate-pulse"></div>
      <div class="absolute bottom-0 right-1/4 w-[30rem] h-[30rem] bg-accent-purple/5 rounded-full blur-[128px] animate-pulse delay-700"></div>
    </div>

    <!-- Back button -->
    <nav class="relative">
      <a
        href="/convocatorias"
        class="group inline-flex items-center gap-3 text-sm font-medium text-text-secondary hover:text-accent-cyan transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/60 rounded-lg px-3 py-2 bg-white/[0.02] hover:bg-white/[0.08]"
      >
        <span class="relative inline-flex items-center justify-center w-5 h-5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5 transition-transform duration-300 group-hover:-translate-x-0.5"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </span>
        <span class="font-mono tracking-tight">Volver a convocatorias</span>
      </a>
    </nav>

    <!-- Detail Box -->
    <div class="glass-card relative overflow-hidden rounded-[2.5rem] p-10 sm:p-14 lg:p-16 border border-white/10 shadow-xl hover:shadow-2xl transition-all duration-500">
      <!-- Decorative accent corner -->
      <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-accent-cyan/10 via-accent-purple/5 to-transparent rounded-bl-full"></div>

      <!-- Header details -->
      <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5 mb-10 pb-8 border-b border-white/8">
        <span class="px-4 py-2 rounded-full text-xs font-semibold tracking-wide bg-gradient-to-br from-accent-purple-lighter to-accent-purple-darker text-text-primary border border-accent-purple/30 font-mono inline-flex w-fit shadow-[0_2px_8px_rgba(168,85,247,0.15)]">
          {data.area}
        </span>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-mono font-medium border shadow-sm bg-white/[0.03] transition-all duration-300" {
            isClosed ? `style="border-color: var(--color-accent-red-lighter); box-shadow: 0 0 15px rgba(240,134,134,0.2);"` : `style="border-color: var(--color-accent-emerald-lighter); box-shadow: 0 0 15px rgba(102,192,176,0.15);"`
          }>
            <span class="w-1.5 h-1.5 rounded-full transition-all duration-500" {
              isClosed ? `style="background-color: var(--color-accent-red); box-shadow: 0 0 8px rgba(239,68,68,0.6);"` : `style="background-color: var(--color-accent-emerald); box-shadow: 0 0 8px rgba(52,211,153,0.6);"`
            } aria-hidden="true"></span>
            <span {
              isClosed ? `class="text-accent-red/90"` : `class="text-accent-emerald/90"`
            }> 
              {isClosed ? 'Cerrada' : 'Abierta'} 
            </span>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono text-text-secondary bg-white/[0.03] border border-white/5">
              <Icon name="material-symbols:schedule" class="w-4 h-4 opacity-70 text-text-primary" aria-hidden="true"/>
              <span>
                Límite: 
                <time class="text-text-primary font-medium">
                  {data.fechaLimite}
                </time>
              </span>
            </div>
          </span>
        </div>
      </header>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-text-primary mb-8 leading-[1.1] tracking-tight">
        {data.titulo}
      </h1>

      <p class="text-lg sm:text-xl text-text-secondary font-light leading-relaxed mb-14 max-w-3xl">
        {data.descripcion}
      </p>

      <ConvocatoriaDetails
        requisitos={data.requisitos}
        responsabilidades={data.responsabilidades}
      />

      <ConvocatoriaCta
        formUrl={data.formUrl}
        isClosed={isClosed}
      />
    </div>
  </article>
</BaseLayout>
