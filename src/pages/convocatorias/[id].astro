---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const convocatorias = await getCollection('convocatorias');
  return convocatorias.map((conv) => ({
    params: { id: conv.id },
    props: { conv },
  }));
}

interface Props {
  conv: CollectionEntry<'convocatorias'>;
}

const { conv } = Astro.props;
const data = conv.data;
const isClosed = data.estado === 'Cerrada';
---

<BaseLayout
  title={`${data.titulo} | Convocatoria IEEE ComSoc`}
  description={data.descripcion}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Back button -->
    <a
      href="/convocatorias"
      class="inline-flex items-center gap-2 text-sm text-accent-cyan hover:text-accent-cyan hover:bg-accent-cyan/10 font-mono mb-8 group px-3 py-1.5 rounded-lg transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/60"
    >
      <span class="group-hover:-translate-x-1 transition-transform" aria-hidden="true">←</span>
      <span>Volver a convocatorias</span>
    </a>

    <!-- Detail Box -->
    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-accent-purple/30 relative overflow-hidden transition-all duration-500">

      <!-- Header details -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 border-b border-white/10 pb-6">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold from-accent-purple-lighter to-accent-purple-darker bg-gradient-to-br text-accent-purple border border-accent-purple/30 font-mono inline-flex w-fit">
          {data.area}
        </span>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <span class={`text-xs font-mono px-3 py-1.5 rounded-lg inline-flex items-center gap-1.5 ${isClosed ? 'from-accent-red-lighter to-accent-red-darker bg-gradient-to-br text-accent-red border border-accent-red/20' : 'from-accent-emerald-lighter to-accent-emerald-darker bg-gradient-to-br text-accent-emerald border border-accent-emerald/20'}`}>
            <span aria-hidden="true">{isClosed ? '●' : '●'}</span>
            <span>{isClosed ? 'Cerrada' : 'Abierta'}</span>
          </span>
          <span class="text-xs font-mono text-text-secondary inline-flex items-center gap-1.5">
            <span aria-hidden="true">⏱</span>
            <span>Límite: <time>{data.fechaLimite}</time></span>
          </span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text-primary mb-6 leading-tight tracking-tight">
        {data.titulo}
      </h1>

      <p class="text-base sm:text-lg text-text-secondary font-light leading-relaxed mb-12 max-w-2xl">
        {data.descripcion}
      </p>

      <!-- Requirements & Responsibilities Split -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <!-- Requisitos -->
        <div class="from-bg-secondary-lighter to-bg-secondary bg-gradient-to-br rounded-2xl p-6 border border-accent-cyan/30 hover:border-accent-cyan/50 transition-colors">
          <h2 class="text-lg font-bold text-accent-cyan mb-4 flex items-center gap-2 font-mono">
            <Icon name="material-symbols:star-rounded" class="w-5 h-5" aria-hidden="true" />
            <span>Requisitos</span>
          </h2>
          <ul class="space-y-3 text-sm text-text-secondary font-light">
            {data.requisitos.map((req) => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent-cyan font-bold flex-shrink-0 mt-0.5">✓</span>
                <span class="break-words">{req}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Responsabilidades -->
        <div class="from-bg-secondary-lighter to-bg-secondary bg-gradient-to-br rounded-2xl p-6 border border-accent-purple to-border-purple-darker border-gradient-to-br hover:border-accent-purple/50 transition-colors">
          <h2 class="text-lg font-bold text-accent-purple mb-4 flex items-center gap-2 font-mono">
            <Icon name="material-symbols:star-rounded" class="w-5 h-5" aria-hidden="true" />
            <span>Responsabilidades</span>
          </h2>
          <ul class="space-y-3 text-sm text-text-secondary font-light">
            {data.responsabilidades.map((resp) => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent-purple font-bold flex-shrink-0 mt-0.5">★</span>
                <span class="break-words">{resp}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Application CTA -->
      <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="text-sm text-text-secondary font-light leading-relaxed">
          {isClosed ? (
            <p>Esta convocatoria ha cerrado sus postulaciones. ¡Gracias por tu interés! Mantente atento a futuras oportunidades.</p>
          ) : (
            <p>¿Cumples con los requisitos? Completa el formulario oficial de postulación antes de la fecha límite.</p>
          )}
        </div>

        {!isClosed && (
          <a
            href={data.formUrl || 'https://forms.gle/sample-comsoc'}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-text-primary from-accent-blue to-accent-cyan bg-gradient-to-r shadow-lg shadow-accent-blue/25 hover:shadow-accent-blue/40 hover:from-accent-blue hover:to-accent-cyan hover:brightness-110 active:scale-95 transition-all duration-200 text-center flex items-center justify-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
          >
            <span>Postular Ahora</span>
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>

    </div>
  </article>
</BaseLayout>
