---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const convocatorias = await getCollection('convocatorias');
  return convocatorias.map((conv) => ({
    params: { id: conv.id },
    props: { conv },
  }));
}

interface Props {
  conv: CollectionEntry<'convocatorias'>;
}

const { conv } = Astro.props;
const data = conv.data;
const isClosed = data.estado === 'Cerrada';
---

<BaseLayout
  title={`${data.titulo} | Convocatoria IEEE ComSoc`}
  description={data.descripcion}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Back button -->
    <a
      href="/convocatorias"
      class="inline-flex items-center gap-2 text-sm text-accent-cyan hover:text-accent-cyan font-mono mb-8 group"
    >
      <span class="group-hover:-translate-x-1 transition-transform">←</span>
      <span>Volver a convocatorias</span>
    </a>

    <!-- Detail Box -->
    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-accent-purple/30 relative overflow-hidden">
      <!-- Ambient light -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-accent-purple/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Header details -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6 border-b border-white/10 pb-6">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-accent-purple/20 text-accent-purple border border-accent-purple/30 font-mono">
          {data.area}
        </span>
        <div class="flex items-center gap-3">
          <span class={`text-xs font-mono px-3 py-1 rounded-lg ${isClosed ? 'bg-accent-red/10 text-accent-red border border-accent-red/20' : 'bg-accent-emerald/10 text-accent-emerald border border-accent-emerald/20'}`}>
            Estado: {data.estado}
          </span>
          <span class="text-xs font-mono text-text-secondary">
            ⏳ Límite: {data.fechaLimite}
          </span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary mb-6">
        {data.titulo}
      </h1>

      <p class="text-base sm:text-lg text-text-secondary font-light leading-relaxed mb-10">
        {data.descripcion}
      </p>

      <!-- Requirements & Responsibilities Split -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <!-- Requisitos -->
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
          <h2 class="text-lg font-bold text-accent-cyan mb-4 flex items-center gap-2 font-mono">
            <span>📋</span>
            <span>Requisitos</span>
          </h2>
          <ul class="space-y-3 text-sm text-text-secondary font-light">
            {data.requisitos.map((req) => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent-cyan font-bold">✓</span>
                <span>{req}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Responsabilidades -->
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10">
          <h2 class="text-lg font-bold text-accent-purple mb-4 flex items-center gap-2 font-mono">
            <span>🎯</span>
            <span>Responsabilidades</span>
          </h2>
          <ul class="space-y-3 text-sm text-text-secondary font-light">
            {data.responsabilidades.map((resp) => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent-purple font-bold">★</span>
                <span>{resp}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Application CTA -->
      <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-sm text-text-secondary font-light">
          {isClosed ? (
            <p>Esta convocatoria ha cerrado sus postulaciones. ¡Gracias por tu interés!</p>
          ) : (
            <p>¿Cumples con los requisitos? Completa el formulario oficial de postulación.</p>
          )}
        </div>

        {!isClosed && (
          <a
            href={data.formUrl || 'https://forms.gle/sample-comsoc'}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-text-primary bg-linear-to-r from-accent-blue to-accent-cyan shadow-lg shadow-accent-blue/25 hover:shadow-accent-blue/40 hover:scale-[1.02] transition text-center"
          >
            Postular Ahora ↗
          </a>
        )}
      </div>

    </div>
  </article>
</BaseLayout>
