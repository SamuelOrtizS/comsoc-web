---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConvocatoriaCard from '../../components/ConvocatoriaCard.astro';
import { getCollection } from 'astro:content';

const allConvocatorias = await getCollection('convocatorias');
---

<BaseLayout
  title="IEEE ComSoc Univalle | Convocatorias Abiertas"
  description="Únete al equipo directivo y comités de trabajo del Capítulo Estudiantil IEEE ComSoc."
>
  <section class="relative border-b border-white/10 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent-purple/30 bg-accent-purple/10 px-3 py-1 text-xs font-mono uppercase tracking-[0.18em] text-accent-purple">
        Oportunidades de voluntariado
      </div>

      <h1 class="mb-4 text-4xl font-extrabold tracking-[-0.04em] text-text-primary sm:text-5xl lg:text-6xl">
        Convocatorias &amp; reclutamiento
      </h1>

      <p class="mx-auto max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg">
        Forma parte de nuestros equipos de proyectos, organización de eventos, marketing e investigación. Potencia tu perfil profesional.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="flex items-center gap-3 text-xl font-bold text-text-primary sm:text-2xl">
        <span>Puestos disponibles</span>
        <span class="inline-flex min-w-9 items-center justify-center rounded-full border border-accent-cyan/30 bg-accent-cyan/15 px-2.5 py-1 text-xs font-mono text-accent-cyan">
          {allConvocatorias.length}
        </span>
      </h2>
    </div>

    {allConvocatorias.length === 0 ? (
      <div class="glass-card mx-auto max-w-xl rounded-2xl border border-white/10 p-12 text-center">
        <div class="mb-4 text-4xl">📭</div>
        <h3 class="mb-2 text-lg font-bold text-text-primary">No hay convocatorias activas en este momento</h3>
        <p class="text-sm text-text-secondary">
          Síguenos en nuestras redes sociales para estar atento al próximo periodo de postulaciones.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {allConvocatorias.map((item) => (
          <ConvocatoriaCard
            id={item.id}
            titulo={item.data.titulo}
            area={item.data.area}
            fechaLimite={item.data.fechaLimite}
            descripcion={item.data.descripcion}
            requisitos={item.data.requisitos}
            responsabilidades={item.data.responsabilidades}
            estado={item.data.estado}
            formUrl={item.data.formUrl}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
