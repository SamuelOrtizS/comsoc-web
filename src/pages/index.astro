---
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/imageResolver';
import logoWhite from '../assets/images/logo-comsoc-white.svg';
import BaseLayout from '../layouts/BaseLayout.astro';
import CountdownTimer from '../components/CountdownTimer.astro';
import { getCollection } from 'astro:content';
import estadisticas from '../content/estadisticas.json';

const allEvents = await getCollection('eventos');
const upcomingEvents = allEvents.filter((ev) => ev.data.estado === 'Publicado');

// Pick a random featured event from upcoming (or all if none upcoming)
const eventPool = upcomingEvents.length > 0 ? upcomingEvents : allEvents;
const featuredEvent = eventPool[Math.floor(Math.random() * eventPool.length)];
const featuredEventSlug = featuredEvent ? featuredEvent.id.replace(/\/evento$/, '') : '';

// Load projects from content/proyectos — prefer destacado=true, then fill with others, shuffle, take 2
const allProyectos = await getCollection('proyectos');
const destacados = allProyectos.filter((p) => p.data.destacado);
const noDestacados = allProyectos.filter((p) => !p.data.destacado);
const projectPool = [...destacados.sort(() => Math.random() - 0.5), ...noDestacados.sort(() => Math.random() - 0.5)];
const featuredProjects = projectPool.slice(0, 2).map((p) => ({
  title: p.data.titulo,
  category: p.data.categoria,
  desc: p.data.descripcion,
  image: p.data.imagen,
  link: p.data.enlace ?? '/eventos',
  estado: p.data.estado,
  tags: p.data.tags ?? [],
}));

const allAliados = await getCollection('aliados');
const aliados = [...allAliados].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const pillars = [
  {
    title: '5G / 6G & Redes Móviles',
    desc: 'Arquitecturas de telecomunicaciones de última generación, Open RAN, beamforming y virtualización de redes NFV/SDN.',
    icon: '📡',
     color: 'from-accent-blue/20 to-accent-cyan/20',
     border: 'border-accent-cyan/30',
  },
  {
    title: 'IoT & Telemetría Satelital',
    desc: 'Sensores de bajo consumo, protocolos LPWAN (LoRaWAN, NB-IoT), procesamiento en el borde (Edge Computing) y telemetría MQTT.',
    icon: '🌐',
     color: 'from-accent-cyan/20 to-accent-emerald/20',
     border: 'border-accent-emerald/30',
  },
  {
    title: 'Comunicaciones Ópticas & Cuánticas',
    desc: 'Sistemas DWDM de alta capacidad, fotónica integrada y protocolos de distribución cuántica de claves (QKD).',
    icon: '💡',
    color: 'from-accent-purple/20 to-indigo-500/20',
    border: 'border-accent-purple/30',
  },
  {
    title: 'IA Aplicada a Redes',
    desc: 'Optimización predictiva de tráfico espectral, detección de anomalías y automatización inteligente de infraestructura de telecomunicaciones.',
    icon: '🧠',
    color: 'from-indigo-500/20 to-accent-blue/20',
    border: 'border-indigo-500/30',
  },
];


---

<BaseLayout title="IEEE ComSoc Univalle | Inicio">
  <div class="relative isolate min-h-[90vh] overflow-hidden bg-transparent">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(34,211,238,0.10),transparent_42%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,8,22,0.08),rgba(5,8,22,0.24)_42%,rgba(5,8,22,0.18))]"></div>

    <div class="relative z-10 mx-auto flex min-h-[90vh] max-w-7xl items-center justify-center px-4 pb-16 pt-12 sm:px-6 lg:px-8">
      <div class="w-full max-w-5xl text-center">
        <div class="mb-8 inline-flex items-center gap-3 rounded-full border border-accent-cyan/30 bg-white/5 px-4 py-2 shadow-[0_0_30px_rgba(34,211,238,0.12)] backdrop-blur-md">
          <span class="h-2.5 w-2.5 rounded-full bg-accent-cyan shadow-[0_0_16px_rgba(34,211,238,0.9)]"></span>
          <span class="text-[10px] font-medium uppercase tracking-[0.28em] text-accent-cyan font-mono">
            IEEE ComSoc Univalle
          </span>
        </div>

        <div class="flex justify-center">
          <Image src={logoWhite} alt="IEEE ComSoc Logo" class="h-24 w-auto sm:h-32 lg:h-40" loading="eager" decoding="async" />
        </div>

        <p class="mx-auto mt-5 max-w-3xl text-base font-light leading-relaxed text-text-secondary sm:text-xl">
          Liderando la innovación en redes de próxima generación, internet de las cosas (IoT), sistemas inalámbricos 5G/6G y comunicaciones cuánticas.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="/eventos"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-linear-to-r from-accent-blue via-accent-cyan to-accent-cyan px-7 py-3.5 font-semibold text-slate-950 shadow-[0_18px_40px_-18px_rgba(21,93,252,0.9)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_48px_-16px_rgba(34,211,238,0.82)] sm:w-auto"
          >
            <span>Explorar Eventos</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a
            href="/convocatorias"
            class="inline-flex w-full items-center justify-center rounded-xl border border-white/15 bg-white/5 px-7 py-3.5 font-semibold text-text-secondary transition duration-200 hover:-translate-y-0.5 hover:border-accent-cyan/40 hover:bg-white/10 hover:text-text-primary sm:w-auto"
          >
            Unirse al Equipo
          </a>
        </div>

        <div class="mt-16 grid grid-cols-2 gap-4 sm:gap-5 md:grid-cols-4">
          {estadisticas.map((stat) => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] px-4 py-5 text-center shadow-[0_20px_40px_-32px_rgba(21,93,252,0.8)] backdrop-blur-sm transition duration-200 hover:border-accent-cyan/35 hover:bg-white/[0.04]">
              <div class={`text-2xl font-bold font-mono sm:text-3xl ${stat.color || 'text-text-primary'}`}>
                {stat.valor}
              </div>
              <div class="mt-2 text-[10px] uppercase tracking-[0.16em] text-text-secondary font-light">
                {stat.etiqueta}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Event & Live Countdown Spotlight -->
  {featuredEvent && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="relative overflow-hidden rounded-[28px] border border-accent-cyan/20 bg-[linear-gradient(135deg,rgba(13,17,40,0.52),rgba(8,14,28,0.62))] p-6 sm:p-8 lg:p-10 shadow-[0_30px_90px_-45px_rgba(21,93,252,0.45)]">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(34,211,238,0.12),transparent_28%),radial-gradient(circle_at_bottom_left,rgba(21,93,252,0.10),transparent_32%)]"></div>
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-cyan/50 to-transparent"></div>

        <div class="relative grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
          <div class="space-y-5 lg:col-span-7">
            <div class="inline-flex items-center gap-2 rounded-full border border-accent-cyan/30 bg-accent-cyan/10 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent-cyan font-mono shadow-[0_0_18px_rgba(34,211,238,0.18)]">
              <span class="h-2 w-2 rounded-full bg-accent-cyan shadow-[0_0_12px_rgba(34,211,238,0.95)]"></span>
              Evento Destacado
            </div>

            <div class="space-y-3">
              <h2 class="text-3xl font-black tracking-[-0.04em] text-text-primary sm:text-4xl lg:text-5xl">
                {featuredEvent.data.titulo}
              </h2>
              <p class="max-w-2xl text-base leading-relaxed text-text-secondary font-light sm:text-lg">
                {featuredEvent.data.descripcion}
              </p>
            </div>

            <div class="flex flex-wrap gap-3 text-xs font-mono text-text-secondary font-light sm:text-[11px]">
              <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5">
                <span aria-hidden="true">📍</span>
                {featuredEvent.data.lugarNombre}
              </div>
              <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5">
                <span aria-hidden="true">🕒</span>
                {featuredEvent.data.horaInicio} - {featuredEvent.data.horaFin}
              </div>
            </div>

            <div class="flex flex-wrap gap-3 pt-2">
              <a
                href={`/eventos/${featuredEventSlug}`}
                class="inline-flex items-center justify-center rounded-xl bg-linear-to-r from-accent-blue via-accent-cyan to-accent-cyan px-6 py-3 text-sm font-semibold text-slate-950 shadow-[0_18px_40px_-18px_rgba(21,93,252,0.9)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_48px_-16px_rgba(34,211,238,0.82)]"
              >
                Inscribirse al Evento
              </a>
              <a
                href="/eventos"
                class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-text-secondary transition duration-200 hover:-translate-y-0.5 hover:border-accent-cyan/40 hover:bg-white/10 hover:text-text-primary"
              >
                Ver todos los eventos
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-[24px] border border-white/10 bg-black/20 p-1.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] backdrop-blur-sm">
              <CountdownTimer
                targetDate={`${featuredEvent.data.fechaInicio}T${featuredEvent.data.horaInicio || '09:00'}:00`}
                eventName={featuredEvent.data.titulo}
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Ecosystem / Technical Pillars -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <div class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-accent-cyan font-mono">
        Áreas de Especialización
      </div>
      <h2 class="mb-4 text-3xl font-black tracking-[-0.04em] text-text-primary sm:text-4xl">
        Ecosistema Tecnológico de IEEE ComSoc
      </h2>
      <p class="text-sm leading-relaxed text-text-secondary sm:text-base font-light">
        Desarrollamos proyectos, capacitaciones e investigaciones orientadas a las áreas de mayor impacto en la industria moderna de telecomunicaciones.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {pillars.map((pillar) => (
        <article class={`group relative overflow-hidden rounded-[22px] border ${pillar.border} bg-[linear-gradient(180deg,rgba(15,23,42,0.46),rgba(5,8,22,0.72))] p-6 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_28px_60px_-38px_rgba(34,211,238,0.38)]`}>
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-2xl shadow-[0_16px_32px_-22px_rgba(34,211,238,0.8)]">
            {pillar.icon}
          </div>
          <h3 class="mb-3 text-lg font-bold tracking-[-0.03em] text-text-primary transition-colors group-hover:text-accent-cyan">
            {pillar.title}
          </h3>
          <p class="text-xs leading-relaxed text-text-secondary font-light">
            {pillar.desc}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Highlighted Projects Preview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
      <div>
        <div class="text-xs uppercase font-mono tracking-widest text-accent-purple mb-2 font-semibold">
          Investigación &amp; Desarrollo
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary">
          Proyectos Destacados del Capítulo
        </h2>
      </div>
      <a
        href="/proyectos"
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent-cyan hover:text-accent-cyan group"
      >
        <span>Ver todos los proyectos</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredProjects.map((proj) => (
           <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group flex flex-col hover:border-accent-purple/40 transition-all duration-300">
          <div class="aspect-video relative overflow-hidden bg-slate-900">
            <Image
              src={resolveImage(proj.image) as any}
              alt={proj.title}
              width={800}
              height={450}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-3 left-3 flex gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-mono bg-black/70 backdrop-blur-md text-accent-cyan border border-accent-cyan/30">
                {proj.category}
              </span>
              <span class={`px-3 py-1 rounded-full text-xs font-mono bg-black/70 backdrop-blur-md border ${proj.estado === 'Activo' ? 'text-accent-emerald border-accent-emerald/30' : proj.estado === 'Completado' ? 'text-accent-blue border-accent-blue/30' : 'text-accent-yellow border-accent-yellow/30'}`}>
                {proj.estado === 'Activo' ? '🟢' : proj.estado === 'Completado' ? '✅' : '⏸'} {proj.estado}
              </span>
            </div>
          </div>
          <div class="p-6 flex flex-col justify-between grow">
            <div>
              <h3 class="text-xl font-bold text-text-primary group-hover:text-accent-cyan transition-colors mb-2">
                {proj.title}
              </h3>
              <p class="text-sm text-text-secondary font-light leading-relaxed mb-4">
                {proj.desc}
              </p>
              {proj.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {proj.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/5 text-text-secondary border border-white/10">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <a
              href={proj.link}
              class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-accent-cyan hover:text-accent-cyan font-mono"
            >
              Explorar Proyecto ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Nuestros Aliados -->
  {aliados.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/10">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="text-xs uppercase font-mono tracking-widest text-accent-cyan mb-2 font-semibold">
          Red de Colaboración
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">
          Nuestros Aliados
        </h2>
        <p class="text-text-secondary text-sm font-light">
          Instituciones, empresas y organizaciones que nos acompañan en la misión de impulsar la ingeniería y las telecomunicaciones.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {aliados.map((aliado) => (
          <button
            type="button"
            class="aliado-card glass-card rounded-2xl p-6 border border-white/10 text-left group cursor-pointer hover:border-accent-cyan/40 hover:shadow-lg hover:shadow-accent-cyan/10 transition-all duration-300 w-full flex flex-col gap-4"
            data-aliado={JSON.stringify(aliado.data)}
            aria-label={`Conocer más sobre ${aliado.data.nombre}`}
          >
            <div class="flex items-center gap-4">
              {aliado.data.logo
                ? <Image src={resolveImage(aliado.data.logo) as any} alt={aliado.data.nombre} width={200} height={80} loading="lazy" decoding="async" class="h-10 w-auto object-contain brightness-0 invert opacity-70 group-hover:opacity-100 transition" />
                : <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-2xl">🤝</div>
              }
              <div>
                <span class="text-[10px] font-mono text-accent-cyan uppercase tracking-wider">{aliado.data.tipo}</span>
                <h3 class="text-sm font-bold text-text-primary group-hover:text-accent-cyan transition">{aliado.data.nombre}</h3>
              </div>
            </div>
            <p class="text-xs text-text-secondary font-light leading-relaxed line-clamp-3 grow">{aliado.data.descripcion}</p>
            <div class="text-[10px] font-mono text-text-secondary border border-white/10 px-3 py-1 rounded-full self-start group-hover:border-accent-cyan/40 group-hover:text-accent-cyan transition">
              Conocer más →
            </div>
          </button>
        ))}
      </div>
    </section>
  )}

  <!-- Aliados Modal -->
  <div
    id="aliado-modal-overlay"
    class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xl flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-aliado-name"
  >
    <div id="aliado-modal" class="relative bg-[#0a0f2d] border border-white/15 rounded-3xl shadow-2xl shadow-blue-900/40 w-full max-w-md p-8 flex flex-col gap-5 translate-y-4 transition-all duration-300">
      <button
        id="aliado-modal-close"
        type="button"
        class="absolute top-4 right-4 text-text-secondary hover:text-text-primary p-2 rounded-xl hover:bg-white/10 transition"
        aria-label="Cerrar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="flex items-center gap-4">
        <div id="aliado-modal-logo" class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-3xl overflow-hidden shrink-0"></div>
        <div>
          <div id="aliado-modal-tipo" class="text-[10px] font-mono text-accent-cyan uppercase tracking-wider mb-0.5"></div>
          <h2 id="modal-aliado-name" class="text-lg font-extrabold text-text-primary"></h2>
        </div>
      </div>

      <div class="border-t border-white/10"></div>

      <div id="aliado-modal-desc" class="text-sm text-text-secondary font-light leading-relaxed"></div>
      <div id="aliado-modal-acerca" class="text-xs text-text-secondary font-light leading-relaxed hidden"></div>

      <div id="aliado-modal-contact" class="flex flex-col gap-2"></div>
      <div id="aliado-modal-links" class="flex flex-wrap gap-2"></div>
    </div>
  </div>

  <script>
    type AliadoData = {
      nombre: string;
      tipo: string;
      logo?: string;
      descripcion: string;
      acerca?: string;
      website?: string;
      email?: string;
      phone?: string;
      linkedin?: string;
      instagram?: string;
    };

    const aliadoOverlay = document.getElementById('aliado-modal-overlay') as HTMLElement;
    const aliadoModal   = document.getElementById('aliado-modal') as HTMLElement;
    const aliadoClose   = document.getElementById('aliado-modal-close') as HTMLButtonElement;

    function openAliadoModal(a: AliadoData) {
      const logoWrap = document.getElementById('aliado-modal-logo') as HTMLElement;
      logoWrap.innerHTML = a.logo
        ? `<img src="${a.logo}" alt="${a.nombre}" class="w-full h-full object-contain brightness-0 invert" />`
        : '🤝';

      (document.getElementById('aliado-modal-tipo') as HTMLElement).textContent = a.tipo;
      (document.getElementById('modal-aliado-name') as HTMLElement).textContent = a.nombre;
      (document.getElementById('aliado-modal-desc') as HTMLElement).textContent = a.descripcion;

      const acercaEl = document.getElementById('aliado-modal-acerca') as HTMLElement;
      if (a.acerca) {
        acercaEl.textContent = a.acerca;
        acercaEl.classList.remove('hidden');
      } else {
        acercaEl.classList.add('hidden');
      }

      const contactEl = document.getElementById('aliado-modal-contact') as HTMLElement;
      contactEl.innerHTML = '';
      if (a.email) {
        contactEl.insertAdjacentHTML('beforeend', `<a href="mailto:${a.email}" class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-accent-cyan hover:border-accent-cyan/40 transition text-xs font-mono"><svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>${a.email}</a>`);
      }
      if (a.phone) {
        contactEl.insertAdjacentHTML('beforeend', `<a href="tel:${a.phone}" class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-accent-cyan hover:border-accent-cyan/40 transition text-xs font-mono"><svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>${a.phone}</a>`);
      }

      const linksEl = document.getElementById('aliado-modal-links') as HTMLElement;
      linksEl.innerHTML = '';
      const socials: { key: keyof AliadoData; label: string; color: string }[] = [
        { key: 'website',   label: 'Sitio Web',  color: 'bg-accent-emerald/20 text-accent-emerald border-accent-emerald/30 hover:bg-accent-emerald/40' },
        { key: 'linkedin',  label: 'LinkedIn',   color: 'bg-accent-blue/20 text-accent-blue border-accent-blue/30 hover:bg-accent-blue/40' },
        { key: 'instagram', label: 'Instagram',  color: 'bg-accent-rose/20 text-accent-rose border-accent-rose/30 hover:bg-accent-rose/40' },
      ];
      socials.forEach(({ key, label, color }) => {
        const url = a[key] as string | undefined;
        if (url) linksEl.insertAdjacentHTML('beforeend', `<a href="${url}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition ${color}">${label} ↗</a>`);
      });
      if (linksEl.innerHTML) linksEl.classList.remove('hidden');
      else linksEl.classList.add('hidden');

      aliadoOverlay.classList.remove('opacity-0', 'pointer-events-none');
      aliadoOverlay.classList.add('opacity-100', 'pointer-events-auto');
      aliadoModal.classList.remove('translate-y-4');
      document.body.style.overflow = 'hidden';
    }

    function closeAliadoModal() {
      aliadoOverlay.classList.add('opacity-0', 'pointer-events-none');
      aliadoOverlay.classList.remove('opacity-100', 'pointer-events-auto');
      aliadoModal.classList.add('translate-y-4');
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLButtonElement>('.aliado-card').forEach((card) => {
      card.addEventListener('click', () => {
        const raw = card.getAttribute('data-aliado');
        if (raw) openAliadoModal(JSON.parse(raw) as AliadoData);
      });
    });
    aliadoClose.addEventListener('click', closeAliadoModal);
    aliadoOverlay.addEventListener('click', (e) => { if (e.target === aliadoOverlay) closeAliadoModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAliadoModal(); });
  </script>

