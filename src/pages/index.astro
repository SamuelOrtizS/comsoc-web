---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logoWhite from '../assets/images/logo-comsoc-white.svg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HeroPillars from '../components/HeroPillars.astro';
import FeaturedEventBanner from '../components/FeaturedEventBanner.astro';
import StatsSection from '../components/StatsSection.astro';
import AliadosSection from '../components/AliadosSection.astro';
import CommunityCta from '../components/CommunityCta.astro';
import { getImageModule } from '../utils/imageImports';

const allEvents = await getCollection('eventos');
const upcomingEvents = allEvents.filter((ev) => ev.data.estado === 'Publicado');

// Deterministic featured event: nearest upcoming by fechaInicio, with ?event=slug override for shareability
const urlEventSlug = Astro.url.searchParams.get('event');
let featuredEvent = null as typeof allEvents[0] | null;
if (urlEventSlug) {
  featuredEvent = allEvents.find((ev) => ev.id.replace(/\/evento$/, '') === urlEventSlug) ?? null;
}
if (!featuredEvent) {
  const sortedUpcoming = [...upcomingEvents].sort((a, b) => new Date(a.data.fechaInicio).getTime() - new Date(b.data.fechaInicio).getTime());
  const pool = sortedUpcoming.length > 0 ? sortedUpcoming : [...allEvents].sort((a, b) => new Date(b.data.fechaInicio).getTime() - new Date(a.data.fechaInicio).getTime());
  featuredEvent = pool[0] ?? null;
}

// Load projects deterministically — destacado=true first (sorted by titulo), then others alphabetically
const allProyectos = await getCollection('proyectos');
const destacados = [...allProyectos.filter((p) => p.data.destacado)].sort((a, b) => a.data.titulo.localeCompare(b.data.titulo));
const noDestacados = [...allProyectos.filter((p) => !p.data.destacado)].sort((a, b) => a.data.titulo.localeCompare(b.data.titulo));
const projectPool = [...destacados, ...noDestacados];
const featuredProjects = projectPool.slice(0, 2).map((p) => {
  const isRemoteProjectImage = typeof p.data.imagen === 'string' && (p.data.imagen.startsWith('http://') || p.data.imagen.startsWith('https://'));
  const resolvedProjectImage = getImageModule(p.data.imagen);
  return {
    ...p,
    remoteImage: isRemoteProjectImage ? p.data.imagen : undefined,
    title: p.data.titulo,
    category: p.data.categoria,
    desc: p.data.descripcion,
    link: p.data.enlace ?? `/proyectos/${p.id}`,
    estado: p.data.estado,
    tags: p.data.tags ?? [],
    isRemoteProjectImage,
    resolvedProjectImage,
  };
});

const allAliados = await getCollection('aliados');
const aliados = [...allAliados].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="IEEE ComSoc Univalle | Inicio">
  <!-- Background Ambient Effects -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden">
    <style>
      /* ─── Orbital blobs ──────────────────────────────────────────────────── */
      @media (prefers-reduced-motion: no-preference) {
        @keyframes blob {
          0%   { transform: translate(0, 0) scale(1); }
          33%  { transform: translate(30px, -50px) scale(1.1); }
          66%  { transform: translate(-20px, 20px) scale(0.9); }
          100% { transform: translate(0, 0) scale(1); }
        }
        .animate-blob { animation: blob 7s infinite; }
      }
      .animation-delay-2000 { animation-delay: 2s; }
      .animation-delay-4000 { animation-delay: 4s; }

      /* ─── Hero focal sequence ────────────────────────────────────────────── */
      @media (prefers-reduced-motion: no-preference) {
        /* Badge pill */
        @keyframes hero-badge-in {
          from { opacity: 0; transform: translateY(12px) scale(0.96); filter: blur(4px); }
          to   { opacity: 1; transform: translateY(0)   scale(1);    filter: blur(0); }
        }
        /* Logo con breve halo cian */
        @keyframes hero-logo-in {
          0%   { opacity: 0; transform: translateY(16px) scale(0.94); filter: blur(6px); }
          70%  { opacity: 1; transform: translateY(-2px) scale(1.01); filter: blur(0); }
          100% { opacity: 1; transform: translateY(0)   scale(1);    filter: blur(0); }
        }
        /* Párrafo */
        @keyframes hero-copy-in {
          from { opacity: 0; transform: translateY(10px); }
          to   { opacity: 1; transform: translateY(0); }
        }
        /* CTAs */
        @keyframes hero-cta-in {
          from { opacity: 0; transform: translateY(8px); }
          to   { opacity: 1; transform: translateY(0); }
        }
        /* Scan-line cian — una sola pasada */
        @keyframes scanline {
          from { transform: scaleX(0); transform-origin: left; opacity: 0.9; }
          80%  { transform: scaleX(1); transform-origin: left; opacity: 0.9; }
          to   { transform: scaleX(1); transform-origin: left; opacity: 0; }
        }
        .hero-badge  { animation: hero-badge-in 0.55s cubic-bezier(0.16,1,0.3,1) 0.05s both; }
        .hero-logo   { animation: hero-logo-in  0.7s  cubic-bezier(0.16,1,0.3,1) 0.18s both; }
        .hero-copy   { animation: hero-copy-in  0.55s cubic-bezier(0.16,1,0.3,1) 0.38s both; }
        .hero-cta-1  { animation: hero-cta-in   0.45s cubic-bezier(0.16,1,0.3,1) 0.52s both; }
        .hero-cta-2  { animation: hero-cta-in   0.45s cubic-bezier(0.16,1,0.3,1) 0.62s both; }
        .hero-scan   { animation: scanline       1.1s  cubic-bezier(0.16,1,0.3,1) 0.1s  both; }
      }
      /* Sin motion: estado visible final desde el inicio */
      @media (prefers-reduced-motion: reduce) {
        .hero-badge, .hero-logo, .hero-copy, .hero-cta-1, .hero-cta-2 { opacity: 1; }
      }

      /* ─── Proyectos — scroll reveal ─────────────────────────────────────── */
      @media (prefers-reduced-motion: no-preference) {
        @keyframes proj-section-reveal {
          from { clip-path: inset(0 0 100% 0); opacity: 0; }
          to   { clip-path: inset(0 0   0% 0); opacity: 1; }
        }
        @keyframes proj-card-in {
          from { opacity: 0; transform: translateY(28px); }
          to   { opacity: 1; transform: translateY(0); }
        }
        .proj-section-header.is-visible {
          animation: proj-section-reveal 0.6s cubic-bezier(0.16,1,0.3,1) both;
        }
        .proj-card.is-visible {
          animation: proj-card-in 0.55s cubic-bezier(0.16,1,0.3,1) both;
        }
        .proj-card.is-visible[data-delay="1"] { animation-delay: 0.1s; }
        .proj-card.is-visible[data-delay="2"] { animation-delay: 0.2s; }
      }
      /* Sin motion: siempre visible */
      @media (prefers-reduced-motion: reduce) {
        .proj-section-header, .proj-card { opacity: 1; }
      }
      /* Estado inicial oculto — sólo si JS puede controlar el reveal */
      .proj-section-header, .proj-card { opacity: 0; }
      .proj-section-header.no-js-visible, .proj-card.no-js-visible { opacity: 1; }
    </style>
    <div class="absolute -top-40 -left-40 h-80 w-80 rounded-full bg-accent-cyan/5 blur-[100px] animate-blob"></div>
    <div class="absolute top-1/2 -right-40 h-80 w-80 rounded-full bg-accent-blue/5 blur-[100px] animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-40 left-1/3 h-80 w-80 rounded-full bg-accent-purple/5 blur-[100px] animate-blob animation-delay-4000"></div>
  </div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(34,211,238,0.12),transparent_42%)]"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-bg-primary-lighter/10 via-bg-primary/24 to-bg-primary-darker/20">
    <!-- Scan-line cian: una sola pasada al cargar -->
    <div class="hero-scan pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-cyan/80 to-transparent" aria-hidden="true"></div>
  </div>

  <!-- Hero Main -->
  <div class="relative z-10 mx-auto flex min-h-[90vh] max-w-7xl items-center justify-center px-4 pb-16 pt-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-5xl text-center">
      <h1 class="sr-only">IEEE ComSoc Univalle — Comunidad de Ingenieros en Telecomunicaciones</h1>
      <div class="hero-badge mb-8 inline-flex items-center gap-3 rounded-full border border-accent-cyan/30 bg-white/5 px-4 py-2 shadow-[0_0_30px_rgba(34,211,238,0.12)] backdrop-blur-md transition-all duration-300 hover:border-accent-cyan/50 hover:shadow-[0_0_40px_rgba(34,211,238,0.2)]">
        <span class="h-2.5 w-2.5 rounded-full bg-accent-cyan shadow-[0_0_16px_rgba(34,211,238,0.9)] animate-pulse"></span>
        <span class="text-[10px] font-medium uppercase tracking-[0.28em] text-accent-cyan font-mono transition-colors group-hover:text-white">
          IEEE ComSoc Univalle
        </span>
      </div>

      <div class="flex justify-center">
        <Image src={logoWhite} alt="IEEE ComSoc Logo" class="hero-logo h-24 w-auto sm:h-32 lg:h-40 drop-shadow-[0_0_35px_rgba(34,211,238,0.3)]" loading="eager" decoding="async" fetchpriority="high" width={400} height={140} />
      </div>

      <p class="hero-copy mx-auto mt-5 max-w-3xl text-base font-light leading-relaxed text-text-secondary sm:text-xl">
        Liderando la innovación en redes de próxima generación, internet de las cosas (IoT), sistemas inalámbricos 5G/6G y comunicaciones cuánticas.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/convocatorias"
          aria-label="Unirse al equipo IEEE ComSoc Univalle"
          class="hero-cta-1 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-accent-blue-lighter to-accent-blue-darker px-7 py-3.5 font-semibold text-slate-950 shadow-[0_18px_40px_-18px_rgba(21,93,252,0.9)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_52px_-20px_rgba(34,211,238,0.9)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:-translate-y-0.5 sm:w-auto group"
        >
          <span class="group-hover:text-slate-900 transition-colors">Unirse al Equipo</span>
          <Icon name="material-symbols:group-add-rounded" class="h-4 w-4 transition-transform duration-300 group-hover:scale-110 group-hover:-translate-y-0.5" aria-hidden="true" />
        </a>

        <a
          href="/eventos"
          aria-label="Explorar eventos y actividades"
          class="hero-cta-2 inline-flex w-full items-center justify-center gap-1.5 rounded-xl px-7 py-3.5 font-medium text-accent-cyan hover:text-white transition-all duration-300 hover:bg-white/5 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-8px_rgba(34,211,238,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan sm:w-auto group"
        >
          <span>Explorar Eventos</span>
          <Icon name="material-symbols:arrow-forward-rounded" class="h-4 w-4 transition-transform duration-300 group-hover:scale-110 group-hover:-translate-x-0.5" aria-hidden="true" />
        </a>
      </div>

      <!-- Stats Section Component -->
      <StatsSection />
    </div>
  </div>

  <!-- Featured Event Banner -->
  {featuredEvent && (
    <FeaturedEventBanner event={featuredEvent} />
  )}

  <!-- Ecosystem / Technical Pillars -->
  <HeroPillars />

  <!-- Highlighted Projects Preview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 content-auto">
    <div class="proj-section-header flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
      <div>
        <div class="text-xs uppercase font-mono tracking-widest text-accent-purple mb-2 font-semibold transition-colors duration-300 hover:text-accent-purple-lighter group-hover:text-accent-blue">
          Investigación &amp; Desarrollo
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary">
          Proyectos Destacados del Capítulo
        </h2>
      </div>
      <a
        href="/proyectos"
        aria-label="Ver todos los proyectos de investigación e desarrollo"
        class="inline-flex items-center gap-2 text-sm font-semibold text-accent-cyan hover:text-accent-cyan transition-all duration-300 hover:underline group relative overflow-hidden"
      >
        <span>Ver todos los proyectos</span>
        <span class="absolute inset-0 bg-accent-cyan/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
        <span class="relative transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredProjects.map((proj, idx) => (
        // data-delay para el stagger CSS
        <div class={`proj-card glass-card rounded-2xl overflow-hidden relative border border-white/10 flex flex-col transition-[transform,box-shadow,border-color] duration-500 hover:border-accent-purple/50 hover:shadow-[0_24px_60px_-30px_rgba(168,85,247,0.25)] hover:-translate-y-2`} data-delay={String(idx + 1)}>
          <div class="aspect-video relative overflow-hidden bg-bg-secondary group/img">
            {proj.isRemoteProjectImage ? (
              <img
                src={proj.remoteImage ?? ''}
                alt={proj.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 group-hover/img:scale-105"
              />
            ) : proj.resolvedProjectImage ? (
              <Image
                src={proj.resolvedProjectImage}
                alt={proj.title}
                width={800}
                height={450}
                sizes="(max-width: 768px) 100vw, 50vw"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 group-hover/img:scale-105"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent-purple/15 via-bg-secondary to-accent-blue/15 text-xs font-mono uppercase tracking-[0.2em] text-text-secondary">
                Proyecto
              </div>
            )}
          </div>
          <!-- Scrim para legibilidad al hover -->
          <div class="absolute inset-0 bg-gradient-to-t from-bg-secondary via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover/img:opacity-40 pointer-events-none"></div>
          <div class="absolute top-0 left-0 p-4 flex gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-mono bg-black/70 backdrop-blur-md text-accent-cyan border border-accent-cyan/30 transition-all duration-300 hover:border-accent-cyan/60">
              {proj.category}
            </span>
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-black/70 backdrop-blur-md border transition-all duration-300 ${proj.estado === 'Activo' ? 'text-accent-emerald border-accent-emerald/30' : proj.estado === 'Completado' ? 'text-accent-blue border-accent-blue/30' : 'text-accent-yellow border-accent-yellow/30'}`}>
              <Icon name={proj.estado === 'Activo' ? 'material-symbols:check-circle-rounded' : proj.estado === 'Completado' ? 'material-symbols:verified-rounded' : 'material-symbols:pause-circle-rounded'} class="w-3.5 h-3.5" aria-hidden="true" />
              {proj.estado}
            </span>
          </div>
          <div class="p-6 flex flex-col justify-between grow">
            <div>
              <h3 
                class="text-xl font-bold text-text-primary transition-colors duration-300 hover:text-accent-cyan mb-2"
                style="text-align: justify;"
              >
                {proj.title}
              </h3>
              <p 
                class="text-sm text-text-secondary font-light leading-relaxed mb-4 transition-colors duration-300 hover:text-text-primary"
                style="text-align: justify;"
              >
                {proj.desc}
              </p>
              {proj.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {proj.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/5 text-text-secondary border border-white/10 transition-all duration-300 hover:border-accent-purple/30 hover:text-accent-cyan">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <a
              href={`/proyectos/${proj.id}`}
              aria-label={`Explorar proyecto ${proj.title}`}
              class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-accent-cyan hover:text-accent-cyan transition-all duration-300 hover:underline relative overflow-hidden"
            >
              <span>Explorar Proyecto</span>
              <span class="transition-transform duration-300 hover:translate-x-1">↗</span>
              <span class="absolute inset-0 bg-accent-cyan/10 opacity-0 transition-opacity duration-300 hover:opacity-100"></span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    // ── Scroll-reveal con IntersectionObserver ──────────────────────────────
    // Fallback inmediato si JS no carga o prefers-reduced-motion está activo
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    const revealTargets = document.querySelectorAll<HTMLElement>('.proj-section-header, .proj-card');

    if (!motionOK) {
      revealTargets.forEach(el => {
        el.style.opacity = '1';
        el.classList.remove('proj-section-header', 'proj-card');
      });
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      revealTargets.forEach(el => observer.observe(el));
    }
  </script>

  <!-- Nuestros Aliados Section -->
  <AliadosSection aliados={aliados} />

  <!-- Community CTA Section -->
  <CommunityCta />
</BaseLayout>
