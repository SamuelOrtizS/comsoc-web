---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CountdownTimer from '../components/CountdownTimer.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('eventos');
const upcomingEvents = allEvents.filter((ev) => ev.data.estado === 'Publicado');

// Pick a random featured event from upcoming (or all if none upcoming)
const eventPool = upcomingEvents.length > 0 ? upcomingEvents : allEvents;
const featuredEvent = eventPool[Math.floor(Math.random() * eventPool.length)];
const featuredEventSlug = featuredEvent ? featuredEvent.id.replace(/\/evento$/, '') : '';

// Load projects from content/proyectos — prefer destacado=true, then fill with others, shuffle, take 2
const allProyectos = await getCollection('proyectos');
const destacados = allProyectos.filter((p) => p.data.destacado);
const noDestacados = allProyectos.filter((p) => !p.data.destacado);
const projectPool = [...destacados.sort(() => Math.random() - 0.5), ...noDestacados.sort(() => Math.random() - 0.5)];
const featuredProjects = projectPool.slice(0, 2).map((p) => ({
  title: p.data.titulo,
  category: p.data.categoria,
  desc: p.data.descripcion,
  image: p.data.imagen,
  link: p.data.enlace ?? '/eventos',
  estado: p.data.estado,
  tags: p.data.tags ?? [],
}));

const allAliados = await getCollection('aliados');
const aliados = [...allAliados].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const pillars = [
  {
    title: '5G / 6G & Redes Móviles',
    desc: 'Arquitecturas de telecomunicaciones de última generación, Open RAN, beamforming y virtualización de redes NFV/SDN.',
    icon: '📡',
     color: 'from-[var(--color-accent-blue)]/20 to-[var(--color-accent-cyan)]/20',
     border: 'border-[var(--color-accent-cyan)]/30',
  },
  {
    title: 'IoT & Telemetría Satelital',
    desc: 'Sensores de bajo consumo, protocolos LPWAN (LoRaWAN, NB-IoT), procesamiento en el borde (Edge Computing) y telemetría MQTT.',
    icon: '🌐',
     color: 'from-[var(--color-accent-cyan)]/20 to-[var(--color-accent-emerald)]/20',
     border: 'border-[var(--color-accent-emerald)]/30',
  },
  {
    title: 'Comunicaciones Ópticas & Cuánticas',
    desc: 'Sistemas DWDM de alta capacidad, fotónica integrada y protocolos de distribución cuántica de claves (QKD).',
    icon: '💡',
    color: 'from-[var(--color-accent-purple)]/20 to-indigo-500/20',
    border: 'border-[var(--color-accent-purple)]/30',
  },
  {
    title: 'IA Aplicada a Redes',
    desc: 'Optimización predictiva de tráfico espectral, detección de anomalías y automatización inteligente de infraestructura de telecomunicaciones.',
    icon: '🧠',
    color: 'from-indigo-500/20 to-[var(--color-accent-blue)]/20',
    border: 'border-indigo-500/30',
  },
];


---

<BaseLayout title="IEEE ComSoc Univalle | Inicio">
  <!-- Hero Section -->
  <HeroSection />

  <!-- Featured Event & Live Countdown Spotlight -->
  {featuredEvent && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="relative rounded-3xl overflow-hidden glass-card p-6 sm:p-10 border border-[var(--color-accent-cyan)]/30">
<div class="absolute -right-20 -top-20 w-96 h-96 bg-[var(--color-accent-cyan)]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-accent-cyan)]/10 border border-[var(--color-accent-cyan)]/30 text-[var(--color-accent-cyan)] text-xs font-mono">
              ⭐ Evento Destacado
            </div>
            
            <h2 class="text-2xl sm:text-4xl font-extrabold text-[var(--color-text-primary)] leading-tight">
              {featuredEvent.data.titulo}
            </h2>
            
             <p class="text-text-secondary leading-relaxed font-light">
              {featuredEvent.data.descripcion}
            </p>

            <div class="flex flex-wrap gap-4 text-xs font-mono text-[var(--color-text-secondary)] pt-2 font-light">
              <div>📍 {featuredEvent.data.lugarNombre}</div>
              <div>🕒 {featuredEvent.data.horaInicio} - {featuredEvent.data.horaFin}</div>
            </div>

            <div class="pt-4 flex flex-wrap gap-3">
              <a
                href={`/eventos/${featuredEventSlug}`}
                  class="px-6 py-3 rounded-xl font-semibold text-[var(--color-text-primary)] bg-linear-to-r from-[var(--color-accent-blue)] to-[var(--color-accent-cyan)] shadow-lg shadow-[var(--color-accent-blue)]/25 hover:shadow-[var(--color-accent-blue)]/40 transition"
              >
                Inscribirse al Evento
              </a>
              <a
                href="/eventos"
                class="px-6 py-3 rounded-xl font-semibold text-[var(--color-text-secondary)] bg-white/5 hover:bg-white/10 border border-white/10 transition"
              >
                Ver todos los eventos
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <CountdownTimer
              targetDate={`${featuredEvent.data.fechaInicio}T${featuredEvent.data.horaInicio || '09:00'}:00`}
              eventName={featuredEvent.data.titulo}
            />
          </div>

        </div>
      </div>
    </section>
  )}

  <!-- Ecosystem / Technical Pillars -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="text-xs uppercase font-mono tracking-widest text-accent-cyan mb-2 font-semibold">
        Áreas de Especialización
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-text-primary)] mb-4">
        Ecosistema Tecnológico de IEEE ComSoc
      </h2>
      <p class="text-[var(--color-text-secondary)] text-sm sm:text-base font-light">
        Desarrollamos proyectos, capacitaciones e investigaciones orientadas a las áreas de mayor impacto en la industria moderna de telecomunicaciones.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {pillars.map((pillar) => (
        <div class={`glass-card rounded-2xl p-6 border ${pillar.border} relative group hover:-translate-y-2 transition-all duration-300`}>
          <div class="text-3xl mb-4 p-3 w-fit rounded-xl bg-white/5 border border-white/10">
            {pillar.icon}
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-2 group-hover:text-[var(--color-accent-cyan)] transition-colors">
            {pillar.title}
          </h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed font-light">
            {pillar.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Highlighted Projects Preview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-12 gap-4">
      <div>
        <div class="text-xs uppercase font-mono tracking-widest text-accent-purple mb-2 font-semibold">
          Investigación &amp; Desarrollo
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-text-primary)]">
          Proyectos Destacados del Capítulo
        </h2>
      </div>
      <a
        href="/proyectos"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)] group"
      >
        <span>Ver todos los proyectos</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredProjects.map((proj) => (
           <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group flex flex-col hover:border-[var(--color-accent-purple)]/40 transition-all duration-300">
          <div class="aspect-video relative overflow-hidden bg-slate-900">
            <img
              src={proj.image}
              alt={proj.title}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-3 left-3 flex gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-mono bg-black/70 backdrop-blur-md text-[var(--color-accent-cyan)] border border-[var(--color-accent-cyan)]/30">
                {proj.category}
              </span>
              <span class={`px-3 py-1 rounded-full text-xs font-mono bg-black/70 backdrop-blur-md border ${proj.estado === 'Activo' ? 'text-[var(--color-accent-emerald)] border-[var(--color-accent-emerald)]/30' : proj.estado === 'Completado' ? 'text-[var(--color-accent-blue)] border-[var(--color-accent-blue)]/30' : 'text-[var(--color-accent-yellow)] border-[var(--color-accent-yellow)]/30'}`}>
                {proj.estado === 'Activo' ? '🟢' : proj.estado === 'Completado' ? '✅' : '⏸'} {proj.estado}
              </span>
            </div>
          </div>
          <div class="p-6 flex flex-col justify-between grow">
            <div>
              <h3 class="text-xl font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-cyan)] transition-colors mb-2">
                {proj.title}
              </h3>
              <p class="text-sm text-[var(--color-text-secondary)] font-light leading-relaxed mb-4">
                {proj.desc}
              </p>
              {proj.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {proj.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/5 text-[var(--color-text-secondary)] border border-white/10">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <a
              href={proj.link}
              class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-cyan)] hover:text-[var(--color-accent-cyan)] font-mono"
            >
              Explorar Proyecto ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Nuestros Aliados -->
  {aliados.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/10">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="text-xs uppercase font-mono tracking-widest text-accent-cyan mb-2 font-semibold">
          Red de Colaboración
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-text-primary)] mb-4">
          Nuestros Aliados
        </h2>
        <p class="text-[var(--color-text-secondary)] text-sm font-light">
          Instituciones, empresas y organizaciones que nos acompañan en la misión de impulsar la ingeniería y las telecomunicaciones.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {aliados.map((aliado) => (
          <button
            type="button"
            class="aliado-card glass-card rounded-2xl p-6 border border-white/10 text-left group cursor-pointer hover:border-[var(--color-accent-cyan)]/40 hover:shadow-lg hover:shadow-[var(--color-accent-cyan)]/10 transition-all duration-300 w-full flex flex-col gap-4"
            data-aliado={JSON.stringify(aliado.data)}
            aria-label={`Conocer más sobre ${aliado.data.nombre}`}
          >
            <div class="flex items-center gap-4">
              {aliado.data.logo
                ? <img src={aliado.data.logo} alt={aliado.data.nombre} loading="lazy" decoding="async" class="h-10 w-auto object-contain brightness-0 invert opacity-70 group-hover:opacity-100 transition" />
                : <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-2xl">🤝</div>
              }
              <div>
                <span class="text-[10px] font-mono text-[var(--color-accent-cyan)] uppercase tracking-wider">{aliado.data.tipo}</span>
                <h3 class="text-sm font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-cyan)] transition">{aliado.data.nombre}</h3>
              </div>
            </div>
            <p class="text-xs text-[var(--color-text-secondary)] font-light leading-relaxed line-clamp-3 grow">{aliado.data.descripcion}</p>
            <div class="text-[10px] font-mono text-[var(--color-text-secondary)] border border-white/10 px-3 py-1 rounded-full self-start group-hover:border-[var(--color-accent-cyan)]/40 group-hover:text-[var(--color-accent-cyan)] transition">
              Conocer más →
            </div>
          </button>
        ))}
      </div>
    </section>
  )}

  <!-- Aliados Modal -->
  <div
    id="aliado-modal-overlay"
    class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xl flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-aliado-name"
  >
    <div id="aliado-modal" class="relative bg-[#0a0f2d] border border-white/15 rounded-3xl shadow-2xl shadow-blue-900/40 w-full max-w-md p-8 flex flex-col gap-5 translate-y-4 transition-all duration-300">
      <button
        id="aliado-modal-close"
        type="button"
        class="absolute top-4 right-4 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] p-2 rounded-xl hover:bg-white/10 transition"
        aria-label="Cerrar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="flex items-center gap-4">
        <div id="aliado-modal-logo" class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-3xl overflow-hidden shrink-0"></div>
        <div>
          <div id="aliado-modal-tipo" class="text-[10px] font-mono text-[var(--color-accent-cyan)] uppercase tracking-wider mb-0.5"></div>
          <h2 id="modal-aliado-name" class="text-lg font-extrabold text-[var(--color-text-primary)]"></h2>
        </div>
      </div>

      <div class="border-t border-white/10"></div>

      <div id="aliado-modal-desc" class="text-sm text-[var(--color-text-secondary)] font-light leading-relaxed"></div>
      <div id="aliado-modal-acerca" class="text-xs text-[var(--color-text-secondary)] font-light leading-relaxed hidden"></div>

      <div id="aliado-modal-contact" class="flex flex-col gap-2"></div>
      <div id="aliado-modal-links" class="flex flex-wrap gap-2"></div>
    </div>
  </div>

  <script>
    type AliadoData = {
      nombre: string;
      tipo: string;
      logo?: string;
      descripcion: string;
      acerca?: string;
      website?: string;
      email?: string;
      phone?: string;
      linkedin?: string;
      instagram?: string;
    };

    const aliadoOverlay = document.getElementById('aliado-modal-overlay') as HTMLElement;
    const aliadoModal   = document.getElementById('aliado-modal') as HTMLElement;
    const aliadoClose   = document.getElementById('aliado-modal-close') as HTMLButtonElement;

    function openAliadoModal(a: AliadoData) {
      const logoWrap = document.getElementById('aliado-modal-logo') as HTMLElement;
      logoWrap.innerHTML = a.logo
        ? `<img src="${a.logo}" alt="${a.nombre}" class="w-full h-full object-contain brightness-0 invert" />`
        : '🤝';

      (document.getElementById('aliado-modal-tipo') as HTMLElement).textContent = a.tipo;
      (document.getElementById('modal-aliado-name') as HTMLElement).textContent = a.nombre;
      (document.getElementById('aliado-modal-desc') as HTMLElement).textContent = a.descripcion;

      const acercaEl = document.getElementById('aliado-modal-acerca') as HTMLElement;
      if (a.acerca) {
        acercaEl.textContent = a.acerca;
        acercaEl.classList.remove('hidden');
      } else {
        acercaEl.classList.add('hidden');
      }

      const contactEl = document.getElementById('aliado-modal-contact') as HTMLElement;
      contactEl.innerHTML = '';
      if (a.email) {
        contactEl.insertAdjacentHTML('beforeend', `<a href="mailto:${a.email}" class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-cyan)] hover:border-[var(--color-accent-cyan)]/40 transition text-xs font-mono"><svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>${a.email}</a>`);
      }
      if (a.phone) {
        contactEl.insertAdjacentHTML('beforeend', `<a href="tel:${a.phone}" class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-cyan)] hover:border-[var(--color-accent-cyan)]/40 transition text-xs font-mono"><svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>${a.phone}</a>`);
      }

      const linksEl = document.getElementById('aliado-modal-links') as HTMLElement;
      linksEl.innerHTML = '';
      const socials: { key: keyof AliadoData; label: string; color: string }[] = [
        { key: 'website',   label: 'Sitio Web',  color: 'bg-[var(--color-accent-emerald)]/20 text-[var(--color-accent-emerald)] border-[var(--color-accent-emerald)]/30 hover:bg-[var(--color-accent-emerald)]/40' },
        { key: 'linkedin',  label: 'LinkedIn',   color: 'bg-[var(--color-accent-blue)]/20 text-[var(--color-accent-blue)] border-[var(--color-accent-blue)]/30 hover:bg-[var(--color-accent-blue)]/40' },
        { key: 'instagram', label: 'Instagram',  color: 'bg-[var(--color-accent-rose)]/20 text-[var(--color-accent-rose)] border-[var(--color-accent-rose)]/30 hover:bg-[var(--color-accent-rose)]/40' },
      ];
      socials.forEach(({ key, label, color }) => {
        const url = a[key] as string | undefined;
        if (url) linksEl.insertAdjacentHTML('beforeend', `<a href="${url}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition ${color}">${label} ↗</a>`);
      });
      if (linksEl.innerHTML) linksEl.classList.remove('hidden');
      else linksEl.classList.add('hidden');

      aliadoOverlay.classList.remove('opacity-0', 'pointer-events-none');
      aliadoOverlay.classList.add('opacity-100', 'pointer-events-auto');
      aliadoModal.classList.remove('translate-y-4');
      document.body.style.overflow = 'hidden';
    }

    function closeAliadoModal() {
      aliadoOverlay.classList.add('opacity-0', 'pointer-events-none');
      aliadoOverlay.classList.remove('opacity-100', 'pointer-events-auto');
      aliadoModal.classList.add('translate-y-4');
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLButtonElement>('.aliado-card').forEach((card) => {
      card.addEventListener('click', () => {
        const raw = card.getAttribute('data-aliado');
        if (raw) openAliadoModal(JSON.parse(raw) as AliadoData);
      });
    });
    aliadoClose.addEventListener('click', closeAliadoModal);
    aliadoOverlay.addEventListener('click', (e) => { if (e.target === aliadoOverlay) closeAliadoModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAliadoModal(); });
  </script>

  <!-- Join CTA Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="glass-card rounded-3xl p-8 sm:p-12 text-center relative overflow-hidden border border-[var(--color-accent-purple)]/30 bg-linear-to-r from-blue-900/20 via-[var(--color-accent-purple)]/20 to-cyan-900/20">
      <div class="max-w-2xl mx-auto space-y-6 relative z-10">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text-primary)]">
          ¿Listo para liderar el futuro de las telecomunicaciones?
        </h2>
        <p class="text-[var(--color-text-secondary)] text-sm sm:text-base font-light leading-relaxed">
          Conéctate con mentores de la industria, accede a recursos globales de IEEE, organiza congresos internacionales y potencia tu carrera profesional.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a
            href="/convocatorias"
            class="px-8 py-3.5 rounded-xl font-semibold text-[var(--color-text-primary)] bg-linear-to-r from-accent-blue to-accent-cyan shadow-lg shadow-[var(--color-accent-blue)]/25 hover:scale-[1.02] transition"
          >
            Ver Convocatorias Abiertas
          </a>
          <a
            href="/nosotros"
            class="px-8 py-3.5 rounded-xl font-semibold text-[var(--color-text-secondary)] bg-white/5 hover:bg-white/10 border border-white/10 transition"
          >
            Conoce Más Sobre Nosotros
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
