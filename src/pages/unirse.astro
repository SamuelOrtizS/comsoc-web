---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    step: 'Paso 01',
    title: 'Crea tu cuenta en IEEE',
    description: 'Ingresa al portal oficial de IEEE.org y regístrate con tu correo universitario o personal para obtener tu identificador global.',
    link: 'https://www.ieee.org',
    linkText: 'Ir al portal de IEEE',
  },
  {
    step: 'Paso 02',
    title: 'Adquiere tu Membresía Estudiantil IEEE',
    description: 'Selecciona la opción "Student Membership". Si eres estudiante de pregrado o posgrado, cuentas con tarifa reducida especial.',
    link: 'https://www.ieee.org/membership/join/index.html',
    linkText: 'Ver tarifas de estudiante',
  },
  {
    step: 'Paso 03',
    title: 'Añade la Sociedad "IEEE ComSoc"',
    description: 'En la sección de Sociedades Técnicas, selecciona "IEEE Communications Society (ComSoc)" para acceder a recursos y publicaciones.',
    link: 'https://www.comsoc.org/membership',
    linkText: 'Beneficios ComSoc Global',
  },
  {
    step: 'Paso 04',
    title: 'Reporta tu membresía al Capítulo',
    description: 'Escríbenos al WhatsApp oficial o contacta a la directiva con tu IEEE Member ID para integrarte al padrón activo y a los grupos de trabajo.',
    link: 'https://chat.whatsapp.com',
    linkText: 'Notificar por WhatsApp',
  },
];

const faqs = [
  {
    q: '¿Es obligatorio tener membresía de IEEE para participar en ComSoc?',
    a: '¡No! Puedes participar como colaborador en nuestros proyectos, talleres y grupos de estudio sin necesidad de contar con membresía formal. La membresía oficial de IEEE ComSoc te otorga certificados internacionales, descuentos en conferencias globales y acceso a IEEE Xplore, pero la motivación por aprender y colaborar es lo fundamental para integrarte a la comunidad.',
  },
  {
    q: '¿Qué requisitos necesito para unirme como colaborador?',
    a: 'Estar matriculado en la universidad o tener interés en áreas afines (telecomunicaciones, electrónica, sistemas, software, etc.), contar con disposición para participar en reuniones y proyectos, y compromiso para aprender de forma colaborativa.',
  },
  {
    q: '¿Qué beneficios obtengo al tener la membresía oficial de IEEE ComSoc?',
    a: 'Acceso completo a la biblioteca digital IEEE Xplore, membresía en IEEE ComSoc con acceso a IEEE Communications Magazine, tarifas preferenciales en congresos internacionales (IEEE GLOBECOM, IEEE ICC), postulación a becas y premios globales, y alias de correo institucional @ieee.org con Google Workspace.',
  },
  {
    q: '¿Cuánto tiempo a la semana debo dedicar si me uno a un proyecto?',
    a: 'Generalmente entre 2 a 5 horas semanales, dependiendo del rol asignado y los objetivos del equipo. Mantenemos flexibilidad total entendiendo las responsabilidades y horarios académicos.',
  },
  {
    q: '¿Cómo puedo ponerme en contacto con el equipo?',
    a: 'La forma más directa es unirte a nuestra comunidad general de WhatsApp a través del enlace en esta página o escribirnos mediante nuestras redes sociales y correo oficial.',
  },
];
---

<BaseLayout
  title="Únete a IEEE ComSoc Univalle | Membresías y Colaboradores"
  description="Descubre cómo unirte al Capítulo Estudiantil IEEE ComSoc, adquirir tu membresía oficial o participar como colaborador en proyectos de telecomunicaciones y redes."
>
  <div class="relative overflow-hidden pb-24 pt-12">
    <!-- Hero Section -->
    <section class="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent-cyan/30 bg-accent-cyan/10 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-cyan font-mono shadow-[0_0_18px_rgba(34,211,238,0.12)]">
        <span class="h-2 w-2 rounded-full bg-accent-cyan shadow-[0_0_12px_rgba(34,211,238,0.9)]" aria-hidden="true"></span>
        Comunidad y membresías
      </div>

      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-[-0.04em] text-text-primary sm:text-5xl lg:text-6xl">
        Forma parte de <span class="text-accent-cyan">IEEE ComSoc</span>
      </h1>

      <p class="mx-auto mt-5 max-w-3xl text-base leading-relaxed text-text-secondary font-light sm:text-lg lg:text-xl">
        Aprende, construye proyectos reales e impulsa tu futuro profesional en comunicaciones digitales, IoT, 5G/6G, redes ópticas y tecnologías satelitales.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="https://chat.whatsapp.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Unirse al grupo de WhatsApp de IEEE ComSoc Univalle (abre en una nueva ventana)"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 rounded-2xl bg-accent-blue hover:bg-accent-cyan px-7 py-3.5 font-bold text-white transition-all duration-300 hover:-translate-y-0.5 shadow-[0_18px_40px_-18px_rgba(21,93,252,0.9)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          <Icon name="mdi:whatsapp" class="h-5 w-5 fill-current" aria-hidden="true" />
          <span>Unirse al grupo de WhatsApp</span>
        </a>

        <a
          href="#membresia"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-6 py-3.5 font-medium text-text-secondary transition-all duration-200 hover:border-accent-cyan/40 hover:bg-white/10 hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          <span>Ver ruta de membresía</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <!-- Highlight Banner: Colaborador sin membresía -->
    <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-bg-secondary p-8 backdrop-blur-md transition-all duration-300 sm:p-10">
        <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-accent-blue/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-20 -left-12 h-64 w-64 rounded-full bg-accent-cyan/10 blur-3xl" aria-hidden="true"></div>

        <div class="relative z-10 grid items-center gap-8 lg:grid-cols-[1.6fr_0.9fr]">
          <div class="space-y-4">
            <div class="inline-flex items-center gap-2 rounded-full border border-accent-emerald/30 bg-accent-emerald/10 px-3 py-1 text-[10px] font-mono uppercase tracking-[0.14em] text-accent-emerald">
              <Icon name="material-symbols:check-circle-outline-rounded" class="h-3.5 w-3.5" aria-hidden="true" />
              Acceso abierto para todos
            </div>
            <h2 class="text-2xl font-bold tracking-[-0.03em] text-text-primary sm:text-3xl">
              ¿No cuentas con membresía IEEE? ¡No te preocupes!
            </h2>
            <p class="max-w-2xl text-base leading-relaxed text-text-secondary font-light">
              En nuestro capítulo creemos que el talento y las ganas de superarse no dependen de un pago. <strong class="font-semibold text-text-primary">Puedes participar activamente como colaborador</strong> en proyectos, talleres prácticos y actividades técnicas sin costo.
            </p>
            <p class="text-sm text-text-secondary font-light">
              <span class="font-semibold text-text-primary">Lo más importante:</span> curiosidad técnica, motivación por aprender y compromiso con el trabajo en equipo.
            </p>
          </div>

          <div class="glass-card rounded-2xl border border-white/10 bg-bg-primary/60 p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent-blue/20 text-accent-cyan border border-accent-cyan/20">
              <Icon name="material-symbols:verified-rounded" class="h-6 w-6" aria-hidden="true" />
            </div>
            <h3 class="text-lg font-bold text-text-primary">Primer paso para colaborar</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary font-light">
              Entra a nuestra comunidad de mensajería, preséntate con tus intereses y únete a las reuniones abiertas.
            </p>
            <a
              href="https://chat.whatsapp.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Conectarme al WhatsApp de IEEE ComSoc Univalle (abre en una nueva ventana)"
              class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-text-primary transition-all duration-200 hover:border-accent-cyan/40 hover:bg-white/10 hover:text-accent-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
            >
              <span>Conectarme al WhatsApp</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Ruta de Membresía Oficial -->
    <section id="membresia" class="mx-auto mt-24 max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-accent-cyan/20 bg-accent-cyan/5 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-cyan font-mono">
          Ruta de afiliación oficial
        </div>
        <h2 class="text-3xl font-bold tracking-[-0.03em] text-text-primary sm:text-4xl">
          Paso a paso para adquirir tu membresía IEEE ComSoc
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-secondary font-light">
          Sigue esta guía para unirte formalmente a la sociedad técnica de comunicaciones más prestigiosa del mundo.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {steps.map((item) => (
          <article class="glass-card group relative flex flex-col justify-between rounded-2xl border border-white/10 p-6 transition-all duration-300">
            <div>
              <div class="mb-4 flex items-center justify-between">
                <span class="inline-flex items-center rounded-full border border-accent-cyan/30 bg-accent-cyan/10 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.14em] text-accent-cyan">
                  {item.step}
                </span>
                <span class="text-[10px] font-mono uppercase tracking-[0.14em] text-text-secondary/70">
                  Requerido
                </span>
              </div>

              <h3 class="mb-2 text-xl font-semibold tracking-tight text-text-primary transition-colors group-hover:text-accent-cyan">
                {item.title}
              </h3>
              <p class="text-sm leading-relaxed text-text-secondary font-light">
                {item.description}
              </p>
            </div>

            <div class="mt-6 border-t border-white/10 pt-4">
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.linkText} (abre en una nueva ventana)`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-cyan transition-colors hover:text-accent-cyan-lighter focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
              >
                <span>{item.linkText}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Convocatorias Teaser Banner -->
    <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-md sm:p-8">
        <div class="space-y-1 text-center sm:text-left">
          <div class="inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-[0.14em] text-accent-purple">
            <Icon name="material-symbols:group-add-rounded" class="h-4 w-4" aria-hidden="true" />
            Liderazgo & Equipos
          </div>
          <h3 class="text-xl font-bold text-text-primary">¿Te interesa asumir un rol directivo o técnico?</h3>
          <p class="text-sm text-text-secondary font-light">
            Revisa las convocatorias de voluntariado abiertas para comités de proyectos, marketing, logística e investigación.
          </p>
        </div>
        <a
          href="/convocatorias"
          class="shrink-0 inline-flex items-center gap-2 rounded-xl border border-accent-purple/30 bg-accent-purple/10 px-5 py-2.5 text-sm font-semibold text-accent-purple transition-all duration-200 hover:border-accent-purple hover:bg-accent-purple/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-purple focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          <span>Ver convocatorias</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Preguntas Frecuentes -->
    <section class="mx-auto mt-24 max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-accent-purple/20 bg-accent-purple/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-purple font-mono">
          Dudas frecuentes
        </div>
        <h2 class="text-3xl font-bold tracking-[-0.03em] text-text-primary sm:text-4xl">
          Preguntas frecuentes
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="glass-card group rounded-2xl border border-white/10 p-5 transition-colors">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text-primary text-base sm:text-lg">
              <span>{faq.q}</span>
              <Icon name="material-symbols:keyboard-arrow-down-rounded" class="h-5 w-5 shrink-0 text-text-secondary transition-transform duration-200 group-open:rotate-180" aria-hidden="true" />
            </summary>
            <p class="mt-4 border-t border-white/10 pt-4 text-sm leading-relaxed text-text-secondary font-light sm:text-base">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Final -->
    <section class="mx-auto mt-24 max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-bg-secondary p-8 shadow-[0_24px_55px_-30px_rgba(21,93,252,0.4)] sm:p-12">
        <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-48 w-96 rounded-full bg-accent-blue/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative z-10">
          <h2 class="text-2xl font-bold tracking-[-0.03em] text-text-primary sm:text-3xl">
            ¿Listo para dar el siguiente paso en tu carrera?
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-text-secondary font-light">
            Únete hoy a nuestra comunidad universitaria y colabora en iniciativas que transforman el aprendizaje en ingeniería.
          </p>
          <a
            href="https://chat.whatsapp.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Únete a nuestro WhatsApp oficial de IEEE ComSoc Univalle (abre en una nueva ventana)"
            class="mt-8 inline-flex items-center justify-center gap-2.5 rounded-2xl bg-accent-blue hover:bg-accent-cyan px-8 py-4 font-bold text-white shadow-[0_18px_40px_-18px_rgba(21,93,252,0.9)] transition-all duration-300 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
          >
            <Icon name="mdi:whatsapp" class="h-5 w-5 fill-current" aria-hidden="true" />
            <span>¡Únete a nuestro WhatsApp oficial!</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

