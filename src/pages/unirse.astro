---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    step: 'Paso 1',
    title: 'Crea tu cuenta en IEEE',
    description: 'Ingresa al portal oficial de IEEE.org y regístrate con tu correo universitario o personal.',
    link: 'https://www.ieee.org',
    linkText: 'Ir al portal de IEEE',
  },
  {
    step: 'Paso 2',
    title: 'Adquiere tu Membresía Estudiantil IEEE',
    description: 'Selecciona la opción "Student Membership". Si estás en Perú u otra región elegible, cuentas con tarifa reducida especial de estudiante.',
    link: 'https://www.ieee.org/membership/join/index.html',
    linkText: 'Ver tarifas de estudiante',
  },
  {
    step: 'Paso 3',
    title: 'Añade la Sociedad "IEEE ComSoc"',
    description: 'En la sección de Sociedades Técnicas, selecciona "IEEE Communications Society (ComSoc)". Tendrás acceso inmediato a webinars, revistas técnicas y recursos globales.',
    link: 'https://www.comsoc.org/membership',
    linkText: 'Beneficios ComSoc Global',
  },
  {
    step: 'Paso 4',
    title: 'Reporta tu número de membresía al Capítulo',
    description: 'Escríbenos al WhatsApp oficial o llena el formulario del capítulo con tu IEEE Member ID para agregarte al padrón activo y a los grupos de trabajo oficiales.',
    link: 'https://chat.whatsapp.com',
    linkText: 'Notificar por WhatsApp',
  },
];

const faqs = [
  {
    q: '¿Es obligatorio tener membresía de IEEE para participar en ComSoc?',
    a: '¡No! Puedes participar como colaborador en nuestros proyectos, talleres y grupos de estudio sin necesidad de contar con membresía. La membresía oficial de IEEE ComSoc te otorga certificados internacionales, descuentos en conferencias globales y acceso a IEEE Xplore, pero las ganas de aprender y colaborar son lo fundamental para ser parte de la comunidad.',
  },
  {
    q: '¿Qué requisitos necesito para unirme como colaborador?',
    a: 'Estar matriculado en la universidad o tener interés en áreas de ingeniería (telecomunicaciones, electrónica, sistemas, software, etc.), tener disposición para participar en reuniones y proyectos, y muchas ganas de aprender de forma autodidacta y colaborativa.',
  },
  {
    q: '¿Qué beneficios obtengo al tener la membresía oficial de IEEE ComSoc?',
    a: 'Acceso a la biblioteca digital IEEE Xplore, membresía en IEEE ComSoc con acceso a IEEE Communications Magazine, descuentos para certificaciones y congresos (como IEEE GLOBECOM e IEEE ICC), postulación a becas y premios internacionales, y correo institucional @ieee.org con Google Workspace.',
  },
  {
    q: '¿Cuánto tiempo a la semana debo dedicar si me uno a un proyecto?',
    a: 'Generalmente entre 2 a 5 horas semanales, dependiendo del rol que elijas en el equipo y las metas de cada sprint. Somos flexibles y entendemos los horarios académicos.',
  },
  {
    q: '¿Cómo puedo ponerme en contacto con el equipo?',
    a: 'La forma más rápida es unirte a nuestra comunidad general de WhatsApp a través del enlace de esta página o escribirnos por nuestras redes sociales oficiales.',
  },
];
---

<BaseLayout
  title="Únete a IEEE ComSoc Univalle | Membresías y Colaboradores"
  description="Descubre cómo unirte al Capítulo Estudiantil IEEE ComSoc, adquirir tu membresía oficial o participar como colaborador en proyectos de telecomunicaciones y redes."
>
  <div class="relative overflow-hidden pb-24 pt-12">
    <div class="absolute inset-x-0 top-0 h-64" aria-hidden="true"></div>

    <section class="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent-cyan/30 bg-accent-cyan/10 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent-cyan font-mono shadow-[0_0_18px_rgba(34,211,238,0.12)]">
        <span class="h-2 w-2 rounded-full bg-accent-cyan shadow-[0_0_12px_rgba(34,211,238,0.9)]"></span>
        Comunidad y membresías
      </div>

      <h1 class="mx-auto max-w-4xl text-4xl font-black tracking-[-0.06em] text-text-primary sm:text-5xl lg:text-6xl">
        Forma parte de <span class="text-accent-cyan">IEEE ComSoc</span>
      </h1>

      <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-text-secondary font-light sm:text-xl">
        Aprende, construye proyectos reales e impulsa tu futuro profesional en comunicaciones digitales, IoT, 5G/6G y ciberseguridad.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://chat.whatsapp.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Unirse al grupo de WhatsApp de IEEE ComSoc Univalle (abre en una nueva ventana)"
          class="inline-flex items-center gap-2.5 rounded-xl bg-linear-to-r from-accent-emerald to-accent-cyan px-6 py-3.5 font-bold text-slate-950 shadow-[0_18px_40px_-20px_rgba(52,211,153,0.8)] transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          <Icon name="mdi:whatsapp" class="h-5 w-5 fill-currentColor" aria-hidden="true" />
          Unirse al grupo de WhatsApp
        </a>

        <a
          href="#membresia"
          class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-3.5 font-medium text-text-primary transition-colors hover:border-accent-cyan/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          Ver guía de membresía
        </a>
      </div>
    </section>

    <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-[30px] border border-accent-cyan/25 bg-linear-to-br from-accent-blue/20 via-bg-secondary to-accent-cyan/10 p-8 shadow-[0_30px_80px_-40px_rgba(34,211,238,0.7)] sm:p-10">
        <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-accent-cyan/20 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -bottom-20 -left-12 h-52 w-52 rounded-full bg-accent-blue/20 blur-3xl" aria-hidden="true"></div>

        <div class="relative z-10 grid items-center gap-8 lg:grid-cols-[1.6fr_0.9fr]">
          <div class="space-y-5">
            <h2 class="text-2xl font-bold tracking-[-0.05em] text-text-primary sm:text-3xl">
              ¿No cuentas con membresía IEEE? ¡No te preocupes!
            </h2>
            <p class="max-w-2xl text-base leading-relaxed text-text-secondary font-light sm:text-lg">
              En nuestro capítulo creemos que el talento y las ganas de superarse no dependen de un pago. <span class="font-semibold text-text-primary">Puedes participar activamente como colaborador</span> en proyectos, talleres y actividades técnicas.
            </p>
            <p class="text-text-secondary text-sm sm:text-base">
              <span class="font-semibold text-text-primary">Lo más importante:</span> tener curiosidad técnica, ganas de aprender y compromiso con el trabajo en equipo.
            </p>
          </div>

          <div class="rounded-[24px] border border-white/10 bg-white/5 p-6 shadow-[0_18px_40px_-30px_rgba(15,23,42,0.9)]">
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-linear-to-tr from-accent-blue to-accent-cyan text-2xl shadow-[0_0_30px_rgba(34,211,238,0.2)]">
              <Icon name="material-symbols:verified-rounded" class="h-6 w-6 fill-current text-slate-950" aria-hidden="true" />
            </div>
            <h3 class="text-lg font-bold text-text-primary">Primer paso para colaborar</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">
              Entra a nuestra comunidad de mensajería y preséntate para comenzar a participar.
            </p>
            <a
              href="https://chat.whatsapp.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Conectarme al WhatsApp de IEEE ComSoc Univalle (abre en una nueva ventana)"
              class="mt-5 inline-flex w-full items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-text-primary transition-colors hover:border-accent-cyan/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
            >
              Conectarme al WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="membresia" class="mx-auto mt-28 max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <div class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-accent-cyan font-mono">
          Ruta de afiliación oficial
        </div>
        <h2 class="text-3xl font-black tracking-[-0.05em] text-text-primary sm:text-4xl">
          Paso a paso para adquirir tu membresía IEEE ComSoc
        </h2>
        <p class="mt-3 text-base leading-relaxed text-text-secondary font-light">
          Sigue esta guía para unirte formalmente a la sociedad de comunicaciones más grande del mundo.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {steps.map((item) => (
          <article class="group relative overflow-hidden rounded-[24px] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.92),rgba(5,8,22,0.96))] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 hover:shadow-[0_24px_55px_-35px_rgba(34,211,238,0.7)]">
            <div class="mb-5 flex items-center justify-between">
              <span class="inline-flex items-center rounded-full border border-accent-cyan/20 bg-accent-cyan/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-accent-cyan font-mono">
                {item.step}
              </span>
              <span class="text-[10px] uppercase tracking-[0.16em] text-text-secondary font-mono">
                Requerido
              </span>
            </div>

            <h3 class="mb-3 text-xl font-bold tracking-[-0.04em] text-text-primary transition-colors group-hover:text-accent-cyan">
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-text-secondary font-light">
              {item.description}
            </p>

            <div class="mt-6 border-t border-white/10 pt-4">
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.linkText} (abre en una nueva ventana)`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-cyan transition-colors hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
              >
                <span>{item.linkText}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto mt-28 max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <div class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-accent-purple font-mono">
          Dudas frecuentes
        </div>
        <h2 class="text-3xl font-black tracking-[-0.05em] text-text-primary sm:text-4xl">
          Preguntas frecuentes
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-[18px] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.9),rgba(5,8,22,0.96))] p-5 transition-colors hover:border-accent-cyan/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text-primary text-base sm:text-lg">
              <span>{faq.q}</span>
              <span class="ml-4 text-lg text-text-secondary transition-transform duration-200 group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <p class="mt-4 border-t border-white/10 pt-4 text-sm leading-relaxed text-text-secondary font-light sm:text-base">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <section class="mx-auto mt-24 max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="rounded-[28px] border border-white/10 bg-linear-to-r from-accent-blue/20 via-accent-cyan/10 to-accent-purple/20 p-8 shadow-[0_25px_70px_-35px_rgba(21,93,252,0.7)] sm:p-12">
        <h2 class="text-2xl font-black tracking-[-0.05em] text-text-primary sm:text-3xl">
          ¿Listo para dar el siguiente paso en tu carrera?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-text-secondary font-light">
          Únete hoy a nuestra comunidad universitaria y colabora en proyectos que impulsan el futuro de las telecomunicaciones.
        </p>
        <a
          href="https://chat.whatsapp.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Únete a nuestro WhatsApp oficial de IEEE ComSoc Univalle (abre en una nueva ventana)"
          class="mt-8 inline-flex items-center justify-center rounded-xl bg-linear-to-r from-accent-blue to-accent-cyan px-8 py-4 font-bold text-slate-950 shadow-[0_20px_50px_-20px_rgba(34,211,238,0.8)] transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        >
          ¡Únete a nuestro WhatsApp oficial!
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
