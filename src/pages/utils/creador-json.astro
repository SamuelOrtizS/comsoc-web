  const dynamicFormFieldsContainer = document.getElementById('dynamic-form-fields');
  const jsonCodeOutput = document.getElementById('json-code-output');
  const targetPathDisplay = document.getElementById('target-path-display');
  const customFilenameInput = document.getElementById('custom-filename-input');
  const currentCollectionTitle = document.getElementById('current-collection-title');
  const currentCollectionDesc = document.getElementById('current-collection-desc');
  const jsonStatus = document.getElementById('json-status');
  const btnCopyJson = document.getElementById('btn-copy-json');
  const btnDownloadJson = document.getElementById('btn-download-json');
  const btnCopyPath = document.getElementById('btn-copy-path');
  const btnLoadSample = document.getElementById('btn-load-sample');
  const btnResetForm = document.getElementById('btn-reset-form');
  const fileImportInput = document.getElementById('file-import-input');
  const toast = document.getElementById('toast');
  const toastMessage = document.getElementById('toast-message');

  function showToast(msg) {
    if (!toast) return;
    toastMessage.textContent = msg;
    toast.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
    }, 2400);
  }

  function slugify(text) {
    return text
      .toString()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim()
      .replace(/\s+/g, '-')
      .replace(/[^\w-]+/g, '')
      .replace(/--+/g, '-');
  }

  function updateTargetPathAndFilename() {
    let slug = '';
    const mainTitle = formData.titulo || formData.name || formData.nombre || 'nuevo-elemento';
    slug = slugify(mainTitle) || 'item';

    if (currentCollectionKey === 'eventos') {
      customFilenameInput.value = 'evento.json';
      targetPathDisplay.innerHTML = `src/content/eventos/<span class="text-accent-cyan">${slug}</span>/evento.json`;
    } else {
      const filename = `${slug}.json`;
      customFilenameInput.value = filename;
      targetPathDisplay.innerHTML = `src/content/${currentCollectionKey}/<span class="text-accent-cyan">${filename}</span>`;
    }
  }

  function renderJSON() {
    // Clean null / undefined / empty string values if optional
    const cleanObject = {};
    const schema = SCHEMAS[currentCollectionKey];

    for (const field of schema.fields) {
      const val = formData[field.name];
      if (val !== undefined && val !== null) {
        if (field.type === 'number') {
          cleanObject[field.name] = Number(val);
        } else if (field.type === 'boolean') {
          cleanObject[field.name] = Boolean(val);
        } else if (typeof val === 'string') {
          if (val.trim() !== '' || field.required) {
            cleanObject[field.name] = val.trim();
          }
        } else if (Array.isArray(val)) {
          if (val.length > 0 || field.required) {
            cleanObject[field.name] = val;
          }
        } else {
          cleanObject[field.name] = val;
        }
      }
    }

    const formatted = JSON.stringify(cleanObject, null, 2);
    jsonCodeOutput.textContent = formatted;

    // Validate required fields
    let missing = [];
    for (const field of schema.fields) {
      if (field.required) {
        const val = cleanObject[field.name];
        if (val === undefined || val === null || (typeof val === 'string' && val.trim() === '') || (Array.isArray(val) && val.length === 0)) {
          missing.push(field.label);
        }
      }
    }

    if (missing.length === 0) {
      jsonStatus.innerHTML = '<span class="h-1.5 w-1.5 rounded-full bg-accent-emerald animate-pulse"></span> Estructura válida';
      jsonStatus.className = 'flex items-center gap-1.5 text-xs font-mono text-accent-emerald font-semibold';
    } else {
      jsonStatus.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-accent-amber animate-pulse"></span> Falta: ${missing[0]}`;
      jsonStatus.className = 'flex items-center gap-1.5 text-xs font-mono text-accent-amber font-semibold';
    }
  }

  function renderForm() {
    const schema = SCHEMAS[currentCollectionKey];
    currentCollectionTitle.textContent = schema.title;
    currentCollectionDesc.textContent = schema.description;
    dynamicFormFieldsContainer.innerHTML = '';

    schema.fields.forEach((field) => {
      const fieldWrapper = document.createElement('div');
      fieldWrapper.className = 'glass-card rounded-2xl border border-white/10 bg-bg-secondary/30 p-4 sm:p-5 flex flex-col gap-2.5 backdrop-blur-md';

      const labelRow = document.createElement('div');
      labelRow.className = 'flex items-center justify-between';

      const label = document.createElement('label');
      label.className = 'text-xs font-bold uppercase tracking-wider text-text-primary font-mono flex items-center gap-1.5';
      label.setAttribute('for', `field-${field.name}`);
      label.innerHTML = `${field.label} ${field.required ? '<span class="text-accent-cyan font-normal" title="Campo requerido">*</span>' : '<span class="text-text-secondary/60 text-[10px] font-normal tracking-normal uppercase">(Opcional)</span>'}`;
      labelRow.appendChild(label);
      fieldWrapper.appendChild(labelRow);

      const val = formData[field.name];

      if (field.type === 'text' || field.type === 'url') {
        const input = document.createElement('input');
        input.type = field.type === 'url' ? 'url' : 'text';
        input.id = `field-${field.name}`;
        input.className = 'w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-secondary/40 focus:border-accent-cyan focus:outline-none focus:ring-1 focus:ring-accent-cyan font-sans transition';
        input.placeholder = field.placeholder || '';
        input.value = val !== undefined ? val : '';
        input.addEventListener('input', (e) => {
          formData[field.name] = e.target.value;
          updateTargetPathAndFilename();
          renderJSON();
        });
        fieldWrapper.appendChild(input);
      } else if (field.type === 'number') {
        const input = document.createElement('input');
        input.type = 'number';
        input.id = `field-${field.name}`;
        input.className = 'w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-secondary/40 focus:border-accent-cyan focus:outline-none focus:ring-1 focus:ring-accent-cyan font-mono transition';
        input.value = val !== undefined ? val : (field.default ?? 0);
        input.addEventListener('input', (e) => {
          formData[field.name] = e.target.value === '' ? undefined : Number(e.target.value);
          renderJSON();
        });
        fieldWrapper.appendChild(input);
      } else if (field.type === 'date') {
        const input = document.createElement('input');
        input.type = 'date';
        input.id = `field-${field.name}`;
        input.className = 'w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-secondary/40 focus:border-accent-cyan focus:outline-none focus:ring-1 focus:ring-accent-cyan font-mono transition';
        input.value = val || '';
        input.addEventListener('input', (e) => {
          formData[field.name] = e.target.value;
          renderJSON();
        });
        fieldWrapper.appendChild(input);
      } else if (field.type === 'time') {
        const input = document.createElement('input');
        input.type = 'time';
        input.id = `field-${field.name}`;
        input.className = 'w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-secondary/40 focus:border-accent-cyan focus:outline-none focus:ring-1 focus:ring-accent-cyan font-mono transition';
        input.value = val || '';
        input.addEventListener('input', (e) => {
          formData[field.name] = e.target.value;
          renderJSON();
        });
        fieldWrapper.appendChild(input);
      } else if (field.type === 'textarea') {
        const textarea = document.createElement('textarea');
        textarea.id = `field-${field.name}`;
        textarea.rows = 3;
        textarea.className = 'w-full rounded-xl border border-white/10 bg-black/40 px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-secondary/40 focus:border-accent-cyan focus:outline-none focus:ring-1 focus:ring-accent-cyan font-sans transition resize-y leading-relaxed';
        textarea.placeholder = field.placeholder || 'Escribe la descripción...';
        textarea.value = val || '';
        textarea.addEventListener('input', (e) => {
          formData[field.name] = e.target.value;
          renderJSON();
        });
        fieldWrapper.appendChild(textarea);
      } else if (field.type === 'select') {
        const select = document.createElement('select');
        select.id = `field-${field.name}`;
        select.className = 'w-full rounded-xl border border-white/10 bg-[#0a0f24] px-3.5 py-2.5 text-sm text-text-primary focus:border-accent-cyan focus:outline-none focus:ring-1 focus:ring-accent-cyan font-sans transition';
        field.options.forEach((opt) => {
          const option = document.createElement('option');
          option.value = opt;
          option.textContent = opt;
          if (val === opt || (!val && field.default === opt)) option.selected = true;
          select.appendChild(option);
        });
        select.addEventListener('change', (e) => {
          formData[field.name] = e.target.value;
          renderJSON();
        });
        fieldWrapper.appendChild(select);
      } else if (field.type === 'boolean') {
        const boolContainer = document.createElement('div');
        boolContainer.className = 'flex items-center gap-3 pt-1';

        const toggleBtn = document.createElement('button');
        toggleBtn.type = 'button';
        toggleBtn.id = `field-${field.name}`;
        const isChecked = Boolean(val !== undefined ? val : field.default);
        toggleBtn.className = `relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan ${isChecked ? 'bg-accent-cyan' : 'bg-white/20'}`;
        
        const toggleThumb = document.createElement('span');
        toggleThumb.className = `pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-lg ring-0 transition duration-200 ease-in-out ${isChecked ? 'translate-x-5' : 'translate-x-0'}`;
        toggleBtn.appendChild(toggleThumb);

        const statusLabel = document.createElement('span');
        statusLabel.className = 'text-xs text-text-secondary font-mono';
        statusLabel.textContent = isChecked ? 'Activado (true)' : 'Desactivado (false)';

        toggleBtn.addEventListener('click', () => {
          const current = Boolean(formData[field.name] !== undefined ? formData[field.name] : field.default);
          const next = !current;
          formData[field.name] = next;
          toggleBtn.className = `relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan ${next ? 'bg-accent-cyan' : 'bg-white/20'}`;
          toggleThumb.className = `pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-lg ring-0 transition duration-200 ease-in-out ${next ? 'translate-x-5' : 'translate-x-0'}`;
          statusLabel.textContent = next ? 'Activado (true)' : 'Desactivado (false)';
          renderJSON();
        });

        boolContainer.appendChild(toggleBtn);
        boolContainer.appendChild(statusLabel);
        fieldWrapper.appendChild(boolContainer);
      } else if (field.type === 'array-string') {
        const arrayContainer = document.createElement('div');
        arrayContainer.className = 'flex flex-col gap-2';

        const itemsList = document.createElement('div');
        itemsList.className = 'flex flex-col gap-2';

        const currentItems = Array.isArray(val) ? [...val] : [];

        function renderStringItems() {
          itemsList.innerHTML = '';
          currentItems.forEach((itemText, idx) => {
            const row = document.createElement('div');
            row.className = 'flex items-center gap-2';

            const itemInput = document.createElement('input');
            itemInput.type = 'text';
            itemInput.className = 'grow rounded-xl border border-white/10 bg-black/40 px-3 py-2 text-xs text-text-primary placeholder:text-text-secondary/40 focus:border-accent-cyan focus:outline-none focus:ring-1 focus:ring-accent-cyan transition';
            itemInput.value = itemText;
            itemInput.placeholder = `Elemento ${idx + 1}`;
            itemInput.addEventListener('input', (e) => {
              currentItems[idx] = e.target.value;
              formData[field.name] = currentItems;
              renderJSON();
            });

            const deleteBtn = document.createElement('button');
            deleteBtn.type = 'button';
            deleteBtn.className = 'inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-accent-red/30 bg-accent-red/10 text-accent-red hover:bg-accent-red/20 transition';
            deleteBtn.innerHTML = '✕';
            deleteBtn.title = 'Eliminar elemento';
            deleteBtn.addEventListener('click', () => {
              currentItems.splice(idx, 1);
              formData[field.name] = currentItems;
              renderStringItems();
              renderJSON();
            });

            row.appendChild(itemInput);
            row.appendChild(deleteBtn);
            itemsList.appendChild(row);
          });
        }

        const addItemBtn = document.createElement('button');
        addItemBtn.type = 'button';
        addItemBtn.className = 'inline-flex items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/5 py-2 text-xs font-semibold text-accent-cyan hover:bg-white/10 hover:border-accent-cyan/40 transition mt-1';
        addItemBtn.innerHTML = '+ Añadir elemento';
        addItemBtn.addEventListener('click', () => {
          currentItems.push('');
          formData[field.name] = currentItems;
          renderStringItems();
          renderJSON();
        });

        renderStringItems();
        arrayContainer.appendChild(itemsList);
        arrayContainer.appendChild(addItemBtn);
        fieldWrapper.appendChild(arrayContainer);
      } else if (field.type === 'array-object') {
        const arrayContainer = document.createElement('div');
        arrayContainer.className = 'flex flex-col gap-2.5';

        const itemsList = document.createElement('div');
        itemsList.className = 'flex flex-col gap-2.5';

        const currentObjects = Array.isArray(val) ? [...val] : [];

        function renderObjectItems() {
          itemsList.innerHTML = '';
          currentObjects.forEach((obj, idx) => {
            const card = document.createElement('div');
            card.className = 'rounded-xl border border-white/10 bg-black/50 p-3 flex flex-col gap-2 relative';

            const cardHeader = document.createElement('div');
            cardHeader.className = 'flex items-center justify-between text-xs font-mono text-text-secondary border-b border-white/5 pb-1.5';
            cardHeader.innerHTML = `<span>#${idx + 1}</span>`;

            const deleteBtn = document.createElement('button');
            deleteBtn.type = 'button';
            deleteBtn.className = 'text-accent-red hover:text-accent-red-lighter text-xs font-bold px-1.5 py-0.5 rounded transition';
            deleteBtn.innerHTML = '✕ Eliminar';
            deleteBtn.addEventListener('click', () => {
              currentObjects.splice(idx, 1);
              formData[field.name] = currentObjects;
              renderObjectItems();
              renderJSON();
            });
            cardHeader.appendChild(deleteBtn);
            card.appendChild(cardHeader);

            const grid = document.createElement('div');
            grid.className = 'grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1';

            field.subfields.forEach((sf) => {
              const subCol = document.createElement('div');
              subCol.className = 'flex flex-col gap-1';

              const sfLabel = document.createElement('label');
              sfLabel.className = 'text-[10px] uppercase font-mono text-text-secondary';
              sfLabel.textContent = sf.label;

              const sfInput = document.createElement('input');
              sfInput.type = 'text';
              sfInput.className = 'rounded-lg border border-white/10 bg-black/60 px-2.5 py-1.5 text-xs text-text-primary focus:border-accent-cyan focus:outline-none transition';
              sfInput.value = obj[sf.key] || '';
              sfInput.placeholder = sf.label;
              sfInput.addEventListener('input', (e) => {
                obj[sf.key] = e.target.value;
                formData[field.name] = currentObjects;
                renderJSON();
              });

              subCol.appendChild(sfLabel);
              subCol.appendChild(sfInput);
              grid.appendChild(subCol);
            });

            card.appendChild(grid);
            itemsList.appendChild(card);
          });
        }

        const addItemBtn = document.createElement('button');
        addItemBtn.type = 'button';
        addItemBtn.className = 'inline-flex items-center justify-center gap-1.5 rounded-xl border border-white/10 bg-white/5 py-2 text-xs font-semibold text-accent-cyan hover:bg-white/10 hover:border-accent-cyan/40 transition mt-1';
        addItemBtn.innerHTML = '+ Añadir nuevo registro';
        addItemBtn.addEventListener('click', () => {
          const newObj = {};
          field.subfields.forEach((sf) => {
            newObj[sf.key] = '';
          });
          currentObjects.push(newObj);
          formData[field.name] = currentObjects;
          renderObjectItems();
          renderJSON();
        });

        renderObjectItems();
        arrayContainer.appendChild(itemsList);
        arrayContainer.appendChild(addItemBtn);
        fieldWrapper.appendChild(arrayContainer);
      }

      dynamicFormFieldsContainer.appendChild(fieldWrapper);
    });

    updateTargetPathAndFilename();
    renderJSON();
  }

  // Switch Collection
  function switchCollection(key) {
    currentCollectionKey = key;
    formData = JSON.parse(JSON.stringify(SCHEMAS[key].sample));

    tabButtons.forEach((btn) => {
      const isTarget = btn.getAttribute('data-collection') === key;
      btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      if (isTarget) {
        btn.className = 'tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-accent-cyan/40 bg-accent-cyan/15 p-3 text-center transition hover:border-accent-cyan text-accent-cyan shadow-[0_0_15px_rgba(0,174,239,0.15)]';
      } else {
        btn.className = 'tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-bg-secondary/40 p-3 text-center text-text-secondary transition hover:border-white/20 hover:text-text-primary';
      }
    });

    renderForm();
  }

  // Event Listeners for Tabs
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const coll = btn.getAttribute('data-collection');
      if (coll && SCHEMAS[coll]) {
        switchCollection(coll);
      }
    });
  });

  // Copy JSON Button
  btnCopyJson?.addEventListener('click', async () => {
    const jsonStr = jsonCodeOutput.textContent || '';
    try {
      await navigator.clipboard.writeText(jsonStr);
      showToast('¡JSON copiado al portapapeles!');
    } catch (err) {
      console.error('Error al copiar:', err);
      showToast('Error al copiar al portapapeles');
    }
  });

  // Download JSON Button
  btnDownloadJson?.addEventListener('click', () => {
    const jsonStr = jsonCodeOutput.textContent || '';
    const filename = (customFilenameInput.value || 'contenido.json').trim();
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename.endsWith('.json') ? filename : `${filename}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast(`Archivo "${a.download}" descargado`);
  });

  // Copy Destination Path Button
  btnCopyPath?.addEventListener('click', async () => {
    let slug = '';
    const mainTitle = formData.titulo || formData.name || formData.nombre || 'nuevo-elemento';
    slug = slugify(mainTitle) || 'item';
    const path = currentCollectionKey === 'eventos' 
      ? `src/content/eventos/${slug}/evento.json`
      : `src/content/${currentCollectionKey}/${slug}.json`;

    try {
      await navigator.clipboard.writeText(path);
      showToast(`Ruta copiada: ${path}`);
    } catch (err) {
      console.error('Error al copiar:', err);
    }
  });

  // Reset Form
  btnResetForm?.addEventListener('click', () => {
    formData = {};
    const schema = SCHEMAS[currentCollectionKey];
    schema.fields.forEach(f => {
      if (f.type === 'number') formData[f.name] = f.default ?? 0;
      else if (f.type === 'boolean') formData[f.name] = f.default ?? true;
      else if (f.type === 'array-string' || f.type === 'array-object') formData[f.name] = [];
      else formData[f.name] = '';
    });
    renderForm();
    showToast('Formulario restablecido a valores vacíos');
  });

  // Load Sample
  btnLoadSample?.addEventListener('click', () => {
    formData = JSON.parse(JSON.stringify(SCHEMAS[currentCollectionKey].sample));
    renderForm();
    showToast('Plantilla de ejemplo cargada');
  });

  // File Import
  fileImportInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (evt) => {
      try {
        const parsed = JSON.parse(evt.target?.result);
        if (typeof parsed === 'object' && parsed !== null) {
          formData = parsed;
          renderForm();
          showToast(`Archivo "${file.name}" importado con éxito`);
        } else {
          showToast('El archivo JSON no contiene un objeto válido');
        }
      } catch (err) {
        showToast('Error al parsear el archivo JSON');
      }
    };
    reader.readAsText(file);
    e.target.value = '';
  });

  // Initialize
  renderForm();
</script>
