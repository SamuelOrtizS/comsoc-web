---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Generador de Contenido JSON | Utilidades IEEE ComSoc Univalle"
  description="Herramienta interactiva para crear, validar, copiar, importar y descargar archivos .json para las colecciones de contenido de Astro en IEEE ComSoc Univalle."
>
  <HeroHeader
    badgeText="Herramienta para Administradores y Desarrolladores"
    badgeColor="cyan"
    badgeDot={true}
    title="Generador de Contenido JSON"
    description="Crea, valida, copia y descarga estructuras .json perfectamente formateadas y listas para las colecciones de Astro en src/content/."
  />

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Quick Repository Path Banner -->
    <div class="mb-8 flex flex-col items-start justify-between gap-4 rounded-2xl border border-glass-border/40 bg-bg-secondary/40 p-4 sm:flex-row sm:items-center sm:p-5 backdrop-blur-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan shadow-[0_0_18px_rgba(0,174,239,0.2)]">
          <Icon name="material-symbols:folder-zip-rounded" class="h-5 w-5" aria-hidden="true" />
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-cyan font-mono">Ubicación Destino</div>
          <div id="target-path-display" class="text-sm font-mono text-text-primary font-medium">
            src/content/convocatorias/<span class="text-accent-cyan">mi-convocatoria.json</span>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto">
        <button
          type="button"
          id="btn-copy-path"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3.5 py-2 text-xs font-medium text-text-secondary transition hover:border-accent-cyan/40 hover:bg-white/10 hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan"
          title="Copiar ruta de destino"
        >
          <Icon name="material-symbols:content-copy-rounded" class="h-4 w-4" aria-hidden="true" />
          <span>Copiar ruta</span>
        </button>
      </div>
    </div>

    <!-- Collection Selection Tabs -->
    <div class="mb-8">
      <label class="mb-3 block text-xs font-semibold uppercase tracking-[0.18em] text-text-secondary font-mono">
        Selecciona la Colección
      </label>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7" id="collection-tabs" role="tablist">
        <button
          type="button"
          role="tab"
          data-collection="convocatorias"
          aria-selected="true"
          class="tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-accent-cyan/40 bg-accent-cyan/15 p-3 text-center transition hover:border-accent-cyan text-accent-cyan shadow-[0_0_15px_rgba(0,174,239,0.15)]"
        >
          <Icon name="material-symbols:campaign-rounded" class="h-5 w-5" aria-hidden="true" />
          <span class="text-xs font-semibold tracking-tight">Convocatorias</span>
        </button>

        <button
          type="button"
          role="tab"
          data-collection="eventos"
          aria-selected="false"
          class="tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-bg-secondary/40 p-3 text-center text-text-secondary transition hover:border-white/20 hover:text-text-primary"
        >
          <Icon name="material-symbols:calendar-month-rounded" class="h-5 w-5" aria-hidden="true" />
          <span class="text-xs font-semibold tracking-tight">Eventos</span>
        </button>

        <button
          type="button"
          role="tab"
          data-collection="tienda"
          aria-selected="false"
          class="tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-bg-secondary/40 p-3 text-center text-text-secondary transition hover:border-white/20 hover:text-text-primary"
        >
          <Icon name="material-symbols:storefront-rounded" class="h-5 w-5" aria-hidden="true" />
          <span class="text-xs font-semibold tracking-tight">Tienda</span>
        </button>

        <button
          type="button"
          role="tab"
          data-collection="juntaDirectiva"
          aria-selected="false"
          class="tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-bg-secondary/40 p-3 text-center text-text-secondary transition hover:border-white/20 hover:text-text-primary"
        >
          <Icon name="material-symbols:badge-rounded" class="h-5 w-5" aria-hidden="true" />
          <span class="text-xs font-semibold tracking-tight">Junta Directiva</span>
        </button>

        <button
          type="button"
          role="tab"
          data-collection="proyectos"
          aria-selected="false"
          class="tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-bg-secondary/40 p-3 text-center text-text-secondary transition hover:border-white/20 hover:text-text-primary"
        >
          <Icon name="material-symbols:rocket-launch-rounded" class="h-5 w-5" aria-hidden="true" />
          <span class="text-xs font-semibold tracking-tight">Proyectos</span>
        </button>

        <button
          type="button"
          role="tab"
          data-collection="aliados"
          aria-selected="false"
          class="tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-bg-secondary/40 p-3 text-center text-text-secondary transition hover:border-white/20 hover:text-text-primary"
        >
          <Icon name="material-symbols:handshake-rounded" class="h-5 w-5" aria-hidden="true" />
          <span class="text-xs font-semibold tracking-tight">Aliados</span>
        </button>

        <button
          type="button"
          role="tab"
          data-collection="recursos"
          aria-selected="false"
          class="tab-btn flex flex-col items-center gap-1.5 rounded-xl border border-white/10 bg-bg-secondary/40 p-3 text-center text-text-secondary transition hover:border-white/20 hover:text-text-primary"
        >
          <Icon name="material-symbols:library-books-rounded" class="h-5 w-5" aria-hidden="true" />
          <span class="text-xs font-semibold tracking-tight">Recursos</span>
        </button>
      </div>
    </div>

    <!-- Main Workspace: Vertical Stack Flow -->
    <div class="mx-auto max-w-5xl flex flex-col gap-10">
      <!-- Section 1: Form Builder -->
      <section aria-labelledby="form-builder-heading" class="flex flex-col gap-6">
        <!-- Form Header Card -->
        <div class="glass-card rounded-2xl border border-white/10 bg-bg-secondary/40 p-5 backdrop-blur-md">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 id="current-collection-title" class="text-xl font-black tracking-tight text-text-primary">
                Convocatoria
              </h2>
              <p id="current-collection-desc" class="text-xs text-text-secondary mt-0.5 font-light">
                Esquema validado para ofertas de voluntariado y roles del capítulo.
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-load-sample"
                class="inline-flex items-center gap-1.5 rounded-xl border border-accent-cyan/30 bg-accent-cyan/10 px-3 py-1.5 text-xs font-semibold text-accent-cyan transition hover:bg-accent-cyan/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan"
              >
                <Icon name="material-symbols:auto-awesome-rounded" class="h-4 w-4" aria-hidden="true" />
                <span>Cargar Ejemplo</span>
              </button>
              <button
                type="button"
                id="btn-reset-form"
                class="inline-flex items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-text-secondary transition hover:bg-white/10 hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
              >
                <Icon name="material-symbols:restart-alt-rounded" class="h-4 w-4" aria-hidden="true" />
                <span>Limpiar</span>
              </button>
              <label
                class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-text-secondary transition hover:bg-white/10 hover:text-text-primary focus-within:ring-2 focus-within:ring-white/30"
                title="Cargar archivo JSON existente"
              >
                <Icon name="material-symbols:upload-file-rounded" class="h-4 w-4" aria-hidden="true" />
                <span>Importar .json</span>
                <input type="file" id="file-import-input" accept=".json,application/json" class="sr-only" />
              </label>
            </div>
          </div>
        </div>

        <!-- Dynamic Form Fields Container -->
        <form id="content-form" class="flex flex-col gap-6" onsubmit="return false;">
          <div id="dynamic-form-fields" class="flex flex-col gap-6">
            <!-- Injected via JavaScript based on collection schema -->
          </div>
        </form>
      </section>

      <!-- Section 2: JSON Preview & Actions (Underneath the form) -->
      <section aria-labelledby="json-preview-heading" class="flex flex-col gap-6 pt-4 border-t border-white/10">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
          <div>
            <h2 id="json-preview-heading" class="text-xl font-black tracking-tight text-text-primary">
              Vista Previa y Exportación JSON
            </h2>
            <p class="text-xs text-text-secondary mt-0.5 font-light">
              El contenido se formatea y valida automáticamente en tiempo real según el esquema de la colección.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-1.5 text-xs font-mono text-accent-emerald font-semibold" id="json-status">
              <span class="h-1.5 w-1.5 rounded-full bg-accent-emerald animate-pulse"></span>
              Estructura válida
            </div>
          </div>
        </div>

        <!-- JSON Output Panel Card -->
        <div class="glass-card rounded-2xl border border-white/10 bg-bg-secondary/60 p-5 backdrop-blur-xl shadow-2xl flex flex-col gap-4">
          <!-- Output Card Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/10">
            <div class="flex items-center gap-2.5">
              <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-white/5 border border-white/10 text-accent-cyan">
                <Icon name="material-symbols:data-object-rounded" class="h-4 w-4" aria-hidden="true" />
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-text-primary font-mono">Código JSON Generado</span>
            </div>

            <!-- Filename Input -->
            <div class="flex items-center gap-2 bg-black/40 border border-white/10 rounded-xl px-3 py-1.5">
              <span class="text-xs text-text-secondary font-mono">Archivo:</span>
              <input
                type="text"
                id="custom-filename-input"
                value="nueva-convocatoria.json"
                class="w-48 sm:w-64 bg-transparent text-xs font-mono text-accent-cyan focus:outline-none border-b border-transparent focus:border-accent-cyan"
                title="Nombre del archivo para descargar"
              />
            </div>
          </div>

          <!-- Code View Area -->
          <div class="relative group">
            <pre class="max-h-[550px] min-h-[300px] overflow-auto rounded-xl border border-white/5 bg-[#030612] p-4 text-xs font-mono text-text-secondary leading-relaxed custom-scrollbar selection:bg-accent-blue selection:text-white" tabindex="0"><code id="json-code-output" class="text-text-primary"></code></pre>
          </div>

          <!-- Primary Actions Toolbar -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <button
              type="button"
              id="btn-copy-json"
              class="relative inline-flex items-center justify-center gap-2 rounded-xl border border-accent-cyan/40 bg-linear-to-r from-accent-blue to-accent-blue-lighter px-5 py-3.5 text-xs font-bold text-white shadow-[0_12px_24px_-10px_rgba(0,98,155,0.8)] transition duration-200 hover:scale-[1.01] hover:shadow-[0_16px_30px_-10px_rgba(0,174,239,0.9)] active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan cursor-pointer"
            >
              <Icon name="material-symbols:content-copy-rounded" class="h-4 w-4" aria-hidden="true" />
              <span>Copiar JSON al Portapapeles</span>
            </button>

            <button
              type="button"
              id="btn-download-json"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-accent-emerald/40 bg-accent-emerald/15 px-5 py-3.5 text-xs font-bold text-accent-emerald transition duration-200 hover:scale-[1.01] hover:bg-accent-emerald/25 active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-emerald cursor-pointer"
            >
              <Icon name="material-symbols:download-rounded" class="h-4 w-4" aria-hidden="true" />
              <span>Descargar Archivo .json</span>
            </button>
          </div>
        </div>

        <!-- Guide & Instructions Box -->
        <div class="rounded-2xl border border-white/10 bg-bg-secondary/30 p-5 text-xs text-text-secondary leading-relaxed backdrop-blur-sm">
          <div class="flex items-center gap-2 font-bold text-text-primary mb-2">
            <Icon name="material-symbols:info-rounded" class="h-4 w-4 text-accent-cyan" aria-hidden="true" />
            <span>Guía de incorporación al repositorio</span>
          </div>
          <ol class="list-decimal list-inside space-y-1.5 font-light text-text-secondary/90">
            <li>Completa o ajusta los campos requeridos en el formulario superior.</li>
            <li>Revisa la vista previa del código JSON y haz clic en <strong>Copiar JSON</strong> o <strong>Descargar .json</strong>.</li>
            <li>Guarda el archivo en la ruta indicada en el banner superior dentro de <code class="text-accent-cyan font-mono">src/content/</code>.</li>
            <li>Astro sincronizará y recargará automáticamente los datos de la colección en caliente.</li>
          </ol>
        </div>
      </section>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast" role="alert" aria-live="assertive" class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-2.5 rounded-xl border border-accent-cyan/40 bg-bg-secondary/95 px-4 py-3 text-xs font-semibold text-text-primary shadow-[0_10px_30px_rgba(0,174,239,0.3)] backdrop-blur-lg">
    <Icon name="material-symbols:check-circle-rounded" class="h-4 w-4 text-accent-cyan" aria-hidden="true" />
    <span id="toast-message">Copiado al portapapeles</span>
  </div>
</BaseLayout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 174, 239, 0.5);
  }
</style>

<script is:inline>
  // Collection Schema Definitions & Samples
  const SCHEMAS = {
    convocatorias: {
      title: 'Convocatoria',
      description: 'Esquema validado para ofertas de voluntariado y roles del capítulo.',
      targetFolder: 'src/content/convocatorias',
      defaultFilename: 'coordinador-proyectos.json',
      sample: {
        titulo: 'Coordinador de Proyectos de Telecomunicaciones',
        area: 'Proyectos & Desarrollo',
        fechaLimite: new Date(Date.now() + 30 * 86400000).toISOString().split('T')[0],
        descripcion: 'Buscamos un estudiante motivado para liderar iniciativas de redes y conectividad en el capítulo IEEE ComSoc Univalle.',
        requisitos: [
          'Estudiante activo de ingeniería electrónica, telecomunicaciones o afines.',
          'Interés en tecnologías 5G, IoT y redes de datos.',
          'Capacidad de trabajo en equipo y liderazgo.'
        ],
        responsabilidades: [
          'Coordinar las reuniones del equipo técnico.',
          'Gestionar cronogramas y entregables de proyectos.',
          'Presentar avances mensuales a la junta directiva.'
        ],
        estado: 'Publicada',
        formUrl: 'https://forms.gle/ejemploConvocatoria'
      },
      fields: [
        { name: 'titulo', label: 'Título del Cargo / Convocatoria', type: 'text', required: true },
        { name: 'area', label: 'Área o Comité', type: 'text', required: true, placeholder: 'Ej: Proyectos & Desarrollo, Comunicaciones' },
        { name: 'fechaLimite', label: 'Fecha Límite de Postulación', type: 'date', required: true },
        { name: 'descripcion', label: 'Descripción General', type: 'textarea', required: true },
        { name: 'estado', label: 'Estado', type: 'select', options: ['Publicada', 'Cerrada'], required: true },
        { name: 'formUrl', label: 'Enlace al Formulario de Postulación (Google Forms, etc.)', type: 'url', required: false },
        { name: 'requisitos', label: 'Requisitos', type: 'array-string', required: true },
        { name: 'responsabilidades', label: 'Responsabilidades', type: 'array-string', required: true }
      ]
    },

    eventos: {
      title: 'Evento',
      description: 'Esquema para talleres, webinars, hackathones y reuniones del capítulo.',
      targetFolder: 'src/content/eventos/<slug>',
      defaultFilename: 'evento.json',
      sample: {
        titulo: 'Taller Práctico: Despliegue de Redes 5G y Computación en el Borde',
        tipo: 'Taller',
        organizador: 'Comité Técnico ComSoc Univalle',
        fechaInicio: new Date(Date.now() + 14 * 86400000).toISOString().split('T')[0],
        fechaFin: new Date(Date.now() + 14 * 86400000).toISOString().split('T')[0],
        horaInicio: '14:00',
        horaFin: '17:30',
        lugarNombre: 'Laboratorio de Telecomunicaciones 301, Edificio 354',
        lugarDireccion: 'Campus Meléndez, Universidad del Valle',
        descripcion: 'Aprende los fundamentos prácticos de arquitectura 5G Standalone, virtualización de funciones de red (NFV) y Open Radio Access Network (O-RAN).',
        imagenPrincipal: 'https://images.unsplash.com/photo-1544197150-b99a580bb7a8?auto=format&fit=crop&w=1200&q=80',
        galeria: [
          'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80',
          'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=1200&q=80'
        ],
        estado: 'Publicado',
        detalles: [
          { label: 'Modalidad', value: 'Presencial con transmisión online' },
          { label: 'Certificación', value: 'Certificado de asistencia IEEE ComSoc' },
          { label: 'Prerrequisitos', value: 'Conocimientos básicos de redes TCP/IP' }
        ]
      },
      fields: [
        { name: 'titulo', label: 'Título del Evento', type: 'text', required: true },
        { name: 'tipo', label: 'Tipo de Evento', type: 'text', required: true, placeholder: 'Ej: Taller, Conferencia, Hackathon, Webinar, Reunión' },
        { name: 'organizador', label: 'Organizador', type: 'text', required: true, placeholder: 'Ej: Junta Directiva ComSoc Univalle' },
        { name: 'fechaInicio', label: 'Fecha de Inicio', type: 'date', required: true },
        { name: 'fechaFin', label: 'Fecha de Finalización (Opcional)', type: 'date', required: false },
        { name: 'horaInicio', label: 'Hora de Inicio (HH:mm)', type: 'time', required: true },
        { name: 'horaFin', label: 'Hora de Fin (HH:mm)', type: 'time', required: true },
        { name: 'lugarNombre', label: 'Lugar / Plataforma', type: 'text', required: true, placeholder: 'Ej: Auditorio 1 / Google Meet' },
        { name: 'lugarDireccion', label: 'Dirección o Enlace de Ubicación (Opcional)', type: 'text', required: false },
        { name: 'descripcion', label: 'Descripción Detallada', type: 'textarea', required: true },
        { name: 'imagenPrincipal', label: 'URL de Imagen Principal', type: 'text', required: true },
        { name: 'estado', label: 'Estado', type: 'select', options: ['Publicado', 'Pasado'], required: true },
        { name: 'galeria', label: 'Galería de Fotos (URLs)', type: 'array-string', required: false },
        {
          name: 'detalles',
          label: 'Detalles y Características Adicionales',
          type: 'array-object',
          subfields: [
            { key: 'label', label: 'Etiqueta (Ej: Modalidad)', type: 'text' },
            { key: 'value', label: 'Valor (Ej: Híbrido)', type: 'text' }
          ],
          required: false
        }
      ]
    },

    tienda: {
      title: 'Producto de Tienda',
      description: 'Esquema para indumentaria, accesorios y merchandising del capítulo.',
      targetFolder: 'src/content/tienda',
      defaultFilename: 'camiseta-oficial-comsoc.json',
      sample: {
        name: 'Camiseta Oficial IEEE ComSoc Univalle',
        category: 'Indumentaria',
        price: '45000',
        description: 'Camiseta de alta calidad 100% algodón peinado con el logo bordado de IEEE ComSoc y diseño conmemorativo en la espalda.',
        image: 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80',
        available: true,
        resources: [
          { title: 'Guía de Tallas (PDF)', link: 'https://ejemplo.com/tallas.pdf', icon: 'material-symbols:straighten', color: '#00aeef' }
        ],
        specifications: [
          { key: 'Material', value: '100% Algodón Peinado 200g' },
          { key: 'Tallas Disponibles', value: 'S, M, L, XL' },
          { key: 'Color Base', value: 'Azul Marino Oscuro / Deep Slate' }
        ]
      },
      fields: [
        { name: 'name', label: 'Nombre del Producto', type: 'text', required: true },
        { name: 'category', label: 'Categoría', type: 'text', required: true, placeholder: 'Ej: Indumentaria, Accesorios, Stickers, Pines' },
        { name: 'price', label: 'Precio (COP o USD)', type: 'text', required: true, placeholder: 'Ej: 45000 o $ 45.000 COP' },
        { name: 'description', label: 'Descripción del Producto', type: 'textarea', required: true },
        { name: 'image', label: 'URL de Imagen del Producto', type: 'text', required: true },
        { name: 'available', label: '¿Producto Disponible para Pedidos?', type: 'boolean', default: true, required: true },
        {
          name: 'specifications',
          label: 'Ficha Técnica / Especificaciones',
          type: 'array-object',
          subfields: [
            { key: 'key', label: 'Característica (Ej: Material)', type: 'text' },
            { key: 'value', label: 'Detalle (Ej: Algodón)', type: 'text' }
          ],
          required: false
        },
        {
          name: 'resources',
          label: 'Recursos / Enlaces de Interés',
          type: 'array-object',
          subfields: [
            { key: 'title', label: 'Título del Recurso', type: 'text' },
            { key: 'link', label: 'URL Enlace', type: 'text' },
            { key: 'icon', label: 'Icono (Ej: material-symbols:download)', type: 'text' },
            { key: 'color', label: 'Color Hex (Ej: #00aeef)', type: 'text' }
          ],
          required: false
        }
      ]
    },

    juntaDirectiva: {
      title: 'Miembro de Junta Directiva',
      description: 'Esquema para líderes, comités y directivos de IEEE ComSoc Univalle.',
      targetFolder: 'src/content/juntaDirectiva',
      defaultFilename: 'presidente.json',
      sample: {
        order: 1,
