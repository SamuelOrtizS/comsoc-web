---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';

const rawJunta = await getCollection('juntaDirectiva');
const team = rawJunta
  .map((item) => item.data)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

let galleryImages: string[] = [];
try {
  const dirPath = path.join(process.cwd(), 'public', 'images', 'galeria');
  if (fs.existsSync(dirPath)) {
    const files = fs.readdirSync(dirPath);
    galleryImages = files
      .filter(file => /\.(jpg|jpeg|png|webp|gif|svg)$/i.test(file))
      .map(file => `/images/galeria/${file}`);
  }
} catch (e) {
  console.error("Error reading gallery", e);
}

if (galleryImages.length === 0) {
  galleryImages = [
    '/images/hero-banner.jpg',
    '/images/event-iot.svg',
    '/images/event-optical.svg',
    '/images/event-hackathon.svg'
  ];
}

const benefits = [
  {
    title: 'Acceso a IEEE Xplore',
    desc: 'Publicaciones científicas, papers técnicos de telecomunicaciones y estándares globales al alcance de los miembros.',
    icon: '📚',
  },
  {
    title: 'Networking Internacional',
    desc: 'Conexión con ingenieros, investigadores y capítulos ComSoc de más de 160 países alrededor del mundo.',
    icon: '🌐',
  },
  {
    title: 'Descuentos & Becas',
    desc: 'Precios especiales en conferencias internacionales de IEEE (Globecom, ICC, WCNC) y becas para estudiantes.',
    icon: '🎓',
  },
  {
    title: 'Workshops & Certificaciones',
    desc: 'Talleres prácticos con laboratorios en tiempo real sobre redes 5G, LoRaWAN, microcontroladores y fibra óptica.',
    icon: '⚡',
  },
  {
    title: 'Liderazgo & Gestión',
    desc: 'Experiencia real dirigiendo comités técnicos, organizando congresos y gestionando presupuestos y patrocinadores.',
    icon: '🏆',
  },
  {
    title: 'Mentoria con la Industria',
    desc: 'Vínculo directo con empresas líderes del sector telecomunicaciones (operadores, vendors y cloud providers).',
    icon: '🤝',
  },
];
---

<BaseLayout
  title="IEEE ComSoc Univalle | Sobre Nosotros"
  description="Conoce la misión, visión, directiva y beneficios de pertenecer al Capítulo Estudiantil IEEE ComSoc."
>
  <!-- Page Header Banner -->
  <section class="relative overflow-hidden border-b border-white/10 py-18 sm:py-20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(21,93,252,0.18),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(34,211,238,0.14),transparent_28%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-cyan/30 bg-accent-cyan/10 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent-cyan font-mono shadow-[0_0_18px_rgba(34,211,238,0.12)]">
        <span class="h-2 w-2 rounded-full bg-accent-cyan shadow-[0_0_12px_rgba(34,211,238,0.9)]"></span>
        Sobre la Comunidad
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-black tracking-[-0.06em] text-text-primary sm:text-5xl lg:text-6xl">
        Conectando al mundo a través de la tecnología
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg font-light">
        El Capítulo Estudiantil IEEE ComSoc es el espacio universitario donde convergen la ciencia, la investigación y la pasión por las redes y telecomunicaciones.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-[10px] font-mono uppercase tracking-[0.16em] text-text-secondary">
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">Investigación</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">Innovación</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">Comunidades</span>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
    <div class="relative rounded-3xl overflow-hidden glass-card border border-white/10 group aspect-21/9">
      <div class="w-full h-full relative" id="gallery-container">
        {galleryImages.map((img, idx) => (
          <div 
            class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'} gallery-slide`}
          >
            <img 
              src={img} 
              alt={`Imagen de galería ${idx + 1}`} 
              loading={idx === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="w-full h-full object-cover" 
            />
            <div class="absolute inset-0 bg-linear-to-t from-bg-primary via-transparent to-black/40"></div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      <button 
        id="gallery-prev" 
        class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-xl bg-black/60 border border-white/10 text-text-primary flex items-center justify-center hover:bg-white/10 hover:border-accent-cyan/40 transition opacity-0 group-hover:opacity-100 duration-300 cursor-pointer"
        aria-label="Anterior"
      >
        ←
      </button>
      <button 
        id="gallery-next" 
        class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-xl bg-black/60 border border-white/10 text-text-primary flex items-center justify-center hover:bg-white/10 hover:border-accent-cyan/40 transition opacity-0 group-hover:opacity-100 duration-300 cursor-pointer"
        aria-label="Siguiente"
      >
        →
      </button>

      <!-- Dots Indicators -->
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex gap-2">
        {galleryImages.map((_, idx) => (
          <button 
            class={`w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer ${idx === 0 ? 'bg-accent-cyan scale-125' : 'bg-white/40'}`} 
            data-index={idx}
            aria-label={`Ver diapositiva ${idx + 1}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Mission & Vision Cards -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-3xl text-center mx-auto">
      <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-accent-cyan font-mono">
        Qué nos mueve
      </div>
      <h2 class="text-3xl font-black tracking-[-0.05em] text-text-primary sm:text-4xl">
        Una comunidad impulsada por la ingeniería aplicada
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="group relative overflow-hidden rounded-[28px] border border-accent-blue/30 bg-[linear-gradient(180deg,rgba(15,23,42,0.96),rgba(5,8,22,0.96))] p-8 shadow-[0_20px_65px_-40px_rgba(21,93,252,0.65)] transition-all duration-300 hover:-translate-y-1 hover:border-accent-blue/60">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(21,93,252,0.22),transparent_35%)]" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-accent-blue/30 bg-accent-blue/15 text-2xl text-accent-blue shadow-[0_0_24px_rgba(21,93,252,0.18)]">
            🎯
          </div>
          <h3 class="mb-4 text-2xl font-bold tracking-[-0.04em] text-text-primary">Nuestra Misión</h3>
          <p class="text-base leading-relaxed text-text-secondary font-light">
            Fomentar la excelencia académica, técnica y humana de los estudiantes a través de conferencias de primer nivel, talleres prácticos, proyectos interdisciplinarios e investigación en comunicaciones inalámbricas, ópticas, satelitales y ciberseguridad.
          </p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-[28px] border border-accent-cyan/30 bg-[linear-gradient(180deg,rgba(11,18,33,0.96),rgba(5,8,22,0.96))] p-8 shadow-[0_20px_65px_-40px_rgba(34,211,238,0.6)] transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/60">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(34,211,238,0.2),transparent_35%)]" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-accent-cyan/30 bg-accent-cyan/15 text-2xl text-accent-cyan shadow-[0_0_24px_rgba(34,211,238,0.18)]">
            🚀
          </div>
          <h3 class="mb-4 text-2xl font-bold tracking-[-0.04em] text-text-primary">Nuestra Visión</h3>
          <p class="text-base leading-relaxed text-text-secondary font-light">
            Posicionarnos como el capítulo estudiantil referente en la región, reconocido por la calidad técnica de sus miembros, su capacidad de innovación tecnológica y su compromiso con el cierre de la brecha digital mediante la ingeniería.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Member Benefits Grid -->
  <section class="mx-auto max-w-7xl border-t border-white/10 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-accent-cyan font-mono">
        Valor para estudiantes
      </div>
      <h2 class="mb-4 text-3xl font-black tracking-[-0.05em] text-text-primary sm:text-4xl">
        Beneficios de ser miembro IEEE ComSoc
      </h2>
      <p class="text-base leading-relaxed text-text-secondary font-light">
        Ser parte de la red de telecomunicaciones más grande del planeta te brinda ventajas únicas para acelerar tu desarrollo.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => (
        <article class="group relative overflow-hidden rounded-[22px] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.9),rgba(5,8,22,0.96))] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 hover:shadow-[0_26px_55px_-35px_rgba(34,211,238,0.7)]">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-3xl shadow-[0_18px_30px_-20px_rgba(34,211,238,0.72)]">
            {b.icon}
          </div>
          <h3 class="mb-2 text-lg font-bold tracking-[-0.03em] text-text-primary transition-colors group-hover:text-accent-cyan">{b.title}</h3>
          <p class="text-sm leading-relaxed text-text-secondary font-light">{b.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Team Leadership Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="text-xs uppercase font-mono tracking-widest text-accent-purple mb-2 font-semibold">
        Liderazgo 2026
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">
        Mesa Directiva &amp; Asesoría
      </h2>
      <p class="text-text-secondary font-light">
        Estudiantes y docentes comprometidos en liderar las iniciativas y proyectos del capítulo. Haz clic en cualquier perfil para ver más información.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member) => (
        <button
          type="button"
          class="member-card group w-full rounded-[24px] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.8),rgba(5,8,22,0.96))] p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 hover:shadow-[0_26px_55px_-35px_rgba(34,211,238,0.7)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/80 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
          data-member={JSON.stringify(member)}
          aria-label={`Ver perfil de ${member.name}`}
        >
          <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center overflow-hidden rounded-full border-2 border-accent-cyan/40 bg-[linear-gradient(135deg,rgba(21,93,252,0.3),rgba(34,211,238,0.3))] text-4xl transition-all duration-300 group-hover:scale-105 group-hover:border-accent-cyan/80">
            {member.image
              ? <img src={member.image} alt={member.name} loading="lazy" decoding="async" class="h-full w-full rounded-full object-cover" />
              : <span>{member.avatar || '👤'}</span>
            }
          </div>
          <h3 class="mb-1 text-lg font-bold tracking-[-0.03em] text-text-primary transition-colors group-hover:text-accent-cyan">
            {member.name}
          </h3>
          <div class="mb-1 text-xs font-mono font-medium text-accent-cyan">
            {member.role}
          </div>
          <p class="mb-4 text-xs leading-relaxed text-text-secondary font-light">
            {member.department}
          </p>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-[10px] font-mono uppercase tracking-[0.14em] text-text-secondary transition-colors group-hover:border-accent-cyan/40 group-hover:text-accent-cyan">
            Ver perfil
            <span aria-hidden="true">→</span>
          </div>
        </button>
      ))}
    </div>
  </section>

  <!-- Member Modal -->
  <div
    id="member-modal-overlay"
    class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xl flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-member-name"
  >
    <div id="member-modal" class="relative bg-[#0a0f2d] border border-white/15 rounded-3xl shadow-2xl shadow-blue-900/40 w-full max-w-md p-8 flex flex-col gap-6 translate-y-4 transition-all duration-300">
      <!-- Close button -->
      <button
        id="modal-close"
        type="button"
        class="absolute top-4 right-4 text-text-secondary hover:text-text-primary p-2 rounded-xl hover:bg-white/10 transition"
        aria-label="Cerrar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Avatar -->
      <div class="flex flex-col items-center gap-3">
        <div id="modal-avatar-wrap" class="w-24 h-24 rounded-full bg-linear-to-tr from-accent-blue/40 to-accent-cyan/40 border-2 border-accent-cyan/60 flex items-center justify-center text-5xl overflow-hidden"></div>
        <div class="text-center">
          <h2 id="modal-member-name" class="text-xl font-extrabold text-text-primary"></h2>
          <div id="modal-role" class="text-xs font-mono text-accent-cyan font-medium mt-0.5"></div>
          <div id="modal-dept" class="text-xs text-text-secondary mt-0.5"></div>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-white/10"></div>

      <!-- Bio -->
      <div id="modal-bio-wrap" class="hidden">
        <p id="modal-bio" class="text-sm text-text-secondary font-light leading-relaxed"></p>
      </div>

      <!-- Contact info -->
      <div id="modal-contact" class="flex flex-col gap-2.5"></div>

      <!-- Social links -->
      <div id="modal-socials" class="flex flex-wrap gap-2"></div>
    </div>
  </div>

  <script>
    // Gallery Slider Logic
    const slides = document.querySelectorAll('.gallery-slide');
    const dots = document.querySelectorAll('button[data-index]');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    let currentSlide = 0;
    let autoPlayInterval: number;

    function showSlide(index: number) {
      if (slides.length === 0) return;
      currentSlide = (index + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === currentSlide) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentSlide) {
          dot.classList.remove('bg-white/40');
          dot.classList.add('bg-accent-cyan', 'scale-125');
        } else {
          dot.classList.remove('bg-accent-cyan', 'scale-125');
          dot.classList.add('bg-white/40');
        }
      });
    }

    function nextSlide() {
      showSlide(currentSlide + 1);
    }

    function prevSlide() {
      showSlide(currentSlide - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayInterval = window.setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
      }
    }

    if (prevBtn && nextBtn && slides.length > 0) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        startAutoPlay();
      });

      nextBtn.addEventListener('click', () => {
        nextSlide();
        startAutoPlay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          showSlide(idx);
          startAutoPlay();
        });
      });

      // Pause on hover
      const container = document.getElementById('gallery-container');
      if (container) {
        container.addEventListener('mouseenter', stopAutoPlay);
        container.addEventListener('mouseleave', startAutoPlay);
      }

      startAutoPlay();
    }

    type MemberData = {
      name: string;
      role: string;
      department: string;
      avatar?: string;
      image?: string;
      bio?: string;
      email?: string;
      phone?: string;
      linkedin?: string;
      instagram?: string;
      facebook?: string;
      github?: string;
      website?: string;
    };

    const overlay = document.getElementById('member-modal-overlay') as HTMLElement;
    const modal   = document.getElementById('member-modal') as HTMLElement;
    const closeBtn = document.getElementById('modal-close') as HTMLButtonElement;

    function openModal(member: MemberData) {
      // Avatar / Image
      const avatarWrap = document.getElementById('modal-avatar-wrap') as HTMLElement;
      avatarWrap.innerHTML = member.image
        ? `<img src="${member.image}" alt="${member.name}" class="w-full h-full object-cover rounded-full" />`
        : `<span>${member.avatar ?? '👤'}</span>`;

      // Basic info
      (document.getElementById('modal-member-name') as HTMLElement).textContent = member.name;
      (document.getElementById('modal-role') as HTMLElement).textContent = member.role;
      (document.getElementById('modal-dept') as HTMLElement).textContent = member.department;

      // Bio
      const bioWrap = document.getElementById('modal-bio-wrap') as HTMLElement;
      const bioEl = document.getElementById('modal-bio') as HTMLElement;
      if (member.bio) {
        bioEl.textContent = member.bio;
        bioWrap.classList.remove('hidden');
      } else {
        bioWrap.classList.add('hidden');
      }

      // Contact
      const contactEl = document.getElementById('modal-contact') as HTMLElement;
      contactEl.innerHTML = '';
      if (member.email) {
        contactEl.insertAdjacentHTML('beforeend', `
          <a href="mailto:${member.email}" class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-accent-cyan hover:border-accent-cyan/40 transition text-xs font-mono">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            ${member.email}
          </a>`);
      }
      if (member.phone) {
        contactEl.insertAdjacentHTML('beforeend', `
          <a href="tel:${member.phone}" class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-accent-cyan hover:border-accent-cyan/40 transition text-xs font-mono">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            ${member.phone}
          </a>`);
      }

      // Socials
      const socialsEl = document.getElementById('modal-socials') as HTMLElement;
      socialsEl.innerHTML = '';
      const socialLinks: { key: keyof MemberData; label: string; color: string }[] = [
        { key: 'linkedin',  label: 'LinkedIn',  color: 'bg-accent-blue/20 text-accent-blue border-accent-blue/30 hover:bg-accent-blue/40' },
        { key: 'instagram', label: 'Instagram', color: 'bg-pink-600/20 text-pink-300 border-pink-500/30 hover:bg-pink-600/40' },
        { key: 'facebook',  label: 'Facebook',  color: 'bg-indigo-600/20 text-indigo-300 border-indigo-500/30 hover:bg-indigo-600/40' },
        { key: 'github',    label: 'GitHub',    color: 'bg-gray-600/20 text-text-secondary border-gray-500/30 hover:bg-gray-600/40' },
        { key: 'website',   label: 'Sitio Web', color: 'bg-accent-emerald/20 text-accent-emerald border-accent-emerald/30 hover:bg-accent-emerald/40' },
      ];
      socialLinks.forEach(({ key, label, color }) => {
        const url = member[key] as string | undefined;
        if (url) {
          socialsEl.insertAdjacentHTML('beforeend', `
            <a href="${url}" target="_blank" rel="noopener noreferrer"
               class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition ${color}">
              ${label} ↗
            </a>`);
        }
      });
      if (socialsEl.innerHTML) socialsEl.classList.remove('hidden');
      else socialsEl.classList.add('hidden');

      // Animate open
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      modal.classList.remove('translate-y-4');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('translate-y-4');
      document.body.style.overflow = '';
    }

    // Attach to all cards
    document.querySelectorAll<HTMLButtonElement>('.member-card').forEach((card) => {
      card.addEventListener('click', () => {
        const raw = card.getAttribute('data-member');
        if (raw) openModal(JSON.parse(raw) as MemberData);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>

</BaseLayout>
