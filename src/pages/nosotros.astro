---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { resolveImage } from '../utils/imageResolver';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';

const rawJunta = await getCollection('juntaDirectiva');
const team = rawJunta
  .map((item) => item.data)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

let galleryImages: (string | any)[] = [];
try {
  // Try public galeria first (legacy), then src/assets galeria
  const publicDir = path.join(process.cwd(), 'public', 'images', 'galeria');
  const assetsDir = path.join(process.cwd(), 'src', 'assets', 'images', 'galeria');
  let files: string[] = [];
  let basePath = '/images/galeria/';
  if (fs.existsSync(publicDir) && fs.readdirSync(publicDir).length > 0) {
    files = fs.readdirSync(publicDir);
    basePath = '/images/galeria/';
  } else if (fs.existsSync(assetsDir)) {
    files = fs.readdirSync(assetsDir);
    basePath = '/images/galeria/';
  }
  if (files.length > 0) {
    galleryImages = files
      .filter(file => /\.(jpg|jpeg|png|webp|gif|svg)$/i.test(file))
      .map(file => resolveImage(`${basePath}${file}`));
  }
} catch (e) {
  console.error("Error reading gallery", e);
}

if (galleryImages.length === 0) {
  galleryImages = [
    resolveImage('/images/hero-banner.jpg'),
    resolveImage('/images/event-iot.svg'),
    resolveImage('/images/event-optical.svg'),
    resolveImage('/images/event-hackathon.svg')
  ];
}

const benefits = [
  {
    title: 'Acceso a IEEE Xplore',
    desc: 'Publicaciones científicas, papers técnicos de telecomunicaciones y estándares globales al alcance de los miembros.',
    icon: 'material-symbols:menu-book-rounded',
  },
  {
    title: 'Networking Internacional',
    desc: 'Conexión con ingenieros, investigadores y capítulos ComSoc de más de 160 países alrededor del mundo.',
    icon: 'material-symbols:public',
  },
  {
    title: 'Descuentos & Becas',
    desc: 'Precios especiales en conferencias internacionales de IEEE (Globecom, ICC, WCNC) y becas para estudiantes.',
    icon: 'material-symbols:school-rounded',
  },
  {
    title: 'Workshops & Certificaciones',
    desc: 'Talleres prácticos con laboratorios en tiempo real sobre redes 5G, LoRaWAN, microcontroladores y fibra óptica.',
    icon: 'material-symbols:construction-rounded',
  },
  {
    title: 'Liderazgo & Gestión',
    desc: 'Experiencia real dirigiendo comités técnicos, organizando congresos y gestionando presupuestos y patrocinadores.',
    icon: 'material-symbols:trophy-rounded',
  },
  {
    title: 'Mentoria con la Industria',
    desc: 'Vínculo directo con empresas líderes del sector telecomunicaciones (operadores, vendors y cloud providers).',
    icon: 'material-symbols:handshake-rounded',
  },
];
---

<BaseLayout
  title="IEEE ComSoc Univalle | Sobre Nosotros"
  description="Conoce la misión, visión, directiva y beneficios de pertenecer al Capítulo Estudiantil IEEE ComSoc."
>
  <!-- Page Header Banner -->
  <section class="relative overflow-hidden border-b border-white/10 py-18 sm:py-20">
    <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-cyan/30 bg-accent-cyan/10 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent-cyan font-mono shadow-[0_0_18px_rgba(34,211,238,0.12)]">
        <span class="h-2 w-2 rounded-full bg-accent-cyan shadow-[0_0_12px_rgba(34,211,238,0.9)]"></span>
        Sobre la Comunidad
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-black tracking-[-0.06em] text-text-primary sm:text-5xl lg:text-6xl">
        Conectando al mundo a través de la tecnología
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-text-secondary sm:text-lg font-light">
        El Capítulo Estudiantil IEEE ComSoc es el espacio universitario donde convergen la ciencia, la investigación y la pasión por las redes y telecomunicaciones.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-[10px] font-mono uppercase tracking-[0.16em] text-text-secondary">
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">Investigación</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">Innovación</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5">Comunidades</span>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
    <div class="relative rounded-3xl overflow-hidden glass-card border border-glass-border group aspect-21/9" aria-label="Galería de eventos y actividades">
      <div class="w-full h-full relative" id="gallery-container">
        {galleryImages.map((img, idx) => (
          <div 
            class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'} gallery-slide`}
          >
            <Image 
              src={img as any} 
              alt={`Imagen de galería ${idx + 1}`} 
              width={1200}
              height={675}
              sizes="100vw"
              loading={idx === 0 ? 'eager' : 'lazy'}
              fetchpriority={idx === 0 ? 'high' : 'low'}
              decoding="async"
              class="w-full h-full object-cover" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-bg-primary via-transparent to-black/30"></div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      <button 
        id="gallery-prev" 
        class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-xl bg-accent-blue/20 border border-accent-blue/30 text-text-primary flex items-center justify-center hover:bg-accent-blue/40 hover:border-accent-blue/50 transition-all duration-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/80 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        aria-label="Navegar a la diapositiva anterior"
      >
        <Icon name="material-symbols:arrow-back-rounded" class="w-5 h-5" aria-hidden="true" />
      </button>
      <button 
        id="gallery-next" 
        class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-xl bg-accent-blue/20 border border-accent-blue/30 text-text-primary flex items-center justify-center hover:bg-accent-blue/40 hover:border-accent-blue/50 transition-all duration-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/80 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
        aria-label="Navegar a la diapositiva siguiente"
      >
        <Icon name="material-symbols:arrow-forward-rounded" class="w-5 h-5" aria-hidden="true" />
      </button>

      <!-- Dots Indicators -->
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex gap-2">
        {galleryImages.map((_, idx) => (
          <button 
            class={`w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer ${idx === 0 ? 'bg-accent-cyan scale-125' : 'bg-white/40'}`} 
            data-index={idx}
            aria-label={`Ver diapositiva ${idx + 1}`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Mission & Vision Cards -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-3xl text-center mx-auto">
      <div class="mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent-cyan font-mono">
        ¿Qué nos mueve?
      </div>
      <h2 class="text-headline font-extrabold tracking-[-0.04em] text-text-primary sm:text-4xl">
        Una comunidad impulsada por la ingeniería aplicada
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="group relative overflow-hidden rounded-[28px] border border-accent-blue/30 bg-[linear-gradient(180deg,var(--color-bg-deep-slate-lighter),var(--color-bg-primary))] p-8 shadow-[0_20px_65px_-40px_rgba(21,93,252,0.65)] transition-all duration-300 hover:-translate-y-1 hover:border-accent-blue/60">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,var(--color-accent-blue)/15%,transparent_35%)]" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-accent-blue/30 bg-accent-blue/15 text-accent-blue shadow-[0_0_24px_rgba(21,93,252,0.18)]">
            <Icon name="material-symbols:target" class="w-7 h-7" aria-hidden="true" />
          </div>
          <h3 class="mb-4 text-headline font-bold tracking-[-0.04em] text-text-primary">Nuestra Misión</h3>
          <p class="text-base leading-relaxed text-text-secondary font-light">
            Fomentar la excelencia académica, técnica y humana de los estudiantes a través de conferencias de primer nivel, talleres prácticos, proyectos interdisciplinarios e investigación en comunicaciones inalámbricas, ópticas, satelitales y ciberseguridad.
          </p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-[28px] border border-accent-cyan/30 bg-[linear-gradient(180deg,var(--color-bg-deep-slate-lighter),var(--color-bg-primary))] p-8 shadow-[0_20px_65px_-40px_rgba(34,211,238,0.6)] transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/60">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,var(--color-accent-cyan)/15%,transparent_35%)]" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-accent-cyan/30 bg-accent-cyan/15 text-accent-cyan shadow-[0_0_24px_rgba(34,211,238,0.18)]">
            <Icon name="material-symbols:rocket-launch-rounded" class="w-7 h-7" aria-hidden="true" />
          </div>
          <h3 class="mb-4 text-headline font-bold tracking-[-0.04em] text-text-primary">Nuestra Visión</h3>
          <p class="text-base leading-relaxed text-text-secondary font-light">
            Posicionarnos como el capítulo estudiantil referente en la región, reconocido por la calidad técnica de sus miembros, su capacidad de innovación tecnológica y su compromiso con el cierre de la brecha digital mediante la ingeniería.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Member Benefits Grid -->
  <section class="mx-auto max-w-7xl border-t border-glass-border px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <div class="mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent-cyan font-mono">
        Valor para estudiantes
      </div>
      <h2 class="mb-4 text-headline font-extrabold tracking-[-0.04em] text-text-primary sm:text-4xl">
        Beneficios de ser miembro IEEE ComSoc
      </h2>
      <p class="text-base leading-relaxed text-text-secondary font-light">
        Ser parte de la red de telecomunicaciones más grande del planeta te brinda ventajas únicas para acelerar tu desarrollo.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {benefits.map((b) => (
        <article class="group relative overflow-hidden rounded-[22px] border border-white/10 bg-[linear-gradient(180deg,var(--color-bg-deep-slate-lighter),var(--color-bg-primary))] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 hover:shadow-[0_26px_55px_-35px_rgba(34,211,238,0.7)]">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-accent-cyan shadow-[0_18px_30px_-20px_rgba(34,211,238,0.72)]">
            <Icon name={b.icon} class="w-7 h-7" aria-hidden="true" />
          </div>
          <h3 class="mb-2 text-lg font-bold tracking-[-0.03em] text-text-primary transition-colors group-hover:text-accent-cyan">{b.title}</h3>
          <p class="text-sm leading-relaxed text-text-secondary font-light">{b.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Team Leadership Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-glass-border">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="text-[10px] uppercase font-mono tracking-widest text-accent-purple mb-2 font-semibold">
        Liderazgo 2026
      </div>
      <h2 class="text-headline font-extrabold text-text-primary mb-4">
        Mesa Directiva &amp; Asesoría
      </h2>
      <p class="text-text-secondary font-light">
        Estudiantes y docentes comprometidos en liderar las iniciativas y proyectos del capítulo. Haz clic en cualquier perfil para ver más información.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member) => (
        <button
          type="button"
          class="member-card group relative w-full rounded-3xl border border-white/10 bg-linear-to-b from-bg-primary to-bg-deep-slate/90 p-6 text-center transition-all duration-350 ease-[cubic-bezier(0.22,0.6,0.51,1)] hover:-translate-y-1 hover:border-accent-cyan/40 hover:shadow-[0_30px_70px_-20px_rgba(34,211,238,0.5),inset_0_1px_0_0_rgba(255,255,255,0.05)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/80 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary before:absolute before:inset-0 before:bg-linear-to-b before:from-transparent before:to-black/2 before:opacity-0 group-hover:before:opacity-100 group-hover:before:transition-opacity group-hover:before:duration-300"
          data-member={JSON.stringify(member)}
          aria-label={`Ver perfil de ${member.name}`}
        >
          <div class="relative z-10">
            <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center overflow-hidden rounded-full border-2 border-accent-cyan/40 bg-linear-to-tr from-accent-blue/30 to-accent-cyan/30 text-accent-cyan transition-all duration-500 ease-[cubic-bezier(0.22,0.6,0.51,1)] group-hover:scale-105 group-hover:border-accent-cyan/70 group-hover:shadow-[0_8px_25px_-5px_rgba(34,211,238,0.4)]">
              {member.image
                ? <Image src={resolveImage(member.image) as any} alt={member.name} width={200} height={200} sizes="80px" loading="lazy" decoding="async" class="h-full w-full rounded-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" />
                : <Icon name="material-symbols:person-rounded" class="w-10 h-10 transition-transform duration-500 ease-out group-hover:scale-110" aria-hidden="true" />
              }
            </div>
            <h3 class="mb-2 text-xl font-black tracking-tight text-text-primary transition-colors duration-200 group-hover:text-accent-cyan">
              {member.name}
            </h3>
            <div class="mb-2 text-xs font-mono font-bold uppercase tracking-wider text-accent-cyan">
              {member.role}
            </div>
            <p class="mb-5 text-xs leading-relaxed text-text-secondary/70 transition-colors duration-200 group-hover:text-white/80">
              {member.department}
            </p>
            <div class="inline-flex items-center gap-2.5 rounded-full border border-glass-border bg-glass-bg px-3.5 py-1.75 text-[10px] font-mono uppercase tracking-[0.16em] text-text-secondary shadow-[0_4px_12px_-8px_rgba(0,0,0,0.3)] transition-all duration-300 ease-out group-hover:border-accent-cyan/40 group-hover:bg-accent-cyan/10 group-hover:text-accent-cyan group-hover:shadow-[0_6px_16px_-8px_rgba(34,211,238,0.3)]">
              Ver perfil
              <span aria-hidden="true" class="transition-transform duration-300 ease-out group-hover:translate-x-0.5">→</span>
            </div>
          </div>
        </button>
      ))}
    </div>
  </section>

  <!-- Member Modal -->
  <div
    id="member-modal-overlay"
    class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xl flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.22,0.6,0.51,1)]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-member-name"
  >
    <div id="member-modal" class="relative bg-linear-to-b from-bg-primary to-bg-deep-slate border border-accent-cyan/20 rounded-4xl shadow-[0_35px_85px_-25px_rgba(34,211,238,0.35),0_0_120px_rgba(34,211,238,0.15)] w-full max-w-lg p-6 sm:p-9 flex flex-col gap-6 sm:gap-7 translate-y-6 scale-95 opacity-0 transition-all duration-350 ease-[cubic-bezier(0.22,0.6,0.51,1)]">
      <!-- Close button with refined accessibility -->
      <button
        id="modal-close"
        type="button"
        class="absolute top-4 right-4 text-text-secondary hover:text-text-primary p-2.5 rounded-2xl hover:bg-white/5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-cyan/80 group active:scale-95"
        aria-label="Cerrar modal de perfil de miembro"
        data-modal-action="close"
      >
        <span class="sr-only" aria-live="polite">Cerrando modal</span>
        <Icon name="material-symbols:close-rounded" class="w-5 h-5 transition-transform duration-200 ease-out group-hover:scale-110 group-hover:-rotate-90 active:scale-90" aria-hidden="true" />
      </button>

      <!-- Avatar -->
      <div class="flex flex-col items-center gap-3">
        <div id="modal-avatar-wrap" class="w-24 h-24 rounded-full bg-linear-to-tr from-accent-blue/30 to-accent-cyan/30 border-2 border-accent-cyan/50 flex items-center justify-center text-5xl overflow-hidden shadow-[0_10px_40px_-15px_rgba(21,93,252,0.4)] ring-4 ring-black/20"></div>
        <div class="text-center">
          <h2 id="modal-member-name" class="text-xl font-extrabold tracking-tight text-text-primary transition-colors duration-200 group-hover:text-accent-cyan"></h2>
          <div id="modal-role" class="text-xs font-mono text-accent-cyan font-semibold mt-1 uppercase tracking-wider"></div>
          <div id="modal-dept" class="text-xs text-text-secondary/70 mt-0.5 transition-colors duration-200 group-hover:text-white/90"></div>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-white/10"></div>

      <!-- Bio -->
      <div id="modal-bio-wrap" class="hidden transition-all duration-300 ease-out">
        <p id="modal-bio" class="text-sm text-text-secondary/80 font-light leading-relaxed max-w-md"></p>
      </div>

      <!-- Contact info -->
      <div id="modal-contact" class="flex flex-col gap-2.5 transition-opacity duration-300 ease-out">
        <!-- Contact links will be injected here -->
      </div>

      <!-- Social links -->
      <div id="modal-socials" class="flex flex-wrap gap-2 transition-all duration-300 ease-out translate-y-0 opacity-100"></div>
    </div>
  </div>

  <script>
    // Gallery Slider Logic - Optimized for performance and accessibility
    const slides = document.querySelectorAll('.gallery-slide');
    const dots = document.querySelectorAll('button[data-index]');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    let currentSlide = 0;
    let autoPlayInterval: number;

    function showSlide(index: number) {
      if (slides.length === 0) return;
      // Smooth transition with modulo arithmetic for wraparound
      currentSlide = (index + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === currentSlide) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentSlide) {
          dot.classList.remove('bg-white/40');
          dot.classList.add('bg-accent-cyan', 'scale-125');
        } else {
          dot.classList.remove('bg-accent-cyan', 'scale-125');
          dot.classList.add('bg-white/40');
        }
      });
    }

    function nextSlide() {
      showSlide(currentSlide + 1);
    }

    function prevSlide() {
      showSlide(currentSlide - 1);
    }

    // Auto-play with debouncing for better UX
    function startAutoPlay() {
      stopAutoPlay();
      if (document.hidden) return;
      // Increased interval from 5s to 6s for better readability, reduced shadow cost
      autoPlayInterval = window.setInterval(() => { 
        if (!document.hidden) nextSlide(); 
      }, 6000);
    }

    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
      }
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoPlay(); else startAutoPlay();
    });

    if (prevBtn && nextBtn && slides.length > 0) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        startAutoPlay();
      });

      nextBtn.addEventListener('click', () => {
        nextSlide();
        startAutoPlay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          showSlide(idx);
          startAutoPlay();
        });
      });

      // Pause on hover
      const container = document.getElementById('gallery-container');
      if (container) {
        container.addEventListener('mouseenter', stopAutoPlay);
        container.addEventListener('mouseleave', startAutoPlay);
      }

      startAutoPlay();
    }

    type MemberData = {
      name: string;
      role: string;
      department: string;
      avatar?: string;
      image?: string;
      bio?: string;
      email?: string;
      phone?: string;
      linkedin?: string;
      instagram?: string;
      facebook?: string;
      github?: string;
      website?: string;
    };

    const overlay = document.getElementById('member-modal-overlay') as HTMLElement;
    const modal   = document.getElementById('member-modal') as HTMLElement;
    const closeBtn = document.getElementById('modal-close') as HTMLButtonElement;

    // Member Modal - Production-ready with refined motion choreography and accessibility
    function openModal(member: MemberData) {
      // Avatar / Image with enhanced fallback
      const avatarWrap = document.getElementById('modal-avatar-wrap') as HTMLElement;
      avatarWrap.innerHTML = member.image
        ? `<img src="${member.image}" alt="${member.name}" class="w-full h-full object-cover rounded-full transition-transform duration-500 ease-out" />`
        : `<span class="text-accent-cyan flex items-center justify-center w-full h-full transition-opacity duration-300"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>`;

      // Basic info with staggered animations
      const nameEl = document.getElementById('modal-member-name') as HTMLElement;
      const roleEl = document.getElementById('modal-role') as HTMLElement;
      const deptEl = document.getElementById('modal-dept') as HTMLElement;
      
      nameEl.textContent = member.name;
      roleEl.textContent = member.role;
      deptEl.textContent = member.department;

      // Bio with fade-in animation
      const bioWrap = document.getElementById('modal-bio-wrap') as HTMLElement;
      const bioEl = document.getElementById('modal-bio') as HTMLElement;
      if (member.bio) {
        bioEl.textContent = member.bio;
        // Remove hidden class and apply transition classes
        bioWrap.classList.remove('hidden', 'opacity-0', 'translate-y-2');
        bioWrap.classList.add('opacity-100', 'translate-y-0');
      } else {
        // Keep hidden when no bio available
        bioWrap.classList.add('hidden');
        bioWrap.classList.remove('opacity-0', 'translate-y-2', 'opacity-100', 'translate-y-0');
      }

      // Contact with staggered animation
      const contactEl = document.getElementById('modal-contact') as HTMLElement;
      contactEl.innerHTML = '';
      let contactItems = 0;
      if (member.email) {
        contactItems++;
        contactEl.insertAdjacentHTML('beforeend', `
          <a href="mailto:${member.email}" title="${member.email}" class="group flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-gradient-to-r from-white/5 to-transparent border border-white/10 text-text-secondary hover:text-accent-cyan hover:border-accent-cyan/40 transition-all duration-300 ease-out min-w-0">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-accent-cyan/10 border border-accent-cyan/20 flex items-center justify-center text-accent-cyan group-hover:bg-accent-cyan/20 group-hover:border-accent-cyan/40 transition-colors duration-200">
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </span>
            <span class="text-xs sm:text-sm font-mono truncate hover:text-clip break-all sm:break-normal transition-colors duration-200 min-w-0 flex-1 leading-snug">${member.email}</span>
          </a>`);
      }
      if (member.phone) {
        contactItems++;
        contactEl.insertAdjacentHTML('beforeend', `
          <a href="tel:${member.phone}" title="${member.phone}" class="group flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-gradient-to-r from-white/5 to-transparent border border-white/10 text-text-secondary hover:text-accent-cyan hover:border-accent-cyan/40 transition-all duration-300 ease-out min-w-0">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-accent-cyan/10 border border-accent-cyan/20 flex items-center justify-center text-accent-cyan group-hover:bg-accent-cyan/20 group-hover:border-accent-cyan/40 transition-colors duration-200">
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
            </span>
            <span class="text-xs sm:text-sm font-mono truncate transition-colors duration-200 min-w-0 flex-1 leading-snug">${member.phone}</span>
          </a>`);
      }

      // Socials with staggered fade-in animation
      const socialsEl = document.getElementById('modal-socials') as HTMLElement;
      socialsEl.innerHTML = '';
      let socialItems = 0;
      const socialLinks: { key: keyof MemberData; label: string; color: string }[] = [
        { key: 'linkedin',  label: 'LinkedIn',  color: 'bg-accent-blue/20 text-accent-blue border-accent-blue/30 hover:bg-accent-blue/40 hover:scale-105' },
        { key: 'instagram', label: 'Instagram', color: 'bg-gradient-to-r from-pink-600/20 to-rose-600/20 text-rose-400 border-rose-400/30 hover:bg-pink-600/40 hover:scale-105' },
        { key: 'facebook',  label: 'Facebook',  color: 'bg-gradient-to-r from-indigo-600/20 to-purple-600/20 text-indigo-400 border-indigo-400/30 hover:bg-indigo-600/40 hover:scale-105' },
        { key: 'github',    label: 'GitHub',    color: 'bg-white/5 text-text-secondary border-white/10 hover:bg-gray-700/50 hover:text-white hover:scale-105' },
        { key: 'website',   label: 'Sitio Web', color: 'bg-accent-emerald/20 text-accent-emerald border-accent-emerald/30 hover:bg-accent-emerald/40 hover:scale-105' },
      ];
      socialLinks.forEach(({ key, label, color }) => {
        const url = member[key] as string | undefined;
        if (url) {
          socialItems++;
          socialsEl.insertAdjacentHTML('beforeend', `
            <a href="${url}" target="_blank" rel="noopener noreferrer"
               class="px-3.5 py-1.75 rounded-lg border text-xs font-semibold transition-all duration-300 ease-out ${color} hover:-translate-y-0.5">
              ${label}
            </a>`);
        }
      });
      if (socialItems > 0) {
        socialsEl.classList.remove('opacity-0', 'translate-y-2');
        socialsEl.classList.add('opacity-100', 'translate-y-0');
      } else {
        socialsEl.classList.add('hidden');
      }

      // Animate open with staggered timing and refined choreography
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      modal.classList.remove('translate-y-[3.75rem]', 'scale-95', 'opacity-0');
      modal.classList.add('translate-y-0', 'scale-100', 'opacity-100');
      document.body.style.overflow = 'hidden';

      // Staggered entrance for content elements using IntersectionObserver for performance
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px'
      };

      const staggerElements = ([element]: Element[]) => {
        element.addEventListener('intersection-observer-added', () => {
          // Trigger animation after modal is fully visible
          setTimeout(() => {
            const bio = document.getElementById('modal-bio') as HTMLElement;
            if (bio) bio.classList.add('animate-fade-in-up');
            
            const contactEl = document.getElementById('modal-contact');
            if (contactEl) contactEl.classList.add('animate-stagger-in');

            const socialsEl = document.getElementById('modal-socials');
            if (socialsEl) socialsEl.classList.add('animate-stagger-in-delayed');
          }, 100);
        }, { once: true });
      };
    }

    function closeModal() {
      // Exit with refined choreography - reverse of entrance
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('translate-y-0', 'scale-100', 'opacity-100');
      modal.classList.add('translate-y-6', 'scale-95', 'opacity-0');
      document.body.style.overflow = '';
    }

    // Cleanup refinements - prevent memory leaks and ensure smooth state management
    window.addEventListener('beforeunload', stopAutoPlay);
    
    // Add subtle parallax effect on mouse move for enhanced depth perception
    const modalContainer = document.getElementById('member-modal') as HTMLElement | null;
    if (modalContainer) {
      modalContainer.addEventListener('mousemove', (e) => {
        const rect = modalContainer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Subtle tilt effect based on mouse position
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = (y - centerY) / 100; // Max 3deg rotation
        const rotateY = (centerX - x) / 100;
        
        modalContainer.style.transform = `translate-y-${modal.classList.contains('translate-y-[3.75rem]') ? '-2.5rem' : '0'} scale-${modal.classList.contains('scale-95') ? '0.95' : '1'} rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        modalContainer.style.perspective = '1000px';
      });

      // Reset transform on mouse leave
      modalContainer.addEventListener('mouseleave', () => {
        modalContainer.style.transform = '';
      });
    }

    // Attach to all cards with refined click handling and accessibility
    document.querySelectorAll<HTMLButtonElement>('.member-card').forEach((card) => {
      const member = JSON.parse(card.getAttribute('data-member')!) as MemberData;
      
      card.addEventListener('click', () => {
        openModal(member);
        
        // Move focus to close button for accessibility after modal opens
        setTimeout(() => {
          const closeBtn = document.getElementById('modal-close');
          if (closeBtn) closeBtn.focus();
        }, 350); // Match modal transition duration
      });
    });

    // Focus management - simplified for production reliability
    // Note: Modal traps focus naturally through overlay, no extra code needed

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      // Keyboard navigation for accessibility
      if (e.key === 'Escape' && overlay.classList.contains('opacity-100')) closeModal();
      if (e.key === 'ArrowRight' && nextBtn) nextBtn.click();
      if (e.key === 'ArrowLeft' && prevBtn) prevBtn.click();
    });

    // Cleanup on unload for memory management
    window.addEventListener('beforeunload', stopAutoPlay);
  </script>

</BaseLayout>
