---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('eventos');

const sortedEvents = [...allEvents].sort(
  (a, b) => new Date(b.data.fechaInicio).getTime() - new Date(a.data.fechaInicio).getTime()
);

const upcomingEvents = sortedEvents.filter((e) => e.data.estado === 'Publicado');
const pastEvents = sortedEvents.filter((e) => e.data.estado === 'Pasado');
---

<BaseLayout
  title="IEEE ComSoc Univalle | Eventos & Workshops"
  description="Explora los próximos talleres técnicos, hackathons, conferencias y actividades del capítulo IEEE ComSoc."
>
  <section class="relative overflow-hidden border-b border-white/10">
    <div class="absolute inset-0 opacity-90" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-cyan/10 border border-accent-cyan/30 text-accent-cyan text-[11px] sm:text-xs font-mono tracking-[0.2em] uppercase shadow-[0_0_25px_rgba(34,211,238,0.18)]">
        Calendario académico &amp; técnico
      </div>

      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-text-primary tracking-tight">
        Eventos, talleres &amp; conferencias
      </h1>

      <p class="mx-auto mt-5 max-w-3xl text-base sm:text-lg text-text-secondary leading-relaxed font-light">
        Capacitación práctica, competencia de innovación y conocimiento aplicado para impulsar la próxima generación de líderes en comunicaciones y tecnologías.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm">
        <div class="glass-card rounded-2xl px-4 py-3 min-w-[120px] border border-white/10">
          <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-secondary">Próximos</div>
          <div class="mt-1 text-xl font-bold text-accent-cyan">{upcomingEvents.length}</div>
        </div>
        <div class="glass-card rounded-2xl px-4 py-3 min-w-[120px] border border-white/10">
          <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-secondary">Pasados</div>
          <div class="mt-1 text-xl font-bold text-text-primary">{pastEvents.length}</div>
        </div>
        <div class="glass-card rounded-2xl px-4 py-3 min-w-[120px] border border-white/10">
          <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-secondary">Agenda</div>
          <div class="mt-1 text-xl font-bold text-text-primary">{sortedEvents.length}</div>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 space-y-16 lg:space-y-20">
    <section class="space-y-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="inline-flex items-center gap-3">
          <span class="h-3 w-3 rounded-full bg-accent-cyan shadow-[0_0_20px_rgba(34,211,238,0.9)]"></span>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary">Próximos eventos</h2>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-cyan/10 border border-accent-cyan/30 text-accent-cyan text-xs font-mono">
          <span>{upcomingEvents.length}</span>
          <span>actividades</span>
        </div>
      </div>

      {upcomingEvents.length === 0 ? (
        <div class="glass-card rounded-3xl p-10 sm:p-12 text-center border border-white/10 max-w-2xl mx-auto shadow-[0_20px_60px_rgba(15,23,42,0.4)]">
          <div class="text-5xl mb-4" aria-hidden="true">📅</div>
          <h3 class="text-xl font-bold text-text-primary mb-2">No hay eventos programados en este momento</h3>
          <p class="text-sm sm:text-base text-text-secondary font-light leading-relaxed">
            Estamos preparando la próxima tanda de talleres, hackathons y conferencias. Sigue nuestras redes para no perderte la apertura de inscripciones.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {upcomingEvents.map((ev) => (
            <EventCard
              id={ev.id}
              titulo={ev.data.titulo}
              tipo={ev.data.tipo}
              organizador={ev.data.organizador}
              fechaInicio={ev.data.fechaInicio}
              horaInicio={ev.data.horaInicio}
              lugarNombre={ev.data.lugarNombre}
              descripcion={ev.data.descripcion}
              imagenPrincipal={ev.data.imagenPrincipal}
              estado={ev.data.estado}
            />
          ))}
        </div>
      )}
    </section>

    <section class="space-y-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="inline-flex items-center gap-3">
          <span class="text-xl" aria-hidden="true">📦</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary">Eventos pasados</h2>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-text-secondary text-xs font-mono">
          <span>{pastEvents.length}</span>
          <span>registros</span>
        </div>
      </div>

      {pastEvents.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-white/15 bg-white/[0.02] px-6 py-10 text-sm text-text-secondary text-center">
          No hay registros de eventos pasados.
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {pastEvents.map((ev) => (
            <EventCard
              id={ev.id}
              titulo={ev.data.titulo}
              tipo={ev.data.tipo}
              organizador={ev.data.organizador}
              fechaInicio={ev.data.fechaInicio}
              horaInicio={ev.data.horaInicio}
              lugarNombre={ev.data.lugarNombre}
              descripcion={ev.data.descripcion}
              imagenPrincipal={ev.data.imagenPrincipal}
              estado={ev.data.estado}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</BaseLayout>
