---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import EventsSectionGrid from '../../components/EventsSectionGrid.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('eventos');

const sortedEvents = [...allEvents]
  .map((event) => {
    const dateObj = new Date(event.data.fechaInicio);
    if (isNaN(dateObj.getTime())) {
      console.warn(`[Eventos Page] Invalid date for event "${event.id}": ${event.data.fechaInicio}`);
      return { ...event, _sortDate: 0 }; // Sort to bottom
    }
    return { ...event, _sortDate: dateObj.getTime() };
  })
  .sort((a, b) => (b as any)._sortDate - (a as any)._sortDate);

const upcomingEvents = sortedEvents.filter((e) => e.data.estado === 'Publicado');
const pastEvents = sortedEvents.filter((e) => e.data.estado === 'Pasado');
---

<BaseLayout
  title="IEEE ComSoc Univalle | Eventos & Workshops"
  description="Explora los próximos talleres técnicos, hackathons, conferencias y actividades del capítulo IEEE ComSoc."
>
  <HeroHeader
    badgeText="Calendario académico & técnico"
    badgeColor="cyan"
    title="Eventos, talleres & conferencias"
    description="Capacitación práctica, competencia de innovación y conocimiento aplicado para impulsar la próxima generación de líderes en comunicaciones y tecnologías."
  >
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm">
      <div class="glass-card rounded-2xl px-4 py-3 min-w-30 border border-white/10">
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-secondary">Próximos</div>
        <div class="mt-1 text-xl font-bold text-accent-cyan">{upcomingEvents.length}</div>
      </div>
      <div class="glass-card rounded-2xl px-4 py-3 min-w-30 border border-white/10">
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-secondary">Pasados</div>
        <div class="mt-1 text-xl font-bold text-text-primary">{pastEvents.length}</div>
      </div>
      <div class="glass-card rounded-2xl px-4 py-3 min-w-30 border border-white/10">
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-secondary">Agenda</div>
        <div class="mt-1 text-xl font-bold text-text-primary">{sortedEvents.length}</div>
      </div>
    </div>
  </HeroHeader>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 space-y-16 lg:space-y-20">
    <EventsSectionGrid
      title="Próximos eventos"
      events={upcomingEvents}
      emptyMessage="Estamos preparando la próxima tanda de talleres, hackathons y conferencias. Sigue nuestras redes para no perderte la apertura de inscripciones."
      isUpcoming={true}
    />

    <EventsSectionGrid
      title="Eventos pasados"
      events={pastEvents}
      emptyMessage="No hay registros de eventos pasados."
      isUpcoming={false}
    />
  </main>
</BaseLayout>
