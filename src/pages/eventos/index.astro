---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('eventos');

// Sort by date (descending)
const sortedEvents = allEvents.sort(
  (a, b) => new Date(b.data.fechaInicio).getTime() - new Date(a.data.fechaInicio).getTime()
);

const upcomingEvents = sortedEvents.filter((e) => e.data.estado === 'Publicado');
const pastEvents = sortedEvents.filter((e) => e.data.estado === 'Pasado');
---

<BaseLayout
  title="IEEE ComSoc | Eventos & Workshops"
  description="Explora los próximos talleres técnicos, hackathons, conferencias y actividades del capítulo IEEE ComSoc."
>
  <!-- Page Header -->
  <section class="relative py-16 bg-grid-pattern bg-wave-pattern border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono mb-4">
        Calendario Académico &amp; Técnico
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4">
        Eventos, Talleres &amp; Conferencias
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg font-light leading-relaxed">
        Capacitaciones prácticas, competencias de innovación y ponencias magistrales dictadas por expertos globales de IEEE ComSoc.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
    
    <!-- Upcoming Events Section -->
    <section>
      <div class="flex items-center justify-between mb-8 border-b border-white/10 pb-4">
        <h2 class="text-2xl font-bold text-white flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></span>
          <span>Próximos Eventos</span>
          <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
            {upcomingEvents.length}
          </span>
        </h2>
      </div>

      {upcomingEvents.length === 0 ? (
        <div class="glass-card rounded-2xl p-12 text-center border border-white/10 max-w-xl mx-auto">
          <div class="text-4xl mb-4">📅</div>
          <h3 class="text-lg font-bold text-white mb-2">No hay eventos programados en este momento</h3>
          <p class="text-sm text-gray-400 font-light">
            Estamos planificando los próximos talleres. Mantente atento a nuestras redes sociales.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {upcomingEvents.map((ev) => (
            <EventCard
              id={ev.id}
              titulo={ev.data.titulo}
              tipo={ev.data.tipo}
              organizador={ev.data.organizador}
              fechaInicio={ev.data.fechaInicio}
              horaInicio={ev.data.horaInicio}
              lugarNombre={ev.data.lugarNombre}
              descripcion={ev.data.descripcion}
              imagenPrincipal={ev.data.imagenPrincipal}
              estado={ev.data.estado}
            />
          ))}
        </div>
      )}
    </section>

    <!-- Past Events Section -->
    <section>
      <div class="flex items-center justify-between mb-8 border-b border-white/10 pb-4">
        <h2 class="text-2xl font-bold text-gray-300 flex items-center gap-3">
          <span class="text-gray-500 font-mono">📦</span>
          <span>Eventos Pasados</span>
          <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-white/10 text-gray-400 border border-white/10">
            {pastEvents.length}
          </span>
        </h2>
      </div>

      {pastEvents.length === 0 ? (
        <p class="text-sm text-gray-500">No hay registros de eventos pasados.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {pastEvents.map((ev) => (
            <EventCard
              id={ev.id}
              titulo={ev.data.titulo}
              tipo={ev.data.tipo}
              organizador={ev.data.organizador}
              fechaInicio={ev.data.fechaInicio}
              horaInicio={ev.data.horaInicio}
              lugarNombre={ev.data.lugarNombre}
              descripcion={ev.data.descripcion}
              imagenPrincipal={ev.data.imagenPrincipal}
              estado={ev.data.estado}
            />
          ))}
        </div>
      )}
    </section>

  </div>
</BaseLayout>
