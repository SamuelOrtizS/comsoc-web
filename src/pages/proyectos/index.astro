---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { resolveImage } from '../../utils/imageResolver';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatUSD, formatCOP, getUsdToCopRate } from '../../utils/currency';

const allProyectos = await getCollection('proyectos');
const currentRate = await getUsdToCopRate();

// Sort: active first, then completed, then paused
const statusOrder: Record<string, number> = { Activo: 0, Completado: 1, 'En Pausa': 2 };
const sorted = [...allProyectos].sort(
  (a, b) => (statusOrder[a.data.estado] ?? 9) - (statusOrder[b.data.estado] ?? 9)
);

const activos    = sorted.filter((p) => p.data.estado === 'Activo');
const completados = sorted.filter((p) => p.data.estado === 'Completado');
const enPausa    = sorted.filter((p) => p.data.estado === 'En Pausa');

const estadoStyle = {
  Activo:      { dot: 'bg-accent-emerald animate-ping', badge: 'text-accent-emerald border-accent-emerald/30 bg-accent-emerald/10', icon: 'material-symbols:check-circle-rounded' },
  Completado:  { dot: 'bg-accent-blue',                  badge: 'text-accent-blue border-accent-blue/30 bg-accent-blue/10',         icon: 'material-symbols:verified-rounded' },
  'En Pausa':  { dot: 'bg-accent-yellow',                badge: 'text-accent-yellow border-accent-yellow/30 bg-accent-yellow/10',   icon: 'material-symbols:pause-circle-rounded' },
};

const fundingPercent = (actual?: number, meta?: number) => {
  if (typeof actual !== 'number' || typeof meta !== 'number' || meta <= 0) return 0;
  return Math.min(100, (actual / meta) * 100);
};
---

<BaseLayout
  title="IEEE ComSoc Univalle | Proyectos de Investigación & Desarrollo"
  description="Explora los proyectos técnicos, de investigación e innovación del Capítulo Estudiantil IEEE ComSoc."
>
  <section class="relative overflow-hidden border-b border-white/10 py-16 sm:py-20">
    <div class="absolute inset-0 opacity-40"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-cyan-lighter/60 to-transparent"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-purple/20 bg-accent-purple/10 px-3 py-1 text-[11px] font-mono tracking-[0.16em] text-accent-purple uppercase">
        Investigación &amp; Desarrollo
      </div>

      <h1 class="mb-4 text-4xl font-black tracking-[-0.05em] text-text-primary sm:text-5xl lg:text-6xl">
        Proyectos del Capítulo IEEE ComSoc
      </h1>

      <p class="mx-auto max-w-3xl text-base leading-relaxed text-text-secondary sm:text-lg">
        Iniciativas técnicas y de investigación desarrolladas por nuestros miembros en telecomunicaciones, IoT, IA aplicada y comunicaciones ópticas.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <div class="flex items-center gap-2 rounded-full border border-accent-emerald/20 bg-accent-emerald/10 px-3 py-2 font-mono text-sm text-text-primary shadow-[0_0_0_1px_rgba(52,211,153,0.08)]">
          <span class="h-2.5 w-2.5 rounded-full bg-accent-emerald shadow-[0_0_12px_rgba(34,211,238,0.6)]"></span>
          <span class="text-accent-emerald">{activos.length}</span>
          <span class="text-text-secondary">Activos</span>
        </div>
        <div class="flex items-center gap-2 rounded-full border border-accent-blue/20 bg-accent-blue/10 px-3 py-2 font-mono text-sm text-text-primary">
          <span class="h-2.5 w-2.5 rounded-full bg-accent-blue shadow-[0_0_12px_rgba(34,211,238,0.6)]"></span>
          <span class="text-accent-blue">{completados.length}</span>
          <span class="text-text-secondary">Completados</span>
        </div>
        <div class="flex items-center gap-2 rounded-full border border-accent-yellow/20 bg-accent-yellow/10 px-3 py-2 font-mono text-sm text-text-primary">
          <span class="h-2.5 w-2.5 rounded-full bg-accent-yellow shadow-[0_0_12px_rgba(250,204,21,0.6)]"></span>
          <span class="text-accent-yellow">{enPausa.length}</span>
          <span class="text-text-secondary">En pausa</span>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl space-y-20 px-4 py-16 sm:px-6 lg:px-8">
    {activos.length > 0 && (
      <section>
        <div class="mb-8 flex items-center gap-3 border-b border-white/10 pb-4">
          <span class="relative flex h-3.5 w-3.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-emerald opacity-75"></span>
            <span class="relative inline-flex h-3.5 w-3.5 rounded-full bg-accent-emerald"></span>
          </span>
          <h2 class="text-2xl font-bold text-text-primary">Proyectos Activos</h2>
          <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-[0.14em] text-emerald-300">
            {activos.length}
          </span>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
          {activos.map((proyecto) => (
            <a
              href={`/proyectos/${proyecto.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-bg-secondary/80 shadow-[0_18px_45px_rgba(15,23,42,0.38)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-accent-emerald/40 hover:shadow-[0_24px_60px_rgba(52,211,153,0.12)]"
            >
              <div class="relative aspect-video overflow-hidden bg-bg-secondary">
                <Image
                  src={resolveImage(proyecto.data.imagen) as any}
                  alt={proyecto.data.titulo}
                  width={800}
                  height={450}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/25 to-transparent"></div>
                <div class="absolute left-3 top-3 flex flex-wrap gap-2">
                  <span class="rounded-full border border-accent-purple/30 bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] text-accent-purple backdrop-blur-md">
                    {proyecto.data.categoria}
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] text-emerald-300 backdrop-blur-md">
                    <Icon name="material-symbols:check-circle-rounded" class="w-3.5 h-3.5" aria-hidden="true" /> Activo
                  </span>
                </div>
              </div>

              <div class="flex grow flex-col p-6">
                <h3 class="mb-2 line-clamp-2 text-lg font-bold text-text-primary transition-colors duration-300 group-hover:text-accent-emerald">
                  {proyecto.data.titulo}
                </h3>
                <p class="mb-4 grow text-sm leading-relaxed text-text-secondary">
                  {proyecto.data.descripcion}
                </p>

                {proyecto.data.montoActual !== undefined && proyecto.data.montoMeta !== undefined && (
                  <div class="mb-4 space-y-2 rounded-2xl border border-white/10 bg-white/5 p-3.5">
                    <div class="flex items-baseline justify-between gap-2 text-[11px] font-mono">
                      <span class="text-text-secondary">Financiación (USD)</span>
                      <span class="font-semibold text-accent-cyan">{formatUSD(proyecto.data.montoActual)} / {formatUSD(proyecto.data.montoMeta)}</span>
                    </div>

                    <div class="flex items-baseline justify-between gap-2 text-[10px] font-mono text-text-secondary">
                      <span>En COP</span>
                      <span class="font-semibold text-accent-emerald">{formatCOP(proyecto.data.montoActual, currentRate)} / {formatCOP(proyecto.data.montoMeta, currentRate)}</span>
                    </div>

                    <div class="relative mt-1 h-2.5 overflow-hidden rounded-full border border-white/10 bg-white/5">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-accent-blue-lighter via-accent-cyan to-accent-emerald-darker transition-all duration-500"
                        style={`width: ${fundingPercent(proyecto.data.montoActual, proyecto.data.montoMeta)}%`}
                        aria-label="Progreso de financiamiento"
                      ></div>
                    </div>

                    <div class="text-right text-[10px] font-mono text-text-secondary">
                      {Math.round(fundingPercent(proyecto.data.montoActual, proyecto.data.montoMeta))}% Completado
                    </div>
                  </div>
                )}

                {proyecto.data.tags && proyecto.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {proyecto.data.tags.map((tag) => (
                      <span class="rounded border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] font-mono text-text-secondary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {completados.length > 0 && (
      <section>
        <div class="mb-8 flex items-center gap-3 border-b border-white/10 pb-4">
          <Icon name="material-symbols:verified-rounded" class="w-6 h-6 text-accent-blue" aria-hidden="true" />
          <h2 class="text-2xl font-bold text-text-primary">Proyectos Completados</h2>
          <span class="rounded-full border border-blue-400/30 bg-blue-400/10 px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-[0.14em] text-blue-300">
            {completados.length}
          </span>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
          {completados.map((proyecto) => (
            <a
              href={`/proyectos/${proyecto.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-bg-secondary/80 shadow-[0_18px_45px_rgba(15,23,42,0.38)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-accent-blue/40 hover:shadow-[0_24px_60px_rgba(21,93,252,0.12)]"
            >
              <div class="relative aspect-video overflow-hidden bg-bg-secondary">
                <Image
                  src={resolveImage(proyecto.data.imagen) as any}
                  alt={proyecto.data.titulo}
                  width={800}
                  height={450}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover opacity-80 transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/25 to-transparent"></div>
                <div class="absolute left-3 top-3 flex flex-wrap gap-2">
                  <span class="rounded-full border border-accent-purple/30 bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] text-accent-purple backdrop-blur-md">
                    {proyecto.data.categoria}
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-accent-blue/30 bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] text-accent-blue backdrop-blur-md">
                    <Icon name="material-symbols:verified-rounded" class="w-3.5 h-3.5" aria-hidden="true" /> Completado
                  </span>
                </div>
              </div>

              <div class="flex grow flex-col p-6">
                <h3 class="mb-2 line-clamp-2 text-lg font-bold text-text-primary transition-colors duration-300 group-hover:text-accent-blue">
                  {proyecto.data.titulo}
                </h3>
                <p class="mb-4 grow text-sm leading-relaxed text-text-secondary">
                  {proyecto.data.descripcion}
                </p>

                {proyecto.data.montoActual !== undefined && proyecto.data.montoMeta !== undefined && (
                  <div class="mb-4 space-y-2 rounded-2xl border border-white/10 bg-white/5 p-3.5">
                    <div class="flex items-baseline justify-between gap-2 text-[11px] font-mono">
                      <span class="text-text-secondary">Financiación (USD)</span>
                      <span class="font-semibold text-accent-cyan">{formatUSD(proyecto.data.montoActual)} / {formatUSD(proyecto.data.montoMeta)}</span>
                    </div>

                    <div class="flex items-baseline justify-between gap-2 text-[10px] font-mono text-text-secondary">
                      <span>En COP</span>
                      <span class="font-semibold text-accent-emerald">{formatCOP(proyecto.data.montoActual, currentRate)} / {formatCOP(proyecto.data.montoMeta, currentRate)}</span>
                    </div>

                    <div class="relative mt-1 h-2.5 overflow-hidden rounded-full border border-white/10 bg-white/5">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-accent-blue-lighter via-accent-cyan to-accent-emerald-darker transition-all duration-500"
                        style={`width: ${fundingPercent(proyecto.data.montoActual, proyecto.data.montoMeta)}%`}
                        aria-label="Progreso de financiamiento"
                      ></div>
                    </div>

                    <div class="text-right text-[10px] font-mono text-text-secondary">
                      {Math.round(fundingPercent(proyecto.data.montoActual, proyecto.data.montoMeta))}% Completado
                    </div>
                  </div>
                )}

                {proyecto.data.tags && proyecto.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {proyecto.data.tags.map((tag) => (
                      <span class="rounded border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] font-mono text-text-secondary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {enPausa.length > 0 && (
      <section>
        <div class="mb-8 flex items-center gap-3 border-b border-white/10 pb-4">
          <Icon name="material-symbols:pause-circle-rounded" class="w-6 h-6 text-accent-yellow" aria-hidden="true" />
          <h2 class="text-2xl font-bold text-text-secondary">Proyectos en Pausa</h2>
          <span class="rounded-full border border-yellow-300/30 bg-yellow-300/10 px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-[0.14em] text-yellow-300">
            {enPausa.length}
          </span>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
          {enPausa.map((proyecto) => (
            <a
              href={`/proyectos/${proyecto.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-bg-secondary/80 opacity-80 shadow-[0_18px_45px_rgba(15,23,42,0.38)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-accent-yellow/35 hover:opacity-100 hover:shadow-[0_24px_60px_rgba(250,204,21,0.08)]"
            >
              <div class="relative aspect-video overflow-hidden bg-bg-secondary">
                <Image
                  src={resolveImage(proyecto.data.imagen) as any}
                  alt={proyecto.data.titulo}
                  width={800}
                  height={450}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/25 to-transparent"></div>
                <div class="absolute left-3 top-3 flex flex-wrap gap-2">
                  <span class="rounded-full border border-accent-purple/30 bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] text-accent-purple backdrop-blur-md">
                    {proyecto.data.categoria}
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-yellow-300/30 bg-black/70 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.12em] text-accent-yellow backdrop-blur-md">
                    <Icon name="material-symbols:pause-circle-rounded" class="w-3.5 h-3.5" aria-hidden="true" /> En Pausa
                  </span>
                </div>
              </div>

              <div class="flex grow flex-col p-6">
                <h3 class="mb-2 line-clamp-2 text-lg font-bold text-text-secondary transition-colors duration-300 group-hover:text-text-primary">
                  {proyecto.data.titulo}
                </h3>
                <p class="mb-4 grow text-sm leading-relaxed text-text-secondary">
                  {proyecto.data.descripcion}
                </p>

                {proyecto.data.montoActual !== undefined && proyecto.data.montoMeta !== undefined && (
                  <div class="mb-4 space-y-2 rounded-2xl border border-white/10 bg-white/5 p-3.5">
                    <div class="flex items-baseline justify-between gap-2 text-[11px] font-mono">
                      <span class="text-text-secondary">Financiación (USD)</span>
                      <span class="font-semibold text-accent-cyan">{formatUSD(proyecto.data.montoActual)} / {formatUSD(proyecto.data.montoMeta)}</span>
                    </div>

                    <div class="flex items-baseline justify-between gap-2 text-[10px] font-mono text-text-secondary">
                      <span>En COP</span>
                      <span class="font-semibold text-accent-emerald">{formatCOP(proyecto.data.montoActual, currentRate)} / {formatCOP(proyecto.data.montoMeta, currentRate)}</span>
                    </div>

                    <div class="relative mt-1 h-2.5 overflow-hidden rounded-full border border-white/10 bg-white/5">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-accent-blue-lighter via-accent-cyan to-accent-emerald-darker transition-all duration-500"
                        style={`width: ${fundingPercent(proyecto.data.montoActual, proyecto.data.montoMeta)}%`}
                        aria-label="Progreso de financiamiento"
                      ></div>
                    </div>

                    <div class="text-right text-[10px] font-mono text-text-secondary">
                      {Math.round(fundingPercent(proyecto.data.montoActual, proyecto.data.montoMeta))}% Completado
                    </div>
                  </div>
                )}

                {proyecto.data.tags && proyecto.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {proyecto.data.tags.map((tag) => (
                      <span class="rounded border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] font-mono text-text-secondary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {allProyectos.length === 0 && (
      <div class="mx-auto max-w-xl rounded-2xl border border-white/10 bg-bg-secondary/80 p-16 text-center shadow-[0_18px_45px_rgba(15,23,42,0.2)] backdrop-blur-md">
        <div class="mb-4 flex justify-center text-accent-purple"><Icon name="material-symbols:science" class="w-12 h-12" aria-hidden="true" /></div>
        <h3 class="mb-2 text-lg font-bold text-text-primary">No hay proyectos registrados aún</h3>
        <p class="text-sm font-light text-text-secondary">Pronto publicaremos las iniciativas en curso del capítulo.</p>
      </div>
    )}

    <div class="mx-auto mt-12 max-w-4xl overflow-hidden rounded-3xl border border-accent-purple/30 bg-gradient-to-b from-bg-primary to-bg-secondary p-8 text-center shadow-[0_18px_45px_rgba(15,23,42,0.38)] sm:p-12">
      <div class="relative z-10 space-y-4">
        <div class="flex justify-center text-accent-rose"><Icon name="material-symbols:favorite-rounded" class="w-10 h-10" aria-hidden="true" /></div>
        <h2 class="text-2xl font-bold text-text-primary sm:text-3xl">¿Quieres apoyar nuestras iniciativas?</h2>
        <p class="mx-auto max-w-2xl text-sm leading-relaxed text-text-secondary">
          Tanto si deseas financiar un proyecto tecnológico específico como si prefieres contribuir al crecimiento y operación general del capítulo, tu donación hace la diferencia.
        </p>
        <div class="pt-4">
          <a
            href="/donaciones"
            class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-accent-blue-lighter to-accent-cyan-lighter px-6 py-3 text-sm font-semibold text-text-primary shadow-[0_10px_30px_rgba(34,211,238,0.15)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_14px_38px_rgba(21,93,252,0.2)]"
          >
            Donar al Capítulo ↗
          </a>
        </div>
      </div>
      <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-accent-purple/10 blur-[100px]"></div>
      <div class="absolute -right-40 -top-40 h-80 w-80 rounded-full bg-accent-cyan/10 blur-[100px]"></div>
    </div>
  </div>
</BaseLayout>
