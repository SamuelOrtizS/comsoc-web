---
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';
---

<BaseLayout
  title="IEEE ComSoc Univalle | Error del Sistema"
  description="Ha ocurrido un error inesperado. Por favor intenta nuevamente o regresa al inicio."
>
  <ErrorPage
    code="SYSTEM::UNEXPECTED_ERROR"
    tagline="Service encountered an exception"
    title="Error del Sistema"
    description="Se ha producido un fallo inesperado en nuestra infraestructura. El equipo técnico ha sido notificado. Por favor, intenta nuevamente en unos momentos."
    color="red"
    icon="material-symbols:error-rounded"
  />

</BaseLayout>
