---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="IEEE ComSoc Univalle | Error del Sistema"
  description="Ha ocurrido un error inesperado. Por favor intenta nuevamente o regresa al inicio."
>
  <section class="min-h-[calc(100vh-10rem)] flex items-center justify-center px-4 sm:px-6 lg:px-8 relative overflow-hidden">

    <!-- Decorative scan-line overlay -->
    <div class="absolute inset-0 pointer-events-none select-none scanlines" aria-hidden="true"></div>

    <!-- Ambient warning glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-125 h-75 bg-amber-500/8 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 text-center max-w-xl mx-auto flex flex-col items-center gap-8">

      <!-- Warning icon -->
      <div class="relative">
        <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-linear-to-br from-amber-500/20 to-red-500/20 border border-amber-500/30 flex items-center justify-center error-icon-pulse">
          <svg class="w-14 h-14 sm:w-16 sm:h-16 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <!-- Status dot -->
        <div class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-amber-500/80 border-2 border-bg-primary animate-pulse"></div>
      </div>

      <!-- Message -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          SYSTEM::UNEXPECTED_ERROR
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
          Error del Sistema
        </h1>
        <p class="text-gray-400 text-sm sm:text-base font-light leading-relaxed max-w-md mx-auto">
          Se ha producido un fallo inesperado en nuestra infraestructura. El equipo técnico ha sido notificado. Por favor, intenta nuevamente en unos momentos.
        </p>
      </div>

      <!-- Diagnostic panel -->
      <div class="glass-card rounded-2xl px-6 py-5 border border-amber-500/20 w-full max-w-sm">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 opacity-30"></span>
          <span class="text-[10px] font-mono text-gray-500 ml-auto">diagnostics.log</span>
        </div>
        <code class="text-xs font-mono text-gray-400 block text-left space-y-1">
          <span class="text-amber-400">[WARN]</span> Service encountered an exception<br/>
          <span class="text-gray-500">├─</span> status: <span class="text-red-400">FAILURE</span><br/>
          <span class="text-gray-500">├─</span> timestamp: <span class="text-cyan-400" id="error-timestamp"></span><br/>
          <span class="text-gray-500">└─</span> action: <span class="text-emerald-400">retry or navigate home</span>
        </code>
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <button
          onclick="window.location.reload()"
          class="px-7 py-3 rounded-xl font-semibold text-white bg-linear-to-r from-amber-500 to-orange-500 shadow-lg shadow-amber-500/25 hover:scale-[1.02] transition-all duration-200 cursor-pointer"
        >
          Reintentar
        </button>
        <a
          href="/"
          class="px-7 py-3 rounded-xl font-semibold text-gray-300 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all duration-200"
        >
          Volver al Inicio
        </a>
      </div>

      <!-- Quick links -->
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs font-mono text-gray-500 pt-2">
        <a href="/eventos" class="hover:text-cyan-400 transition">Eventos</a>
        <a href="/proyectos" class="hover:text-cyan-400 transition">Proyectos</a>
        <a href="/nosotros" class="hover:text-cyan-400 transition">Nosotros</a>
        <a href="/convocatorias" class="hover:text-cyan-400 transition">Convocatorias</a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* Subtle CRT scan-line effect */
  .scanlines {
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.03) 2px,
      rgba(0, 0, 0, 0.03) 4px
    );
  }

  .error-icon-pulse {
    animation: icon-glow 3s ease-in-out infinite;
  }

  @keyframes icon-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    50% { box-shadow: 0 0 40px 8px rgba(245, 158, 11, 0.15); }
  }
</style>

<script>
  const tsEl = document.getElementById('error-timestamp');
  if (tsEl) {
    tsEl.textContent = new Date().toISOString().replace('T', ' ').slice(0, 19);
  }
</script>
